# Normalize line endings: LF in the repository.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.ico binary
*.png binary
*.jpg binary
*.efi binary
*.fd binary
*.ko binary
*.ttf binary

# Mesa patches applied byte-exact to the CRLF files of the Mesa working copy (tools/mesa-build).
tools/mesa-build/patches/*.patch -text
