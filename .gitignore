# Local release denylist: never commit.
.release-denylist.txt

# Build output and toolchains
Build/
out/
edk2/
edk2-platforms/
*.efi
*.fd
*.img
*.sys
*.dll
*.exe
*.pdb
*.obj
*.lib
*.cat
*.cer
*.pfx
x64/
ARM64/

# Installer state, backups and media (device-specific, may contain EFS/IMEI)
installer-work/
backups/
*.wim
*.esd
*.iso
*.vhdx

# boot shim build artefacts (regenerated by pack-uefi.ps1 / pack-uefi-beyond0lte.ps1)
firmware/tools/bootshim/bootshim.o
firmware/tools/bootshim/bootshim.elf
firmware/tools/bootshim/bootshim.bin
firmware/tools/beyond0lte-bootshim/bootshim.o
firmware/tools/beyond0lte-bootshim/bootshim.elf
firmware/tools/beyond0lte-bootshim/bootshim.bin

# Python
__pycache__/
.pytest_cache/
*.pyc

# WinRE-look recovery: preview contact sheet is a regenerable dev artifact
tools/twrp-winre/assets/preview.png
tools/twrp-winre/work/

# .NET
bin/
obj/
.vs/
*.user
TestResults/

# Private scrub patches (contain the removed text); see tools/release/import_sources.py
/.release-patches/
dumps/
