<?xml version="1.0" encoding="utf-8"?>
<!-- Exynos9820Audio: ACX 1.1 render driver (KMDF), ARM64 only. Shape = drivers/S10eBattery/S10eBattery.vcxproj (builds on
     this box with VS18 MSBuild + WDK 26100, see build-package.ps1); ACX include/lib wiring = Windows-driver-samples
     audio/Acx/Samples/AudioCodec/Driver/AudioCodec.vcxproj: ACX 1.1 (A6: 1.0 is the pre-release DDI version, MS doc "ACX version
     information"; build-package.ps1 -AcxMinor 0 builds the old binding) and KMDF 1.31 (the sample's value; 22621 has 1.33).
     notes/d8-audio-win-m1.md, notes/d8-audio-win-a5.md. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{3F9A7C21-8E4D-4B6A-A5D2-9820A0D1C35E}</ProjectGuid>
    <ProjectName>Exynos9820Audio</ProjectName>
    <TargetName>Exynos9820Audio</TargetName>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22621.0</WindowsTargetPlatformMinVersion>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>31</KMDF_VERSION_MINOR>
    <ACX_VERSION_MAJOR>1</ACX_VERSION_MAJOR>
    <ACX_VERSION_MINOR>1</ACX_VERSION_MINOR>
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WppEnabled>false</WppEnabled>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <AdditionalIncludeDirectories>$(DDK_INC_PATH)\acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>ACX_VERSION_MAJOR=$(ACX_VERSION_MAJOR);ACX_VERSION_MINOR=$(ACX_VERSION_MINOR);KMDF_VERSION_MAJOR=$(KMDF_VERSION_MAJOR);KMDF_VERSION_MINOR=$(KMDF_VERSION_MINOR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>%(AdditionalOptions) /Brepro</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\ntstrsafe.lib;$(DDK_LIB_PATH)\acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR)\acxstub.lib;$(DDK_LIB_PATH)\ksguid.lib</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Driver.c" />
    <ClCompile Include="Render.c" />
    <ClCompile Include="AboxHw.c" />
    <ClCompile Include="AmpI2c.c" />
    <ClCompile Include="RunLog.c" />
    <ClCompile Include="ReqLog.c" />
    <ClCompile Include="Control.c" />
    <ClCompile Include="Codec.c" />
    <ClInclude Include="Exynos9820Audio.h" />
    <ClInclude Include="AmpOtpMap.h" />
    <ResourceCompile Include="resource.rc" />
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Target Name="ValidateOfflineBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SignMode)' != 'Off'" Text="Use build-package.ps1 (test signing by hand)." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
