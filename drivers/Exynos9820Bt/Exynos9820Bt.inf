;  Exynos9820Bt.inf - installs the S10e BCM4375 Bluetooth-over-UART transport (D4c, notes/bt-driver.md).
;  Binds the DSDT Device (BTH0), _HID SAMS9829 (SAMS9826 is BAT0 on main). Class=System like the WDK serialhcibus
;  sample this driver is based on (Microsoft, MS-PL): it is a BthxDDI HCI transport; it enumerates one child
;  (SerialBusWdk\UART_H4, compatible ID MS_BTHX_BTHMINI) that the in-box Bluetooth stack binds.
;  Device-specific sections derived from the sample's SerialBusWdk.inx (Copyright (c) 2010 Microsoft Corporation).

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=10/15/2026,1.0.0.16
CatalogFile=Exynos9820Bt.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[SourceDisksNames]
1=%DiskId1%,,,""

[SourceDisksFiles]
Exynos9820Bt.sys=1,,
bcm4375B1_semco.hcd=1,,   ; copied into the package from the phone's /vendor/firmware at build time, never committed

[ControlFlags]
ExcludeFromSelect=*

[Manufacturer]
%ManufacturerName%=Standard,NTARM64

[Standard.NTARM64]
%DeviceDesc%=Bt_Install, ACPI\SAMS9829

[Bt_Install.NT]
CopyFiles=Bt_CopyFiles

[Bt_CopyFiles]
Exynos9820Bt.sys
bcm4375B1_semco.hcd   ; BtUart.c patchram reads %12%\bcm4375B1_semco.hcd (System32\drivers)

[Bt_Install.NT.HW]
AddReg=Bt_HwAddReg

[Bt_HwAddReg]
HKR,,DeviceCharacteristics,0x10001,0x0100
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;LS)"

[Bt_Install.NT.Services]
AddService=Exynos9820Bt,%SPSVCINST_ASSOCSERVICE%,Bt_Service_Inst

[Bt_Service_Inst]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\Exynos9820Bt.sys

[Strings]
SPSVCINST_ASSOCSERVICE=0x00000002
ProviderName="Galaxy S10e Windows Project"
ManufacturerName="Samsung Electronics (port)"
DiskId1="Exynos9820Bt installation disk"
DeviceDesc="Samsung Exynos9820 BCM4375 Bluetooth Transport"
ServiceDesc="Exynos9820 BCM4375 Bluetooth UART Transport"
