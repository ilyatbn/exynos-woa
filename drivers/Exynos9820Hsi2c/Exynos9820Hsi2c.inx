[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
Exynos9820Hsi2c.sys=1

[Manufacturer]
%ManufacturerName%=Models,NT$ARCH$.10.0...16299

[Models.NT$ARCH$.10.0...16299]
