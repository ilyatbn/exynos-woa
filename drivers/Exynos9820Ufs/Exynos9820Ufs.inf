[Version]
Signature="$WINDOWS NT$"
Class=SCSIAdapter
ClassGuid={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=07/28/2026,9.0.0.0
CatalogFile=Exynos9820Ufs.cat
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Models,NTARM64.10.0...19041

[Models.NTARM64.10.0...19041]
%DeviceDesc%=Exynos9820Ufs_Install,ACPI\EXYN9820

[ControlFlags]
ExcludeFromSelect=*

[Exynos9820Ufs_Install.NT]
CopyFiles=DriverCopy

[Exynos9820Ufs_Install.NT.Services]
AddService=Exynos9820Ufs,%SPSVCINST_ASSOCSERVICE%,Exynos9820Ufs_Service,Miniport_EventLog

[Exynos9820Ufs_Service]
DisplayName=%ServiceDesc%
ServiceType=%SERVICE_KERNEL_DRIVER%
StartType=%SERVICE_BOOT_START%
ErrorControl=%SERVICE_ERROR_NORMAL%
ServiceBinary=%13%\Exynos9820Ufs.sys
LoadOrderGroup=SCSI Miniport
AddReg=BusTypeScsi

[DriverCopy]
Exynos9820Ufs.sys

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
Exynos9820Ufs.sys=1

[DestinationDirs]
DefaultDestDir=13
DriverCopy=13

[BusTypeScsi]
HKR,"Parameters","BusType",%REG_DWORD%,1

[Miniport_EventLog]
AddReg=Miniport_EventLog_AddReg

[Miniport_EventLog_AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[Strings]
ProviderName="Galaxy S10e Windows Project"
ManufacturerName="Samsung Electronics"
DeviceDesc="Samsung Exynos9820 UFS Host Controller (Read-Only)"
ServiceDesc="Samsung Exynos9820 UFS Read-Only Storport Miniport"
DiskDesc="Samsung Exynos9820 UFS Driver Installation Disk"
SPSVCINST_ASSOCSERVICE=0x00000002
SERVICE_KERNEL_DRIVER=1
SERVICE_BOOT_START=0
SERVICE_ERROR_NORMAL=1
REG_EXPAND_SZ=0x00020000
REG_DWORD=0x00010001
