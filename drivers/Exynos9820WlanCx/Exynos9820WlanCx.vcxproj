<?xml version="1.0" encoding="utf-8"?>
<!-- Exynos9820WlanCx (M12 M9, notes/m12-wifi-wificx.md): WiFiCx 1.0 + NetAdapterCx 2.2 + KMDF 1.33 client for the S10e
     BCM4375, ARM64 only. Shape of drivers/Exynos9820Wlan/Exynos9820Wlan.vcxproj; the CX properties follow the WDK
     WindowsDriver.KernelMode.CX.Default.props and the WiFiCx sample (WIFI 1.0, NETADAPTER 2.2 = the version the WiFiCx
     doc requires for Windows 11 21H2/22H2). The bring-up C code is compiled from ..\Exynos9820Wlan. -->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7C1E2A93-4B5D-4E8F-9A20-4375C0F19825}</ProjectGuid>
    <RootNamespace>Exynos9820WlanCx</RootNamespace>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">True</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">False</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <KMDF_MINIMUM_VERSION_REQUIRED>33</KMDF_MINIMUM_VERSION_REQUIRED>
    <NetAdapterDriver>true</NetAdapterDriver>
    <NETADAPTER_VERSION_MAJOR>2</NETADAPTER_VERSION_MAJOR>
    <NETADAPTER_VERSION_MINOR>2</NETADAPTER_VERSION_MINOR>
    <WifiDriver>true</WifiDriver>
    <WIFI_VERSION_MAJOR>1</WIFI_VERSION_MAJOR>
    <WIFI_VERSION_MINOR>0</WIFI_VERSION_MINOR>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(IntDir)</OutDir>
    <TargetName>Exynos9820WlanCx</TargetName>
    <!-- stampinf stamps the LOCAL date; Inf2Cat must compare with local time too (see Exynos9820Wlan.vcxproj) -->
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalIncludeDirectories>..\Exynos9820Wlan;$(DDK_INC_PATH)wlan\2.0;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ForcedIncludeFiles>$(MSBuildThisFileDirectory)CxNames.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <PreprocessorDefinitions>_HAS_EXCEPTIONS=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)wlan\2.0\WificxTLVGenParse.lib;$(DDK_LIB_PATH)\ntstrsafe.lib;$(DDK_LIB_PATH)\ksecdd.lib</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="CxDevice.cpp" />
    <ClCompile Include="CxWifi.cpp" />
    <ClCompile Include="CxAdapter.cpp" />
    <ClCompile Include="CxMem.cpp" />
    <ClCompile Include="CxScan.cpp" />
    <ClCompile Include="CxData.cpp" />
    <ClCompile Include="CxConnect.cpp" />
    <ClCompile Include="..\Exynos9820Wlan\WlanCommon.c" />
    <ClCompile Include="..\Exynos9820Wlan\WlanDl.c" />
    <ClCompile Include="..\Exynos9820Wlan\WlanMsg.c" />
    <ClCompile Include="..\Exynos9820Wlan\WlanSup.c" />
    <ClInclude Include="Cx.h" />
    <ClInclude Include="CxNames.h" />
    <ResourceCompile Include="resource.rc" />
    <Inf Include="Exynos9820WlanCx.inx">
      <Architecture>$(InfArch)</Architecture>
      <SpecifyArchitecture>true</SpecifyArchitecture>
      <CopyOutput>.\$(IntDir)\Exynos9820WlanCx.inf</CopyOutput>
    </Inf>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
