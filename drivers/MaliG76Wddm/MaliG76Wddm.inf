;
; MaliG76Wddm.inf - M16 G10/G11: display + GPU driver for the Galaxy S10e (Exynos 9820, Mali-G76).
; Binds ONLY the DSDT device \_SB.GPU0 (ACPI\SAMS9828). GPU0 is present only when UEFI handed over a powered G76
; and the rescue flags are clear (BEYOND0LTE_GPU_POWER_ON 1 image, no ESP \S10EDIAG\nogpu.flg); otherwise this
; driver never loads and Basic Display keeps the screen. notes/gpu-m16-g10.md.
; Derived from maliwddm.inf / malidod.inf of wddm-mali-g52 (https://github.com/gahingwoo/wddm-mali-g52), GPL-2.0.
;
; Mode (read at driver load from the service's Parameters key; the install resets both to 0):
;   GpuEnable 0, FullAdapter 0  display-only (KMDOD), no GPU access - the default
;   FullAdapter 1               full WDDM 1.3 adapter, GPU half off (needs maliumd.dll in System32)
;   GpuEnable 1                 full WDDM 1.3 adapter with the GPU half (G11)
; UserModeDriverName = maliumd.dll x4 as in maliwddm.inf (the G12 Mesa d3d10umd + panfrost build, installed to
; System32 by the ESP script). The display-only mode is a KMDOD and is not expected to load a UMD (UNVERIFIED that
; dxgkrnl ignores the value for a KMDOD - the first display-only boot answers it). The system-wide
; EnablePreemption 0 the original INF set is written by the ESP script only for the full-adapter modes.
; Switches (same key, DWORD, read at driver load; absent = default), notes/gpu-full-adapter-hang.md:
;   PramTrace 1   DDI entry/exit trace into reserved RAM 0x8FE04000 (16 KiB), saved by the firmware as \WINPRAM.BIN
;   SoftVsync 1   full adapter: software vsync (16 ms timer) while dxgkrnl enables CRTC_VSYNC (0 = never reported)
;   FlipBlt   1   full adapter: a Flip present is a CPU copy into the GOP framebuffer (0 = flips dropped)
;   RecommendVidPn 1  full adapter: RecommendFunctionalVidPn pins path 0->0 and our one mode (0 = no recommendation)
;   SynthEdid 1   full adapter: QueryDeviceDescriptor returns an EDID built for the reported timing (0 = none)
;   SegmentCpuVisible 1  full adapter: the aperture segment is CPU visible (dxgkrnl requires it for a shared primary)
;   ModeRefreshExact 1   full adapter: DescribeAllocation reports a primary at the target mode's exact refresh rational
;   Refresh601 1  full adapter: timing frequencies as reduced rationals (60/1) instead of PixelRate/total
;   FlipMmio 1    full adapter: FlipOnVSyncMmIo - flips via SetVidPnSourceAddress, latched (CPU copy) at the next soft vsync
;
; SPDX-License-Identifier: GPL-2.0
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/13/2026,1.0.34.1
CatalogFile = MaliG76Wddm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
MaliG76Wddm.sys = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%MW.DeviceDesc% = MW_Inst,ACPI\SAMS9828

[MW_Inst]
FeatureScore = F9
CopyFiles = MW_CopyFiles
AddReg = MW_Settings

[MW_Settings]
HKR,,UserModeDriverName,%REG_MULTI_SZ%,maliumd.dll,maliumd.dll,maliumd.dll,maliumd.dll

[MW_CopyFiles]
MaliG76Wddm.sys

[MW_Inst.Services]
AddService = MaliG76Wddm,0x00000002,MW_Service

[MW_Service]
DisplayName    = %MW.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %13%\MaliG76Wddm.sys
LoadOrderGroup = Video
AddReg         = MW_Parameters

[MW_Parameters]
; FLG_ADDREG_NOCLOBBER (0x2, MS Learn "INF AddReg Directive"): an install keeps the mode already set (every
; install reset FullAdapter/GpuEnable to 0 before - runs g13full/g13fullb).
HKR,Parameters,GpuEnable,%REG_DWORD_NOCLOBBER%,0
HKR,Parameters,FullAdapter,%REG_DWORD_NOCLOBBER%,0

[Strings]
ProviderName  = "exynos-woa"
DiskName      = "Galaxy S10e Mali-G76 display driver"
MW.DeviceDesc = "Arm Mali-G76 MP12 (Galaxy S10e, G10/G11)"
MW.SvcDesc    = "Galaxy S10e Mali-G76 display driver"
REG_DWORD     = 0x00010001
REG_DWORD_NOCLOBBER = 0x00010003
REG_MULTI_SZ  = 0x00010000
