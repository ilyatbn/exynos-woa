<?xml version="1.0" encoding="utf-8"?>
<!-- MaliG76Wddm: display-only / full WDDM 1.3 miniport (WDM + displib), ARM64. build-package.ps1 builds and signs it. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8E2C1F6B-5D3A-4B7E-9828-C76D0A1E0B10}</ProjectGuid>
    <ProjectName>MaliG76Wddm</ProjectName>
    <TargetName>MaliG76Wddm</TargetName>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
    <SignMode>Off</SignMode>
    <MwBuild Condition="'$(MwBuild)'==''">1</MwBuild>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WppEnabled>false</WppEnabled>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <Optimization>MinSpace</Optimization>
      <PreprocessorDefinitions>MW_BUILD=$(MwBuild);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>%(AdditionalOptions) /Brepro /arch:armv8.0 /forceInterlockedFunctions-</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>displib.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="adapter.c" />
    <ClCompile Include="display.c" />
    <ClCompile Include="memory.c" />
    <ClCompile Include="command.c" />
    <ClCompile Include="maligpu.c" />
    <ClCompile Include="pram.c" />
    <ClCompile Include="panel.c" />
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Target Name="ValidateOfflineBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SignMode)' != 'Off'" Text="Use the separately reviewed device signing/deployment workflow." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
