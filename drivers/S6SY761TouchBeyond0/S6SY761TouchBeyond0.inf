[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ProviderString%
DriverVer = 10/17/2026,6.0.5058.7
CatalogFile=S6SY761TouchBeyond0.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerString%=Microsoft,NTarm64.10.0...16299

[Microsoft.NTarm64.10.0...16299]
%DeviceDesc%=S6SY761TouchBeyond0, ACPI\SCSY0761

[S6SY761TouchBeyond0.NT]
CopyFiles=KMDriverCopy

[S6SY761TouchBeyond0.NT.hw]
AddReg=S6SY761TouchBeyond0_AddReg

[S6SY761TouchBeyond0.NT.Services]
AddService=S6SY761TouchBeyond0,0x00000002,S6SY761TouchBeyond0_Service_Inst

[S6SY761TouchBeyond0.NT.Wdf]
KmdfService=S6SY761TouchBeyond0,S6SY761TouchBeyond0_Wdf

[S6SY761TouchBeyond0_Wdf]
KmdfLibraryVersion=1.15


[S6SY761TouchBeyond0_AddReg]
HKR,,"UpperFilters",    %REG_MULTI_SZ%, mshidkmdf
HKR,,"MultiportDevice", %REG_DWORD%,    0
HKR,,"XRevert",0x00010001,0
HKR,,"YRevert",0x00010001,0
HKR,,"XYExchange",0x00010001,0
HKR,,"XMin",0x00010001,0
HKR,,"XMax",0x00010001,4095
HKR,,"YMin",0x00010001,0
HKR,,"YMax",0x00010001,4095

[S6SY761TouchBeyond0_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\S6SY761TouchBeyond0.sys

[KMDriverCopy]
S6SY761TouchBeyond0.sys

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
S6SY761TouchBeyond0.sys=1

[DestinationDirs]
KMDriverCopy=13

;---------------------------------------------------------------;

[Strings]
ProviderString     = "Morc - Richard Gráčik"
ManufacturerString = "Samsung Electronics Co."
DeviceDesc         = "Samsung SEC-S6SY761 Touchscreen Controller Device"
ServiceDesc        = "Samsung SEC-S6SY761 Touchscreen Controller Service"
DiskDesc           = "Samsung SEC-S6SY761 Touchscreen Controller Installation Disk"
REG_MULTI_SZ            = 0x00010000
REG_DWORD               = 0x00010001
