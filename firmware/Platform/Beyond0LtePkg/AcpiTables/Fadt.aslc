/** @file
  FADT — Fixed ACPI Description Table for Exynos 9820 / Galaxy S10e.

  Ported from Star2LtePkg's FADT for the Exynos 9810. ARM is a "hardware-reduced"
  ACPI platform: there is no legacy ACPI PM block, no SCI/SMI, no PM timer, so
  almost every field below is 0. The fields that matter are:
    - Flags        -> HW_REDUCED_ACPI (+ low-power S0 idle + reset register)
    - ResetReg     -> Exynos PMU SWRESET, used because EL3 lacks PSCI SYSTEM_RESET
    - ArmBootArch  -> PSCI_COMPLIANT only when BEYOND0LTE_FADT_PSCI (m14: off with parking)

  The DSDT pointer (XDsdt) is filled in at install time by the AcpiPlatformDxe, so
  it is left 0 here.

  WHAT MOVES vs the 9810: the PMU itself. The 9820's power-management unit is
  system-controller@15860000 (VERIFIED read, Exynos9820.h EXYNOS_PMU_BASE); the
  9810's 0x14060000 is NOT present on this SoC. So the reset-register base is a
  read, but the SWRESET register OFFSET inside it is not — see the UNVERIFIED note
  on BEYOND0LTE_PMU_SWRESET_ADDRESS below.

  *** UNVERIFIED on this SoC: the PSCI flag and the reset register. The 9810 flow
      relied on the EL3 monitor exposing PSCI (CPU_ON/CPU_OFF) but NOT SYSTEM_RESET,
      which is why RESET_REG_SUP + the PMU SWRESET are used. On the S10e nothing
      about our EL3 monitor's PSCI has been confirmed — the device tree's
      enable-method = "psci" is the ANDROID/kernel view, not proof that the monitor
      Windows runs against implements PSCI. Confirm before trusting these two
      fields (see notes/dock-desktop.md and notes/s10e-live-reads.md). ***
**/

#include "Beyond0LteAcpiHeader.h"
#include <IndustryStandard/Acpi63.h>
#include <Platform/Exynos9820.h>

//
// Reset register: the Exynos PMU SWRESET. The BASE is a verified read
// (EXYNOS_PMU_BASE = 0x15860000, system-controller@15860000). The +0x400 SWRESET
// offset is the 9810's (0x14060000 -> 0x14060400) and has NOT been read on the
// S10e, so the whole address is UNVERIFIED — do not treat 0x15860400 as a fact.
//
#define BEYOND0LTE_PMU_SWRESET_ADDRESS  (EXYNOS_PMU_BASE + EXYNOS_PMU_SWRESET_OFFSET)  // W32: VERIFIED 0x3A00 (Samsung kernel exynos_reboot + sboot; the 9810 +0x400 did nothing - Windows restarts hung)
#define BEYOND0LTE_RESET_GAS \
  { EFI_ACPI_6_3_SYSTEM_MEMORY, 32, 0, EFI_ACPI_6_3_DWORD, BEYOND0LTE_PMU_SWRESET_ADDRESS }

EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE  Fadt = {
  ACPI_HEADER (
    EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE_SIGNATURE,
    EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE,
    EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE_REVISION
    ),
  0,                                              // FirmwareCtrl (use XFirmwareCtrl)
  0,                                              // Dsdt (use XDsdt; set by installer)
  EFI_ACPI_RESERVED_BYTE,                         // Reserved0
  EFI_ACPI_6_3_PM_PROFILE_TABLET,                 // PreferredPmProfile (phone/tablet)
  0,                                              // SciInt
  0,                                              // SmiCmd
  0,                                              // AcpiEnable
  0,                                              // AcpiDisable
  0,                                              // S4BiosReq
  0,                                              // PstateCnt
  0,                                              // Pm1aEvtBlk
  0,                                              // Pm1bEvtBlk
  0,                                              // Pm1aCntBlk
  0,                                              // Pm1bCntBlk
  0,                                              // Pm2CntBlk
  0,                                              // PmTmrBlk
  0,                                              // Gpe0Blk
  0,                                              // Gpe1Blk
  0,                                              // Pm1EvtLen
  0,                                              // Pm1CntLen
  0,                                              // Pm2CntLen
  0,                                              // PmTmrLen
  0,                                              // Gpe0BlkLen
  0,                                              // Gpe1BlkLen
  0,                                              // Gpe1Base
  0,                                              // CstCnt
  0,                                              // PLvl2Lat
  0,                                              // PLvl3Lat
  0,                                              // FlushSize
  0,                                              // FlushStride
  0,                                              // DutyOffset
  0,                                              // DutyWidth
  0,                                              // DayAlrm
  0,                                              // MonAlrm
  0,                                              // Century
  0,                                              // IaPcBootArch (x86 only)
  EFI_ACPI_RESERVED_BYTE,                         // Reserved1
  // Flags: hardware-reduced ACPI, S0 low-power idle, and PMU reset supported.
  // RESET_REG_SUP is UNVERIFIED on this SoC — it asserts the SWRESET below works.
  EFI_ACPI_6_3_HW_REDUCED_ACPI |
    EFI_ACPI_6_3_LOW_POWER_S0_IDLE_CAPABLE |
    EFI_ACPI_6_3_RESET_REG_SUP,
  BEYOND0LTE_RESET_GAS,                           // ResetReg: PMU SWRESET (offset UNVERIFIED)
  EXYNOS_PMU_SWRESET_VALUE,                       // ResetValue: 2 (W32: VERIFIED, same sites)
  // ArmBootArch (m14, Beyond0LteAcpiHeader.h BEYOND0LTE_FADT_PSCI). The EL3 is
  // PSCI 0.1 (live DT /psci, m10 W8): CPU_ON/CPU_OFF/CPU_SUSPEND only, so a
  // PSCI_COMPLIANT FADT makes Windows reset through SYSTEM_RESET, which fails
  // (0xA0, m11 run 5). With the parking protocol on, the flag is cleared: the
  // secondaries come from the MADT mailboxes and restart uses ResetReg above.
  // That Windows accepts a non-PSCI FADT is UNVERIFIED on this device.
#if BEYOND0LTE_FADT_PSCI
  EFI_ACPI_6_3_ARM_PSCI_COMPLIANT,
#else
  0,
#endif
  EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE_MINOR_REVISION,
  0,                                              // XFirmwareCtrl
  0,                                              // XDsdt (set by installer)
  NULL_GAS,                                       // XPm1aEvtBlk
  NULL_GAS,                                       // XPm1bEvtBlk
  NULL_GAS,                                       // XPm1aCntBlk
  NULL_GAS,                                       // XPm1bCntBlk
  NULL_GAS,                                       // XPm2CntBlk
  NULL_GAS,                                       // XPmTmrBlk
  NULL_GAS,                                       // XGpe0Blk
  NULL_GAS,                                       // XGpe1Blk
  NULL_GAS,                                       // SleepControlReg (TODO: PSCI SYSTEM_OFF used instead)
  NULL_GAS,                                       // SleepStatusReg
  0,                                              // HypervisorVendorIdentity
};

VOID *CONST  ReferenceAcpiTable = &Fadt;
