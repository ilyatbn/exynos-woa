## @file
#  PlatformMemoryMapLib — Exynos 9820 / Galaxy S10e (beyond0lte).
#  Full ArmPlatformLib: memory map (PlatformMemoryMapLib.c) + boot-flow entry
#  points (ArmPlatformLib.c).
#
#  Mirrors Star2LtePkg's library. Nothing here is validated on an S10e yet.
#
#  Beyond0LteFbText.c is carried here as on the 9810, and it draws on this
#  SoC now that EXYNOS_FB_BASE is 0xCA000000 in Exynos9820.h — read from the
#  device's own kernel command line (s3cfb.bootloaderfb, notes/s10e-root-reads.md
#  §3). No caller in this module draws to the panel yet, so the on-panel
#  progress channel the 9810 flow uses stays unavailable until one is added.
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Beyond0LtePlatformMemoryMapLib
  FILE_GUID                      = 11111111-2222-3333-4444-555555555531
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 0.1
  LIBRARY_CLASS                  = ArmPlatformLib

[Sources]
  PlatformMemoryMapLib.c
  ArmPlatformLib.c
  Beyond0LteFbText.c

[Sources.AARCH64]
  AArch64/Beyond0LteDiagVectors.S

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  ArmPlatformPkg/ArmPlatformPkg.dec
  Silicon/Exynos9820Pkg/Exynos9820Pkg.dec

[LibraryClasses]
  ArmLib
  DebugLib
  PcdLib

[Ppis]
  gArmMpCoreInfoPpiGuid           ## PRODUCES

[FixedPcd]
  gArmPlatformTokenSpaceGuid.PcdCoreCount
  gArmPlatformTokenSpaceGuid.PcdClusterCount
  gArmTokenSpaceGuid.PcdArmPrimaryCore
