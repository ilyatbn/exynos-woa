## @file
#  Silicon package declaration for Exynos 9820 (Galaxy S10e, beyond0lte).
#  Mirrors Silicon/Exynos9810Pkg/Exynos9810Pkg.dec. Values come from the
#  shipping 9820 device tree and from live reads on the phone — see
#  notes/dock-desktop.md §5, §13 and §15 in this repo. The platform DSC
#  overrides them. See Include/Platform/Exynos9820.h.
#
#  NOTHING HERE IS VALIDATED ON HARDWARE.
##

[Defines]
  DEC_SPECIFICATION              = 0x0001001B
  PACKAGE_NAME                   = Exynos9820Pkg
  PACKAGE_GUID                   = 11111111-2222-3333-4444-555555555520
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  gExynos9820TokenSpaceGuid = { 0xe9820000, 0x0001, 0x0001, { 0xa0, 0x01, 0x00, 0x00, 0x00, 0x00, 0x98, 0x20 } }

[PcdsFixedAtBuild]
  ## Debug UART base. VERIFIED on the live S10e and in the vendor DT: uart@10440000,
  ## same base as the 9810, window 0x100. Consumed by Exynos9820SerialPortLib.
  gExynos9820TokenSpaceGuid.PcdSerialRegisterBase|0x0000000010440000|UINT64|0x00000001

  ## DRAM base. VERIFIED (memory@80000000).
  gExynos9820TokenSpaceGuid.PcdSystemMemoryBase|0x0000000080000000|UINT64|0x00000002

  ## Usable DRAM. The vendor DT declares bank0 as a full 2 GiB
  ## (reg = <0x0 0x80000000 0x80000000>), but the board file this phone includes
  ## reserves a contiguous 729 MB of it, 0xD0000000..0xFD900000, for the modem/CP
  ## stack. This is the front of bank0 up to that first reservation — 1.25 GiB —
  ## which is the conservative value the memory map actually publishes. The tail
  ## and the two high 2 GiB banks are added once the split sizes are confirmed.
  ## See notes/dock-desktop.md §17.
  gExynos9820TokenSpaceGuid.PcdSystemMemorySize|0x0000000050000000|UINT64|0x00000003

  ## GIC distributor (GICD) base. VERIFIED — IDENTICAL to the 9810: the 9820's
  ## node is interrupt-controller@10100000 with reg GICD 0x10101000/0x1000.
  gExynos9820TokenSpaceGuid.PcdGicDistributorBase|0x0000000010101000|UINT64|0x00000004

  ## GIC CPU interface (GICC) base. VERIFIED — identical to the 9810.
  gExynos9820TokenSpaceGuid.PcdGicInterfaceBase|0x0000000010102000|UINT64|0x00000005

  ## Core count. VERIFIED from /proc/cpuinfo on the S10e: 8 logical CPUs.
  gExynos9820TokenSpaceGuid.PcdCoreCount|8|UINT32|0x00000006

  ## Cluster count. VERIFIED from the live device tree and the vendor DT: TWO
  ## MPIDR clusters, sized 6 + 2 (cpu@0000..0005 then cpu@0100,cpu@0101). There
  ## are THREE efficiency classes inside them - ananke (LITTLE), prometheus (MID)
  ## and cheetah (BIG) - which is what the power domains LITTLE/MID/BIG name, but
  ## affinity has only two clusters. Anything deriving a per-cluster core count
  ## by dividing CoreCount by ClusterCount is wrong here: 8/2 = 4 would put the
  ## two BIG cores into the MID cores' slots. See notes/dock-desktop.md §16.
  gExynos9820TokenSpaceGuid.PcdClusterCount|2|UINT32|0x00000007
