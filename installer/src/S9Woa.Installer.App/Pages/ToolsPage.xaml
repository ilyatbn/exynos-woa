<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Style="{StaticResource PageColumnStyle}">
            <StackPanel>
                <TextBlock Text="Device tools" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="DeviceLine" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Restart the phone into…" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRecovery" MinWidth="150">
                            <StackPanel Spacing="4" Padding="4,6">
                                <FontIcon Glyph="&#xE777;" FontSize="22" />
                                <TextBlock Text="TWRP recovery" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnDownload" MinWidth="150">
                            <StackPanel Spacing="4" Padding="4,6">
                                <FontIcon Glyph="&#xE896;" FontSize="22" />
                                <TextBlock Text="Download mode" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnSystem" MinWidth="150">
                            <StackPanel Spacing="4" Padding="4,6">
                                <FontIcon Glyph="&#xE72C;" FontSize="22" />
                                <TextBlock Text="Normal boot" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="These use ADB and need the phone connected over USB with debugging enabled. Normal boot starts Windows once Windows is installed (UEFI lives in the BOOT partition)." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Restart to TWRP (from Windows on the phone)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="When you are running Windows on your phone, this schedules the next restart to boot TWRP instead of Windows, then restarts. It talks to the phone's UFS storage driver directly - no USB cable or ADB needed. The ticket protocol is ported for the Galaxy S9+; it has not been derived for the S10e." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TwrpTicketButton" Content="Restart to TWRP now" Click="OnRestartToTwrp" />
                    </StackPanel>
                    <TextBlock x:Name="TwrpTicketText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save phone info" Click="OnSaveInfo" />
                        <Button Content="Open logs folder" Click="OnOpenLogs" />
                    </StackPanel>
                    <TextBlock x:Name="DiagText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Installer progress" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="The installer remembers finished steps so it can resume after a restart. Reset this only if you want to start over with a different phone or image. It does not touch the phone." />
                    <Button Content="Reset installer progress" Click="OnReset" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
