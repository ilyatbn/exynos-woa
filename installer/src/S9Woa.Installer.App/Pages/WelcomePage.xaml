<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Style="{StaticResource PageColumnStyle}" Spacing="0">
            <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Left" Margin="0,8,0,32"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE8EA;" FontSize="30" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock Text="Windows on your Galaxy S9+" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,40"
                       Text="This installer takes a Samsung Galaxy S9+ (SM-G965F, validated) or a Galaxy S10e (SM-G970F, ported but never observed end to end) from stock Android to Windows 11 on ARM, with open-source firmware and drivers. It walks you through every step and checks each one before moving on." />

            <Grid ColumnSpacing="16" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE823;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="About an hour" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Most of it runs unattended." Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xEDA2;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="80 GB free on this PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="For the image and your phone's backup." Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE88E;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="A USB-C data cable" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Connected straight to this PC." Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,28">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTileStyle}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Before you begin" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Installing erases Android and everything on the phone. Unlocking the bootloader permanently trips Knox, so Samsung Pay and Secure Folder stop working." />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="This is experimental: only the SM-G965F on one firmware is validated, and cellular, camera, audio and GPU acceleration don't work yet." />
                    </StackPanel>
                </Grid>
            </Border>

            <CheckBox x:Name="AcceptBox" Checked="OnAcceptChanged" Unchecked="OnAcceptChanged"
                      Content="I understand this erases my phone and that the software is experimental." />
        </StackPanel>
    </ScrollViewer>
</Page>
