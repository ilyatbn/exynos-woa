  * handed to DXGI, which has maliwddm blt it (on the CPU, for now) to the
  * screen. 0 if presented; -1 if not bound to the runtime (the caller falls
  * back to GDI). */
+/* G13: a primary present surface pair for flips; 0 if ready. Called with wddm_lock held. */
+static int
+present_primaries(unsigned w, unsigned h)
+{
+   if (ddi.prim[0] && (ddi.prim_w != w || ddi.prim_h != h)) {
+      for (int i = 0; i < 2; i++) {
+         if (ddi.prim[i]) {
+            w_unlock(ddi.prim[i]);
+            w_destroy(ddi.prim[i]);
+         }
+         ddi.prim[i] = 0;
+         ddi.prim_cpu[i] = NULL;
+      }
+   }
+   for (int i = 0; i < 2; i++) {
+      if (ddi.prim[i])
+         continue;
+      MW_ALLOCATION_INFO pi = {0};
+      D3DDDI_ALLOCATIONINFO ai = {0};
+      pi.Version = MW_ABI_VERSION;
+      pi.Flags = MW_ALLOC_NOEXEC | MW_ALLOC_PRIMARY;
+      pi.Width = w;
+      pi.Height = h;
+      pi.Pitch = w * 4;
+      pi.Format = D3DDDIFMT_A8R8G8B8;   /* as the VidPN source mode (MaliG76Wddm FillSourceMode) */
+      pi.Size = (uint64_t)w * h * 4;
+      ai.pPrivateDriverData = &pi;
+      ai.PrivateDriverDataSize = sizeof(pi);
+      ai.VidPnSourceId = 0;
+      ai.Flags.Primary = 1;
+      if (w_create(&ai) < 0) {
+         if (trace_on())
+            fprintf(stderr, "malikm: primary present surface %ux%u: allocate failed\n", w, h);
+         return -1;
+      }
+      ddi.prim[i] = ai.hAllocation;
+      ddi.prim_cpu[i] = w_lock(ddi.prim[i]);
+      if (!ddi.prim_cpu[i])
+         return -1;
+   }
+   ddi.prim_w = w;
+   ddi.prim_h = h;
+   return 0;
+}
