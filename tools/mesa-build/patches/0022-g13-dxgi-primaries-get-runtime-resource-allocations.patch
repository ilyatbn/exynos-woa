diff --git a/include/win32-compat/malikm_drm.c b/include/win32-compat/malikm_drm.c
index bc35d92..b4b2256 100644
--- a/include/win32-compat/malikm_drm.c
+++ b/include/win32-compat/malikm_drm.c
@@ -924,6 +924,108 @@ wddm_idle(void)
  * handed to DXGI, which has maliwddm blt it (on the CPU, for now) to the
  * screen. 0 if presented; -1 if not bound to the runtime (the caller falls
  * back to GDI). */
+/* G13 (exynos-woa): kernel primary allocations for the runtime's DXGI primaries (d3d10umd CreateResource with
+ * pPrimaryDesc): allocated through the bound runtime's pfnAllocateCb WITH the runtime resource handle and
+ * Flags.Primary, so dxgkrnl ties them to the swap-chain resource; kept locked for CPU writes. */
+#define MAX_KPRIM 16
+static struct { D3DKMT_HANDLE h; void *cpu; unsigned w, hgt; } kprim[MAX_KPRIM];
+
+int
+malikm_primary_create(void *hRTResource, unsigned vidpn, unsigned w, unsigned h, unsigned *hAlloc)
+{
+   int ret = -1;
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   if (!ddi.on || !ddi.cb.pfnAllocateCb)
+      goto out;
+   for (int i = 0; i < MAX_KPRIM; i++) {
+      if (kprim[i].h)
+         continue;
+      MW_ALLOCATION_INFO pi = {0};
+      D3DDDI_ALLOCATIONINFO ai = {0};
+      D3DDDICB_ALLOCATE a = {0};
+      pi.Version = MW_ABI_VERSION;
+      pi.Flags = MW_ALLOC_NOEXEC | MW_ALLOC_PRIMARY;
+      pi.Width = w;
+      pi.Height = h;
+      pi.Pitch = w * 4;
+      pi.Format = D3DDDIFMT_A8R8G8B8;
+      pi.Size = (uint64_t)w * h * 4;
+      ai.pPrivateDriverData = &pi;
+      ai.PrivateDriverDataSize = sizeof(pi);
+      ai.VidPnSourceId = vidpn;
+      ai.Flags.Primary = 1;
+      a.hResource = (HANDLE)hRTResource;
+      a.NumAllocations = 1;
+      a.pAllocationInfo = &ai;
+      HRESULT hr = ddi.cb.pfnAllocateCb(ddi.device, &a);
+      if (trace_on())
+         fprintf(stderr, "malikm: primary for runtime resource %p %ux%u source %u: hr 0x%08lx alloc 0x%x\n",
+                 hRTResource, w, h, vidpn, (unsigned long)hr, (unsigned)ai.hAllocation);
+      if (hr < 0)
+         goto out;
+      kprim[i].h = ai.hAllocation;
+      kprim[i].cpu = NULL;
+      kprim[i].w = w;
+      kprim[i].hgt = h;
+      *hAlloc = ai.hAllocation;
+      ret = 0;
+      goto out;
+   }
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
+void
+malikm_primary_destroy(unsigned hAlloc)
+{
+   AcquireSRWLockExclusive(&wddm_lock);
+   for (int i = 0; i < MAX_KPRIM; i++) {
+      if (kprim[i].h != hAlloc)
+         continue;
+      if (kprim[i].cpu)
+         w_unlock(kprim[i].h);
+      /* The runtime frees a resource's allocations itself when the resource goes (pfnAllocateCb with
+       * hResource); only forget it here. */
+      kprim[i].h = 0;
+      kprim[i].cpu = NULL;
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+int
+malikm_primary_present(unsigned hAlloc, const void *bgrx, unsigned w, unsigned h, void *dxgi_context)
+{
+   int ret = -1;
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   if (!ddi.on || !ddi.dxgi || !ddi.dxgi->pfnPresentCb)
+      goto out;
+   for (int i = 0; i < MAX_KPRIM; i++) {
+      if (kprim[i].h != hAlloc)
+         continue;
+      if (kprim[i].w != w || kprim[i].hgt != h)
+         goto out;
+      if (!kprim[i].cpu)
+         kprim[i].cpu = w_lock(kprim[i].h);
+      if (!kprim[i].cpu)
+         goto out;
+      memcpy(kprim[i].cpu, bgrx, (size_t)w * h * 4);
+      DXGIDDICB_PRESENT p = {0};
+      p.hSrcAllocation = kprim[i].h;
+      p.pDXGIContext = dxgi_context;
+      p.hContext = ddi.context;
+      ret = ddi.dxgi->pfnPresentCb(ddi.device, &p) >= 0 ? 0 : -1;
+      if (trace_on() && ret)
+         fprintf(stderr, "malikm: pfnPresentCb (runtime primary 0x%x) failed\n", hAlloc);
+      goto out;
+   }
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
 /* G13: a primary present surface pair for flips; 0 if ready. Called with wddm_lock held. */
 static int
 present_primaries(unsigned w, unsigned h)
