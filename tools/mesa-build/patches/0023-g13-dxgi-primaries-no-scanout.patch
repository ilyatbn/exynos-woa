+   /* G13 (exynos-woa, patch 0023): DXGI primaries are not scan-out capable on the maliwddm runtime, so DXGI
+    * composes with blt presents into the shared primary instead of flipping. Every flip of DWM's swap chain was
+    * refused with STATUS_GRAPHICS_PRESENT_MODE_CHANGED whatever the primary allocation (shim-owned g22-g24,
+    * resource-owned g25, DMA or MMIO flips g26); blt presents work (the boot console's). The flag is the one the
+    * #if 0 block above names (DXGI_DDI_PRIMARY_DRIVER_FLAG_NO_SCANOUT). MALIKM_SCANOUT=1 keeps the flip path. */
+   bool no_scanout = false;
+   if (pCreateResource->pPrimaryDesc && d3d10_runtime_is_maliwddm()) {
+      const char *keep = getenv("MALIKM_SCANOUT");
+      if (!(keep && *keep == '1')) {
+         pCreateResource->pPrimaryDesc->DriverFlags |= DXGI_DDI_PRIMARY_DRIVER_FLAG_NO_SCANOUT;
+         no_scanout = true;
+      }
+   }
