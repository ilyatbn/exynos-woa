diff --git a/src/gallium/frontends/d3d10umd/DxgiFns.cpp b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
index 3f8bef0..5414dc6 100644
--- a/src/gallium/frontends/d3d10umd/DxgiFns.cpp
+++ b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
@@ -46,6 +46,9 @@
 extern "C" __declspec(thread) int d3d10_present_flip = 0;
 /* G13: the kernel primary allocation of the resource being presented (Resource.kmt_primary), 0 if none. */
 extern "C" __declspec(thread) unsigned d3d10_present_alloc = 0;
+/* G13 (0025): the kernel allocation of the present's destination resource (DXGI_DDI_ARG_PRESENT.hDstResource), 0
+ * if none - passed on as DXGIDDICB_PRESENT.hDstAllocation. */
+extern "C" __declspec(thread) unsigned d3d10_present_dst = 0;
 
 
 /*
@@ -71,10 +74,12 @@ _Present(DXGI_DDI_ARG_PRESENT *pPresentData)
    device->pipe->flush(device->pipe, NULL, 0);
    d3d10_present_flip = pPresentData->Flags.Flip;
    d3d10_present_alloc = pSrcResource ? pSrcResource->kmt_primary : 0;
+   d3d10_present_dst = pPresentData->hDstResource ? CastResource(pPresentData->hDstResource)->kmt_primary : 0;
    device->pipe->screen->flush_frontbuffer(device->pipe->screen, device->pipe, 
       pSrcResource->resource, 0, 0, pPresentData->pDXGIContext, 0, NULL);
    d3d10_present_flip = 0;
    d3d10_present_alloc = 0;
+   d3d10_present_dst = 0;
 
    return S_OK;
 }
diff --git a/src/gallium/frontends/d3d10umd/Resource.cpp b/src/gallium/frontends/d3d10umd/Resource.cpp
