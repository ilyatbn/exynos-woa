+++ b/src/gallium/frontends/d3d10umd/Resource.cpp
@@ -191,7 +191,8 @@ subResourceBox(struct pipe_resource *resource, // IN
 
 /* G13 (exynos-woa, malikm_drm.c): a primary allocation of the runtime resource, through the bound runtime's
  * callbacks; 0 and *hAlloc set on success, -1 when not bound to maliwddm (nothing changes then). */
-extern "C" int malikm_primary_create(void *hRTResource, unsigned vidpn, unsigned w, unsigned h, unsigned *hAlloc);
+extern "C" int malikm_primary_create(void *hRTResource, unsigned vidpn, unsigned w, unsigned h, unsigned *hAlloc,
+                                     int scanout);
 extern "C" void malikm_primary_destroy(unsigned hAlloc);
 /* G13: true when the device is bound to the maliwddm runtime (d3d10_gdi.c d3d10_bind_runtime result >= 0). */
 extern "C" bool d3d10_runtime_is_maliwddm(void);
@@ -338,10 +339,12 @@ CreateResource(D3D10DDI_HDEVICE hDevice,                                // IN
    /* G13: DXGI swap-chain primaries get a kernel primary allocation tied to the runtime resource, so the
     * runtime's flip of this resource names an allocation dxgkrnl created for the current mode (shim-owned
     * primaries were refused with STATUS_GRAPHICS_PRESENT_MODE_CHANGED, runs g22-g24). Not with no_scanout. */
-   if (pCreateResource->pPrimaryDesc && !no_scanout && templat.target == PIPE_TEXTURE_2D) {
+   /* G13 (patch 0025): a NO_SCANOUT primary gets one too, without Flags.Primary: run g28full, DWM's Blt presents
+    * named the shim's private surface (not the presented resource's allocation) and never reached the KMD. */
+   if (pCreateResource->pPrimaryDesc && templat.target == PIPE_TEXTURE_2D) {
       unsigned h = 0;
       if (malikm_primary_create(hRTResource.handle, pCreateResource->pPrimaryDesc->VidPnSourceId,
-                                templat.width0, templat.height0, &h) == 0)
+                                templat.width0, templat.height0, &h, !no_scanout) == 0)
          pResource->kmt_primary = h;
    }
 
