--- a/src/gallium/frontends/d3d10umd/DxgiFns.cpp
+++ b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
@@ -127,12 +127,19 @@ _GetGammaCaps( DXGI_DDI_ARG_GET_GAMMA_CONTROL_CAPS *GetCaps )
  * ----------------------------------------------------------------------
  */
 
+/* G13 (exynos-woa, patch 0028): the resource's kernel primary goes to the runtime's pfnSetDisplayModeCb (malikm_drm.c);
+ * returns 1 when not bound to maliwddm or the resource has none (then S_OK, as the stub did). */
+extern "C" long malikm_set_display_mode(unsigned hAlloc);
+
 HRESULT APIENTRY
 _SetDisplayMode( DXGI_DDI_ARG_SETDISPLAYMODE *SetDisplayMode )
 {
-   LOG_UNSUPPORTED_ENTRYPOINT();
+   LOG_ENTRYPOINT();
 
-   return S_OK;
+   Resource *pResource = SetDisplayMode->hResource ? CastResource(SetDisplayMode->hResource) : NULL;
+   long hr = malikm_set_display_mode(pResource ? pResource->kmt_primary : 0);
+
+   return hr < 0 ? (HRESULT)hr : S_OK;
 }
 
 
