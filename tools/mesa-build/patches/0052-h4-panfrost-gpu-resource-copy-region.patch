From 70d06a9b8de59d0617966dfa78a65c562c12a8c4 Mon Sep 17 00:00:00 2001
From: g12-build <g12@local>
Date: Wed, 14 Oct 2026 03:04:47 +0300
Subject: [PATCH] H4: Panfrost copies same-format colour textures with the GPU
 (blit) instead of util_resource_copy_region's CPU memcpy - DWM's
 RotateResourceIdentities spent most of each frame there (run h3i samples)
 (exynos-woa tools/mesa-build/patches/0052)

---
 src/gallium/drivers/panfrost/pan_resource.c | 43 ++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/panfrost/pan_resource.c b/src/gallium/drivers/panfrost/pan_resource.c
index 6a5f4dc..9c55427 100644
--- a/src/gallium/drivers/panfrost/pan_resource.c
+++ b/src/gallium/drivers/panfrost/pan_resource.c
@@ -2611,6 +2611,47 @@ panfrost_resource_screen_destroy(struct pipe_screen *pscreen)
    u_transfer_helper_destroy(pscreen->transfer_helper);
 }
 
+/* exynos-woa H4 (notes/gpu-hw-path.md): resource_copy_region was util_resource_copy_region - a CPU copy through
+ * mapped transfers - for every texture. d3d10umd sends CopyResource, CopySubresourceRegion and DXGI's
+ * RotateResourceIdentities (every DWM present: the swap chain's buffers copied round) through it, so DWM spent most
+ * of each frame in memcpy out of uncached GPU memory (run h3i, dwm stack samples). Same-format, same-sample-count
+ * colour textures are copied by the GPU (panfrost_blit, which saves and restores state through the blitter);
+ * buffers, depth/stencil and anything mismatched keep the CPU path. */
+static void
+panfrost_resource_copy_region(struct pipe_context *pctx, struct pipe_resource *dst, unsigned dst_level,
+                              unsigned dstx, unsigned dsty, unsigned dstz, struct pipe_resource *src,
+                              unsigned src_level, const struct pipe_box *src_box)
+{
+   if (dst->target != PIPE_BUFFER && src->target != PIPE_BUFFER && dst->format == src->format &&
+       dst->nr_samples == src->nr_samples && !util_format_is_depth_or_stencil(dst->format) &&
+       !util_format_is_compressed(dst->format) &&
+       pctx->screen->is_format_supported(pctx->screen, dst->format, dst->target, dst->nr_samples,
+                                         dst->nr_storage_samples, PIPE_BIND_RENDER_TARGET) &&
+       pctx->screen->is_format_supported(pctx->screen, src->format, src->target, src->nr_samples,
+                                         src->nr_storage_samples, PIPE_BIND_SAMPLER_VIEW)) {
+      struct pipe_blit_info info;
+      memset(&info, 0, sizeof(info));
+      info.dst.resource = dst;
+      info.dst.level = dst_level;
+      info.dst.format = dst->format;
+      info.dst.box.x = dstx;
+      info.dst.box.y = dsty;
+      info.dst.box.z = dstz;
+      info.dst.box.width = src_box->width;
+      info.dst.box.height = src_box->height;
+      info.dst.box.depth = src_box->depth;
+      info.src.resource = src;
+      info.src.level = src_level;
+      info.src.format = src->format;
+      info.src.box = *src_box;
+      info.mask = PIPE_MASK_RGBA;
+      info.filter = PIPE_TEX_FILTER_NEAREST;
+      pctx->blit(pctx, &info);
+      return;
+   }
+   util_resource_copy_region(pctx, dst, dst_level, dstx, dsty, dstz, src, src_level, src_box);
+}
+
 void
 panfrost_resource_context_init(struct pipe_context *pctx)
 {
@@ -2618,7 +2659,7 @@ panfrost_resource_context_init(struct pipe_context *pctx)
    pctx->buffer_unmap = u_transfer_helper_transfer_unmap;
    pctx->texture_map = u_transfer_helper_transfer_map;
    pctx->texture_unmap = u_transfer_helper_transfer_unmap;
-   pctx->resource_copy_region = util_resource_copy_region;
+   pctx->resource_copy_region = panfrost_resource_copy_region;
    pctx->blit = panfrost_blit;
    pctx->generate_mipmap = panfrost_generate_mipmap;
    pctx->flush_resource = panfrost_flush_resource;
-- 
