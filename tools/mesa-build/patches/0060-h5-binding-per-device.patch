             got < sizeof(v)) {
@@ -455,19 +455,34 @@ drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *prime_fd)
  * a kernel allocation; d3d10umd registers it as a BO (malikm_shared_bo_create / malikm_bo_from_allocation) and
  * passes this pseudo fd, which only these functions understand. */
 #define MALIKM_PRIME_FD_BASE 0x40000000
+/* exynos-woa H5 (0060): the pseudo fd also names the runtime-device binding whose BO table holds the handle:
+ * bits 29..20 = binding + 1, 19..0 = BO handle. */
+#define PRIME_FD(b, h) ((int)(MALIKM_PRIME_FD_BASE | ((uint32_t)((b) + 1) << 20) | ((uint32_t)(h) & 0xfffffu)))
+#define PRIME_FD_H(fd) ((uint32_t)(fd) & 0xfffffu)
+#define PRIME_FD_B(fd) ((int)(((uint32_t)(fd) >> 20) & 0x3ffu) - 1)
 static struct wbo *wddm_bo(uint32_t h);
 static uint32_t wbo_add(D3DKMT_HANDLE hAlloc, uint64_t size, uint64_t va, uint32_t runtime_owned);
+static SRWLOCK wddm_lock;
+static int bind_for_fd(int fd);
+static void bind_switch(int i);
+static int cur_bind;
 
 int
 drmPrimeFDToHandle(int fd, int prime_fd, uint32_t *handle)
 {
-   (void)fd;
-   if ((prime_fd & MALIKM_PRIME_FD_BASE) && wddm_bo((uint32_t)prime_fd & ~MALIKM_PRIME_FD_BASE)) {
-      *handle = (uint32_t)prime_fd & ~MALIKM_PRIME_FD_BASE;
-      return 0;
+   int ret = -ENOSYS;
+   AcquireSRWLockExclusive(&wddm_lock);
+   bind_switch(bind_for_fd(fd));
+   if ((prime_fd & MALIKM_PRIME_FD_BASE) && PRIME_FD_B(prime_fd) == cur_bind && wddm_bo(PRIME_FD_H(prime_fd))) {
+      *handle = PRIME_FD_H(prime_fd);
+      ret = 0;
+   } else if (prime_fd & MALIKM_PRIME_FD_BASE) {
+      malikm_tlog("prime fd 0x%x: binding %d, this screen's %d - refused", prime_fd, PRIME_FD_B(prime_fd), cur_bind);
    }
-   errno = ENOSYS;
-   return -ENOSYS;
+   ReleaseSRWLockExclusive(&wddm_lock);
+   if (ret)
+      errno = ENOSYS;
+   return ret;
 }
 
 /* ---- syncobjs: return conventions as libdrm's ---- */
