+static struct ddi_state ddi;
 
 /* Allocations whose BO is closed but which a job submitted earlier may
  * still use. Linux's panfrost keeps a BO alive until its jobs are done,
@@ -1062,7 +1078,141 @@ wddm_idle(void)
  * Flags.Primary, so dxgkrnl ties them to the swap-chain resource; kept locked for CPU writes. */
 static int present_copy(D3DKMT_HANDLE h, const void *bgrx, unsigned w, unsigned hgt);   /* below (G13 0024) */
 #define MAX_KPRIM 16
-static struct { D3DKMT_HANDLE h; void *cpu; unsigned w, hgt, gpu; } kprim[MAX_KPRIM];   /* gpu: H4b, marked */
+struct kprim_entry { D3DKMT_HANDLE h; void *cpu; unsigned w, hgt, gpu; };   /* gpu: H4b, marked */
+static struct kprim_entry kprim[MAX_KPRIM];
+static uint32_t scanout_h;   /* H4b: the scan-out framebuffer's BO */
+
+/* exynos-woa H5 (0060, notes/gpu-hw-path.md): one binding per runtime device. The shim had ONE: every
+ * malikm_bind_d3dddi overwrote the device, context, command buffer and allocation list, and the BO table was the
+ * process's - a process with two D3D devices (Explorer) submitted one device's allocations on the other's context
+ * and dxgkrnl refused them (run h3r/h3s: Render 0xC0000001, 100+ times). The code below still works on the globals;
+ * they are the CURRENT binding's state, swapped under wddm_lock by bind_switch(): by fd for the DRM calls (each
+ * device has its own Panfrost screen and fd - os_same_file_description, 0060), by the device d3d10umd selected for
+ * this thread (malikm_select_device) for the API calls, by the pseudo fd for prime fds. */
+#define MAX_BINDINGS 16
+#define MAX_BIND_FDS 8
+struct binding {
+   int used;
+   HANDLE device;
+   int fds[MAX_BIND_FDS], nfds;
+   struct ddi_state ddi;
+   struct wbo *wbo;
+   uint32_t wbo_cap, wsubmit_gen;
+   void *wcmd;
+   UINT wcmd_size, walloc_size, wpatch_size;
+   D3DDDI_ALLOCATIONLIST *walloc;
+   D3DDDI_PATCHLOCATIONLIST *wpatch;
+   MW_ESCAPE_GPU_INFO_DATA wgpu;
+   uint64_t wseq;
+   D3DKMT_HANDLE *wdead;
+   uint32_t wdead_n, wdead_cap;
+   struct kprim_entry kprim[MAX_KPRIM];
+   uint32_t scanout_h;
+};
+static struct binding binds[MAX_BINDINGS];
+static int cur_bind = -1;                      /* whose state the globals hold */
+static __declspec(thread) int tls_pending = -1;  /* bound on this thread, its screen's fd not seen yet */
+static __declspec(thread) int tls_selected = -1; /* d3d10umd's device for this thread's API calls */
+
+static void
+bind_save(struct binding *b)
+{
+   b->ddi = ddi;
+   b->wbo = wbo; b->wbo_cap = wbo_cap; b->wsubmit_gen = wsubmit_gen;
+   b->wcmd = wcmd; b->wcmd_size = wcmd_size;
+   b->walloc = walloc; b->walloc_size = walloc_size;
+   b->wpatch = wpatch; b->wpatch_size = wpatch_size;
+   b->wgpu = wgpu; b->wseq = wseq;
+   b->wdead = wdead; b->wdead_n = wdead_n; b->wdead_cap = wdead_cap;
+   memcpy(b->kprim, kprim, sizeof(kprim));
+   b->scanout_h = scanout_h;
+}
+
+static void
+bind_load(const struct binding *b)
+{
+   ddi = b->ddi;
+   wbo = b->wbo; wbo_cap = b->wbo_cap; wsubmit_gen = b->wsubmit_gen;
+   wcmd = b->wcmd; wcmd_size = b->wcmd_size;
+   walloc = b->walloc; walloc_size = b->walloc_size;
+   wpatch = b->wpatch; wpatch_size = b->wpatch_size;
+   wgpu = b->wgpu; wseq = b->wseq;
+   wdead = b->wdead; wdead_n = b->wdead_n; wdead_cap = b->wdead_cap;
+   memcpy(kprim, b->kprim, sizeof(kprim));
+   scanout_h = b->scanout_h;
+}
+
+/* wddm_lock held. i < 0: keep the current binding. */
+static void
+bind_switch(int i)
+{
+   if (i < 0 || i >= MAX_BINDINGS || !binds[i].used || i == cur_bind)
+      return;
+   if (cur_bind >= 0)
+      bind_save(&binds[cur_bind]);
+   bind_load(&binds[i]);
+   cur_bind = i;
+}
+
+/* wddm_lock held. The binding a screen's fd belongs to; an fd not seen yet is the screen this thread's last
+ * malikm_bind_d3dddi created (Panfrost dups the fd it is given). -1 if neither. */
+static int
+bind_for_fd(int fd)
+{
+   for (int i = 0; i < MAX_BINDINGS; i++)
+      if (binds[i].used)
+         for (int k = 0; k < binds[i].nfds; k++)
+            if (binds[i].fds[k] == fd)
+               return i;
+   int p = tls_pending;
+   if (p >= 0 && binds[p].used && binds[p].nfds < MAX_BIND_FDS) {
+      binds[p].fds[binds[p].nfds++] = fd;
+      malikm_tlog("binding %d (device %p): fd %d", p, binds[p].device, fd);
+      return p;
+   }
+   return -1;
+}
+
+static int
+bind_for_device(HANDLE device)
+{
+   for (int i = 0; i < MAX_BINDINGS; i++)
+      if (binds[i].used && binds[i].device == device)
+         return i;
+   return -1;
+}
+
+/* d3d10umd: the runtime device the API calls of this thread are for (called at the top of its DDIs). */
+void
+malikm_select_device(void *hRTDevice)
+{
+   AcquireSRWLockExclusive(&wddm_lock);
+   tls_selected = bind_for_device(hRTDevice);
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+/* d3d10umd DestroyDevice: the runtime frees the device's allocations and context with it. The binding's tables
+ * are dropped (nothing is destroyed through the callbacks any more). */
+void
+malikm_unbind_device(void *hRTDevice)
+{
+   AcquireSRWLockExclusive(&wddm_lock);
+   int i = bind_for_device(hRTDevice);
+   if (i >= 0) {
+      bind_switch(i);
+      free(wbo);
+      free(wdead);
+      struct binding empty;
+      memset(&empty, 0, sizeof(empty));
+      bind_load(&empty);   /* the globals: nothing bound */
+      memset(&binds[i], 0, sizeof(binds[i]));
+      cur_bind = -1;
+      malikm_tlog("binding %d (device %p) dropped", i, hRTDevice);
+   }
+   if (tls_selected == i)
+      tls_selected = -1;
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
 
