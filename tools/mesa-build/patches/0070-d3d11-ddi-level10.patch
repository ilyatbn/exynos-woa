From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Fri, 16 Oct 2026 21:20:25 +0300
Subject: [PATCH] d3d10umd: D3D11_0 DDI interface at 3D pipeline level 10_0 -
 wrappers for the 10 changed entries, generated stubs, D3D11 GetCaps;
 D3D10UMD_NO_D3D11 hides it (exynos-woa 0070)

---
 src/gallium/frontends/d3d10umd/Adapter.cpp    |  29 +-
 src/gallium/frontends/d3d10umd/D3D11.cpp      | 244 +++++++++++++++
 src/gallium/frontends/d3d10umd/D3D11.h        |   9 +
 src/gallium/frontends/d3d10umd/Device.cpp     |  34 +-
 src/gallium/frontends/d3d10umd/d3d11_fill.inc | 151 +++++++++
 .../frontends/d3d10umd/d3d11_stubs.inc        | 290 ++++++++++++++++++
 src/gallium/frontends/d3d10umd/meson.build    |   1 +
 7 files changed, 752 insertions(+), 6 deletions(-)
 create mode 100644 src/gallium/frontends/d3d10umd/D3D11.cpp
 create mode 100644 src/gallium/frontends/d3d10umd/D3D11.h
 create mode 100644 src/gallium/frontends/d3d10umd/d3d11_fill.inc
 create mode 100644 src/gallium/frontends/d3d10umd/d3d11_stubs.inc

diff --git a/src/gallium/frontends/d3d10umd/Adapter.cpp b/src/gallium/frontends/d3d10umd/Adapter.cpp
index 404ee94..be28d99 100644
--- a/src/gallium/frontends/d3d10umd/Adapter.cpp
+++ b/src/gallium/frontends/d3d10umd/Adapter.cpp
@@ -36,6 +36,8 @@
 #include "State.h"
 
 #include "Debug.h"
+#include "D3D11.h"
+extern "C" void malikm_tlog(const char *fmt, ...);   /* exynos-woa: malikm_drm.c */
 
 #include "util/u_memory.h"
 
@@ -137,6 +139,12 @@ OpenAdapter10(__inout D3D10DDIARG_OPENADAPTER *pOpenData)   // IN
    case D3D11_0_7_DDI_INTERFACE_VERSION:
 #endif
       break;
+   /* exynos-woa D1: the D3D11 interface unless D3D10UMD_NO_D3D11 is set (State.h SUPPORT_D3D11 stays 0). */
+   case D3D11_0_DDI_INTERFACE_VERSION:
+   case D3D11_0_7_DDI_INTERFACE_VERSION:
+      if (D3D11Enabled())
+         break;
+      return E_FAIL;
    default:
       if (0) {
          DebugPrintf("%s: unsupported interface version 0x%08x\n",
@@ -184,17 +192,20 @@ GetSupportedVersions(D3D10DDI_HADAPTER hAdapter,
 {
    LOG_ENTRYPOINT();
 
-   if (pSupportedDDIInterfaceVersions &&
-       *puEntries < ARRAYSIZE(SupportedDDIInterfaceVersions)) {
-      return E_OUTOFMEMORY;
-   }
+   /* exynos-woa D1: D3D11_0 (pipeline level 10_0, D3D11.cpp) after the D3D10 versions, unless D3D10UMD_NO_D3D11. */
+   static const UINT64 d3d11[] = { D3D11_0_DDI_SUPPORTED, D3D11_0_7_DDI_SUPPORTED };
+   UINT32 n = ARRAYSIZE(SupportedDDIInterfaceVersions) + (D3D11Enabled() ? ARRAYSIZE(d3d11) : 0);
 
-   *puEntries = ARRAYSIZE(SupportedDDIInterfaceVersions);
+   if (pSupportedDDIInterfaceVersions && *puEntries < n)
+      return E_OUTOFMEMORY;
+   *puEntries = n;
 
    if (pSupportedDDIInterfaceVersions) {
       memcpy(pSupportedDDIInterfaceVersions,
              SupportedDDIInterfaceVersions,
              sizeof SupportedDDIInterfaceVersions);
+      if (n > ARRAYSIZE(SupportedDDIInterfaceVersions))
+         memcpy(pSupportedDDIInterfaceVersions + ARRAYSIZE(SupportedDDIInterfaceVersions), d3d11, sizeof d3d11);
    }
 
    return S_OK;
@@ -216,6 +227,14 @@ GetCaps(D3D10DDI_HADAPTER hAdapter,
         const D3D10_2DDIARG_GETCAPS *pData)
 {
    LOG_ENTRYPOINT();
+   HRESULT hr;
+   {
+      static unsigned n;
+      if (n++ < 64)
+         malikm_tlog("GetCaps type %d size %u", (int)pData->Type, (unsigned)pData->DataSize);
+   }
+   if (D3D11GetCaps(pData, &hr))   /* exynos-woa D1 */
+      return hr;
    memset(pData->pData, 0, pData->DataSize);
    return S_OK;
 }
diff --git a/src/gallium/frontends/d3d10umd/D3D11.cpp b/src/gallium/frontends/d3d10umd/D3D11.cpp
new file mode 100644
index 0000000..f8cc472
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/D3D11.cpp
@@ -0,0 +1,244 @@
+/**************************************************************************
+ *
+ * exynos-woa D1 (notes/gpu-umd-d3d11.md): the D3D11 DDI (D3D11_0 interface) on top of the D3D10.1 implementation,
+ * at 3D pipeline level 10_0. Members whose PFN type is unchanged since D3D10.1 keep d3d10umd's functions; the ten
+ * whose argument structs changed get the D11_* wrappers below; the rest (indirect draws, hull/domain/compute stages,
+ * UAVs, deferred contexts) are stubs - at pipeline level 10_0 the runtime does not call them (and it emulates
+ * deferred contexts itself when D3D11DDICAPS_THREADING reports no command lists). The stubs and the table fill are
+ * generated by exynos-woa tools/mesa-build/gen-d3d11-ddi.py from the WDK header.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated
+ * documentation files (the "Software"), to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sub license, and/or sell copies of the Software, and
+ * to permit persons to whom the Software is furnished to do so, subject to the following conditions:
+ * The above copyright notice and this permission notice (including the next paragraph) shall be included in all
+ * copies or substantial portions of the Software.
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED.
+ *
+ **************************************************************************/
+
+#include "Draw.h"
+#include "DxgiFns.h"
+#include "InputAssembly.h"
+#include "OutputMerger.h"
+#include "Query.h"
+#include "Rasterizer.h"
+#include "Resource.h"
+#include "Shader.h"
+#include "State.h"
+#include "Format.h"
+#include "Debug.h"
+
+#include "D3D11.h"
+
+#include <string.h>
+#include <stdlib.h>
+
+
+/* ---- the ten wrappers (argument structs that changed since D3D10.1) ---- */
+
+static void APIENTRY
+D11_SetRenderTargets(D3D10DDI_HDEVICE hDevice, const D3D10DDI_HRENDERTARGETVIEW *phRTV, UINT NumRTVs,
+                     UINT ClearSlots, D3D10DDI_HDEPTHSTENCILVIEW hDSV,
+                     const D3D11DDI_HUNORDEREDACCESSVIEW *phUAV, const UINT *pUAVInitialCounts, UINT UAVStartSlot,
+                     UINT NumUAVs, UINT UAVRangeStart, UINT UAVRangeSize)
+{
+   /* UAVs bound with the render targets exist only at pipeline level 11_0; at 10_0 the runtime passes none. */
+   (void)phUAV; (void)pUAVInitialCounts; (void)UAVStartSlot; (void)NumUAVs; (void)UAVRangeStart; (void)UAVRangeSize;
+   SetRenderTargets(hDevice, phRTV, NumRTVs, ClearSlots, hDSV);
+}
+
+static void APIENTRY
+D11_RelocateDeviceFuncs(D3D10DDI_HDEVICE hDevice, struct D3D11DDI_DEVICEFUNCS *pDeviceFunctions)
+{
+   /* As RelocateDeviceFuncs: no pointer to the table is kept. */
+   (void)hDevice; (void)pDeviceFunctions;
+}
+
+/* D3D11DDIARG_CREATERESOURCE begins with exactly the D3D10DDIARG_CREATERESOURCE members (WDK d3d10umddi.h); the
+ * added ByteStride/DecoderBufferType/TextureLayout matter only for structured buffers, decoder buffers and
+ * swizzled layouts, none of which pipeline level 10_0 creates. */
+static SIZE_T APIENTRY
+D11_CalcPrivateResourceSize(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATERESOURCE *pCreate)
+{
+   return CalcPrivateResourceSize(hDevice, (const D3D10DDIARG_CREATERESOURCE *)pCreate);
+}
+
+static void APIENTRY
+D11_CreateResource(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATERESOURCE *pCreate,
+                   D3D10DDI_HRESOURCE hResource, D3D10DDI_HRTRESOURCE hRTResource)
+{
+   CreateResource(hDevice, (const D3D10DDIARG_CREATERESOURCE *)pCreate, hResource, hRTResource);
+}
+
+/* D3D11DDIARG_CREATESHADERRESOURCEVIEW = the D3D10.1 struct plus the BufferEx (raw/structured buffer) union member;
+ * a BufferEx view is mapped onto a plain buffer view of the same element range. */
+static void
+d11_srv_to_101(const D3D11DDIARG_CREATESHADERRESOURCEVIEW *in, D3D10_1DDIARG_CREATESHADERRESOURCEVIEW *out)
+{
+   memset(out, 0, sizeof *out);
+   out->hDrvResource = in->hDrvResource;
+   out->Format = in->Format;
+   out->ResourceDimension = in->ResourceDimension;
+   if (in->ResourceDimension == D3D11DDIRESOURCE_BUFFEREX) {
+      out->ResourceDimension = D3D10DDIRESOURCE_BUFFER;
+      out->Buffer.FirstElement = in->BufferEx.FirstElement;
+      out->Buffer.NumElements = in->BufferEx.NumElements;
+   } else {
+      memcpy(&out->TexCube, &in->TexCube,
+             sizeof *out - offsetof(D3D10_1DDIARG_CREATESHADERRESOURCEVIEW, TexCube));
+   }
+}
+
+static SIZE_T APIENTRY
+D11_CalcPrivateShaderResourceViewSize(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pCreate)
+{
+   D3D10_1DDIARG_CREATESHADERRESOURCEVIEW v;
+   d11_srv_to_101(pCreate, &v);
+   return CalcPrivateShaderResourceViewSize1(hDevice, &v);
+}
+
+static void APIENTRY
+D11_CreateShaderResourceView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pCreate,
+                             D3D10DDI_HSHADERRESOURCEVIEW hView, D3D10DDI_HRTSHADERRESOURCEVIEW hRTView)
+{
+   D3D10_1DDIARG_CREATESHADERRESOURCEVIEW v;
+   d11_srv_to_101(pCreate, &v);
+   CreateShaderResourceView1(hDevice, &v, hView, hRTView);
+}
+
+/* D3D11DDIARG_CREATEDEPTHSTENCILVIEW adds Flags (read-only depth/stencil) before the union. Read-only views are
+ * a pipeline level 11_0 feature; the flag is dropped. */
+static void
+d11_dsv_to_10(const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *in, D3D10DDIARG_CREATEDEPTHSTENCILVIEW *out)
+{
+   memset(out, 0, sizeof *out);
+   out->hDrvResource = in->hDrvResource;
+   out->Format = in->Format;
+   out->ResourceDimension = in->ResourceDimension;
+   switch (in->ResourceDimension) {
+   case D3D10DDIRESOURCE_TEXTURE1D: out->Tex1D = in->Tex1D; break;
+   case D3D10DDIRESOURCE_TEXTURE2D: out->Tex2D = in->Tex2D; break;
+   case D3D10DDIRESOURCE_TEXTURECUBE: out->TexCube = in->TexCube; break;
+   default: break;
+   }
+}
+
+static SIZE_T APIENTRY
+D11_CalcPrivateDepthStencilViewSize(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *pCreate)
+{
+   D3D10DDIARG_CREATEDEPTHSTENCILVIEW v;
+   d11_dsv_to_10(pCreate, &v);
+   return CalcPrivateDepthStencilViewSize(hDevice, &v);
+}
+
+static void APIENTRY
+D11_CreateDepthStencilView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *pCreate,
+                           D3D10DDI_HDEPTHSTENCILVIEW hView, D3D10DDI_HRTDEPTHSTENCILVIEW hRTView)
+{
+   D3D10DDIARG_CREATEDEPTHSTENCILVIEW v;
+   d11_dsv_to_10(pCreate, &v);
+   CreateDepthStencilView(hDevice, &v, hView, hRTView);
+}
+
+/* Stream output: D3D11 entries carry a Stream index and per-buffer strides; D3D10 has stream 0 and one stride.
+ * Entries of other streams are dropped (multiple streams need pipeline level 11_0). */
+#define D11_MAX_SO_ENTRIES 128
+
+static UINT
+d11_so_to_10(const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *in,
+             D3D10DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *out, D3D10DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY *e)
+{
+   UINT n = 0;
+   for (UINT i = 0; i < in->NumEntries && n < D11_MAX_SO_ENTRIES; i++) {
+      if (in->pOutputStreamDecl[i].Stream != 0)
+         continue;
+      e[n].OutputSlot = in->pOutputStreamDecl[i].OutputSlot;
+      e[n].RegisterIndex = in->pOutputStreamDecl[i].RegisterIndex;
+      e[n].RegisterMask = in->pOutputStreamDecl[i].RegisterMask;
+      n++;
+   }
+   out->pShaderCode = in->pShaderCode;
+   out->pOutputStreamDecl = e;
+   out->NumEntries = n;
+   out->StreamOutputStrideInBytes = (in->NumStrides && in->BufferStridesInBytes) ? in->BufferStridesInBytes[0] : 0;
+   return n;
+}
+
+static SIZE_T APIENTRY
+D11_CalcPrivateGeometryShaderWithStreamOutput(D3D10DDI_HDEVICE hDevice,
+                                              const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *pCreate,
+                                              const D3D10DDIARG_STAGE_IO_SIGNATURES *pSignatures)
+{
+   D3D10DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT g;
+   D3D10DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY e[D11_MAX_SO_ENTRIES];
+   d11_so_to_10(pCreate, &g, e);
+   return CalcPrivateGeometryShaderWithStreamOutput(hDevice, &g, pSignatures);
+}
+
+static void APIENTRY
+D11_CreateGeometryShaderWithStreamOutput(D3D10DDI_HDEVICE hDevice,
+                                         const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *pCreate,
+                                         D3D10DDI_HSHADER hShader, D3D10DDI_HRTSHADER hRTShader,
+                                         const D3D10DDIARG_STAGE_IO_SIGNATURES *pSignatures)
+{
+   D3D10DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT g;
+   D3D10DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY e[D11_MAX_SO_ENTRIES];
+   d11_so_to_10(pCreate, &g, e);
+   CreateGeometryShaderWithStreamOutput(hDevice, &g, hShader, hRTShader, pSignatures);
+}
+
+/* ---- generated stubs ---- */
+
+#include "d3d11_stubs.inc"
+
+/* ---- the table ---- */
+
+void
+D3D11FillDeviceFuncs(D3D11DDI_DEVICEFUNCS *f)
+{
+#include "d3d11_fill.inc"
+}
+
+/* GetCaps answers for the D3D11 types (Adapter.cpp GetCaps); FALSE = not a D3D11 type. */
+BOOL
+D3D11GetCaps(const D3D10_2DDIARG_GETCAPS *pData, HRESULT *phr)
+{
+   *phr = S_OK;
+   switch ((int)pData->Type) {
+   case D3D11DDICAPS_THREADING:
+      /* No driver command lists, no concurrent creates: the runtime emulates deferred contexts. */
+      if (pData->DataSize < sizeof(D3D11DDI_THREADING_CAPS)) { *phr = E_INVALIDARG; return TRUE; }
+      memset(pData->pData, 0, pData->DataSize);
+      return TRUE;
+   case D3D11DDICAPS_SHADER:
+      if (pData->DataSize < sizeof(D3D11DDI_SHADER_CAPS)) { *phr = E_INVALIDARG; return TRUE; }
+      memset(pData->pData, 0, pData->DataSize);   /* no doubles */
+      return TRUE;
+   case D3D11DDICAPS_3DPIPELINESUPPORT: {
+      if (pData->DataSize < sizeof(D3D11DDI_3DPIPELINESUPPORT_CAPS)) { *phr = E_INVALIDARG; return TRUE; }
+      D3D11DDI_3DPIPELINESUPPORT_CAPS *c = (D3D11DDI_3DPIPELINESUPPORT_CAPS *)pData->pData;
+      memset(c, 0, pData->DataSize);
+      c->Caps = D3D11DDI_ENCODE_3DPIPELINESUPPORT_CAP(D3D11DDI_3DPIPELINELEVEL_10_0);
+      return TRUE;
+   }
+   default:
+      return FALSE;
+   }
+}
+
+/* DXGI 1.1 (D3D11_0 interface): our resources are linear and the KMD shares them as they are; nothing to resolve. */
+HRESULT APIENTRY
+D3D11ResolveSharedResource(DXGI_DDI_ARG_RESOLVESHAREDRESOURCE *pArgs)
+{
+   (void)pArgs;
+   return S_OK;
+}
+
+/* D3D10UMD_NO_D3D11=1 (environment) hides the D3D11 interfaces again: A/B without a rebuild. */
+BOOL
+D3D11Enabled(void)
+{
+   const char *e = getenv("D3D10UMD_NO_D3D11");
+   return !(e && *e && *e != '0');
+}
diff --git a/src/gallium/frontends/d3d10umd/D3D11.h b/src/gallium/frontends/d3d10umd/D3D11.h
new file mode 100644
index 0000000..c88e0e1
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/D3D11.h
@@ -0,0 +1,9 @@
+/* exynos-woa D1 (notes/gpu-umd-d3d11.md): D3D11 DDI glue for d3d10umd (D3D11.cpp). */
+#pragma once
+
+#include "DriverIncludes.h"
+
+void D3D11FillDeviceFuncs(D3D11DDI_DEVICEFUNCS *pFuncs);
+BOOL D3D11GetCaps(const D3D10_2DDIARG_GETCAPS *pData, HRESULT *phr);
+HRESULT APIENTRY D3D11ResolveSharedResource(DXGI_DDI_ARG_RESOLVESHAREDRESOURCE *pArgs);
+BOOL D3D11Enabled(void);
diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index 522be27..070215f 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -43,6 +43,8 @@
 #include "Format.h"
 
 #include "Debug.h"
+#include "D3D11.h"
+extern "C" void malikm_tlog(const char *fmt, ...);   /* exynos-woa: malikm_drm.c */
 
 #include "util/u_sampler.h"
 #include "util/u_framebuffer.h"
@@ -127,6 +129,11 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    case D3D10_1_7_DDI_INTERFACE_VERSION:
 #endif
       break;
+   case D3D11_0_DDI_INTERFACE_VERSION:      /* exynos-woa D1 (D3D11.cpp) */
+   case D3D11_0_7_DDI_INTERFACE_VERSION:
+      if (D3D11Enabled())
+         break;
+      return E_FAIL;
    default:
       DebugPrintf("%s: unsupported interface version 0x%08x\n",
                   __func__, pCreateData->Interface);
@@ -175,10 +182,32 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
 
    st_debug_parse();
 
+   /*
+    * exynos-woa D1: a D3D11 interface gets the whole D3D11DDI_DEVICEFUNCS table from D3D11.cpp (the tables' member
+    * orders differ, so the D3D10 fill below must not run on it).
+    */
+   const BOOL is11 = pCreateData->Interface == D3D11_0_DDI_INTERFACE_VERSION ||
+                     pCreateData->Interface == D3D11_0_7_DDI_INTERFACE_VERSION;
+   {
+      malikm_tlog("CreateDevice interface 0x%08x version 0x%08x", (unsigned)pCreateData->Interface,
+                  (unsigned)pCreateData->Version);
+   }
+   if (is11) {
+      D3D11DDI_DEVICEFUNCS *f11 = pCreateData->p11DeviceFuncs;
+      D3D11FillDeviceFuncs(f11);
+      /* static here, so not in the generated fill */
+      f11->pfnDestroyDevice = DestroyDevice;
+      f11->pfnFlush = Flush;
+      f11->pfnCheckFormatSupport = CheckFormatSupport;
+      f11->pfnCheckMultisampleQualityLevels = CheckMultisampleQualityLevels;
+      f11->pfnSetTextFilterSize = SetTextFilterSize;
+   }
+
    /*
     * Fill in the D3D10 DDI functions
     */
-   D3D10DDI_DEVICEFUNCS *pDeviceFuncs = pCreateData->pDeviceFuncs;
+   D3D10DDI_DEVICEFUNCS *pDeviceFuncs = is11 ? NULL : pCreateData->pDeviceFuncs;
+   if (!is11) {
    pDeviceFuncs->pfnDefaultConstantBufferUpdateSubresourceUP = ResourceUpdateSubResourceUP;
    pDeviceFuncs->pfnVsSetConstantBuffers = VsSetConstantBuffers;
    pDeviceFuncs->pfnPsSetShaderResources = PsSetShaderResources;
@@ -292,6 +321,7 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
       p10_1DeviceFuncs->pfnResourceConvert = ResourceCopy;
       p10_1DeviceFuncs->pfnResourceConvertRegion = ResourceCopyRegion;
    }
+   }   /* !is11 */
 
    /*
     * Fill in DXGI DDI functions
@@ -310,6 +340,8 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
       _RotateResourceIdentities;
    pCreateData->DXGIBaseDDI.pDXGIDDIBaseFunctions->pfnBlt =
       _Blt;
+   if (is11)   /* the D3D11_0 interface comes with the DXGI 1.1 DDI */
+      pCreateData->DXGIBaseDDI.pDXGIDDIBaseFunctions2->pfnResolveSharedResource = D3D11ResolveSharedResource;
 
    if (0) {
       return S_OK;
diff --git a/src/gallium/frontends/d3d10umd/d3d11_fill.inc b/src/gallium/frontends/d3d10umd/d3d11_fill.inc
new file mode 100644
index 0000000..c16085c
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/d3d11_fill.inc
@@ -0,0 +1,151 @@
+/* Generated by exynos-woa tools/mesa-build/gen-d3d11-ddi.py - do not edit. Wrappers needed: pfnSetRenderTargets, pfnRelocateDeviceFuncs, pfnCalcPrivateResourceSize, pfnCreateResource, pfnCalcPrivateShaderResourceViewSize, pfnCreateShaderResourceView, pfnCalcPrivateDepthStencilViewSize, pfnCreateDepthStencilView, pfnCalcPrivateGeometryShaderWithStreamOutput, pfnCreateGeometryShaderWithStreamOutput */
+   f->pfnDefaultConstantBufferUpdateSubresourceUP = ResourceUpdateSubResourceUP;
+   f->pfnVsSetConstantBuffers = VsSetConstantBuffers;
+   f->pfnPsSetShaderResources = PsSetShaderResources;
+   f->pfnPsSetShader = PsSetShader;
+   f->pfnPsSetSamplers = PsSetSamplers;
+   f->pfnVsSetShader = VsSetShader;
+   f->pfnDrawIndexed = DrawIndexed;
+   f->pfnDraw = Draw;
+   f->pfnDynamicIABufferMapNoOverwrite = ResourceMap;
+   f->pfnDynamicIABufferUnmap = ResourceUnmap;
+   f->pfnDynamicConstantBufferMapDiscard = ResourceMap;
+   f->pfnDynamicIABufferMapDiscard = ResourceMap;
+   f->pfnDynamicConstantBufferUnmap = ResourceUnmap;
+   f->pfnPsSetConstantBuffers = PsSetConstantBuffers;
+   f->pfnIaSetInputLayout = IaSetInputLayout;
+   f->pfnIaSetVertexBuffers = IaSetVertexBuffers;
+   f->pfnIaSetIndexBuffer = IaSetIndexBuffer;
+   f->pfnDrawIndexedInstanced = DrawIndexedInstanced;
+   f->pfnDrawInstanced = DrawInstanced;
+   f->pfnDynamicResourceMapDiscard = ResourceMap;
+   f->pfnDynamicResourceUnmap = ResourceUnmap;
+   f->pfnGsSetConstantBuffers = GsSetConstantBuffers;
+   f->pfnGsSetShader = GsSetShader;
+   f->pfnIaSetTopology = IaSetTopology;
+   f->pfnStagingResourceMap = ResourceMap;
+   f->pfnStagingResourceUnmap = ResourceUnmap;
+   f->pfnVsSetShaderResources = VsSetShaderResources;
+   f->pfnVsSetSamplers = VsSetSamplers;
