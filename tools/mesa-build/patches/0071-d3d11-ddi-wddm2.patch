+
+/* ---- D3D11.1: constant buffers with offsets ---- */
+
+/* D3D11.1 constant buffer offsets: FirstConstant/NumConstants count 16-byte constants. With the arrays NULL (the
+ * runtime passes NULL while D3D11_OPTIONS reports no ConstantBufferOffsetting) the whole buffer is bound, as the
+ * D3D10 path does. */
+static void
+SetConstantBuffers11(mesa_shader_stage stage, D3D10DDI_HDEVICE hDevice, UINT Start, UINT Num,
+                     const D3D10DDI_HRESOURCE *ph, const UINT *pFirst, const UINT *pNum)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   for (UINT i = 0; i < Num; i++) {
+      struct pipe_constant_buffer cb;
+      memset(&cb, 0, sizeof cb);
+      cb.buffer = CastPipeResource(ph[i]);
+      if (cb.buffer) {
+         unsigned w = cb.buffer->width0;
+         unsigned off = pFirst ? pFirst[i] * 16u : 0;
+         unsigned size = pNum ? pNum[i] * 16u : w;
+         if (off > w)
+            off = w;
+         if (size > w - off)
+            size = w - off;
+         cb.buffer_offset = off;
+         cb.buffer_size = size;
+      }
+      pipe->set_constant_buffer(pipe, stage, Start + i, &cb);
+   }
+}
+
+#define D111_SETCB(Name, Stage)                                                                                   \
+   static void APIENTRY D111_##Name(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumBuffers,                    \
+                                    const D3D10DDI_HRESOURCE *ph, const UINT *pFirst, const UINT *pNum)           \
+   {                                                                                                              \
+      SetConstantBuffers11(Stage, hDevice, StartSlot, NumBuffers, ph, pFirst, pNum);                              \
+   }
+D111_SETCB(VsSetConstantBuffers, MESA_SHADER_VERTEX)
+D111_SETCB(PsSetConstantBuffers, MESA_SHADER_FRAGMENT)
+D111_SETCB(GsSetConstantBuffers, MESA_SHADER_GEOMETRY)
+/* Hull/domain/compute exist only at pipeline level 11_0; nothing binds them at 10_0. */
+static void APIENTRY
+D111_HsSetConstantBuffers(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HRESOURCE *, const UINT *, const UINT *) {}
+static void APIENTRY
+D111_DsSetConstantBuffers(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HRESOURCE *, const UINT *, const UINT *) {}
+static void APIENTRY
+D111_CsSetConstantBuffers(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HRESOURCE *, const UINT *, const UINT *) {}
+
+/* ---- D3D11.1: copies and updates with CopyFlags (D3D11_1_DDI_COPY_NO_OVERWRITE / DISCARD are hints) ---- */
+
+static void APIENTRY
+D111_ResourceUpdateSubresourceUP(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDst, UINT DstSub,
+                                 const D3D10_DDI_BOX *pBox, const VOID *pSys, UINT RowPitch, UINT DepthPitch,
+                                 UINT CopyFlags)
+{
+   (void)CopyFlags;
+   ResourceUpdateSubResourceUP(hDevice, hDst, DstSub, pBox, pSys, RowPitch, DepthPitch);
+}
+
+static void APIENTRY
+D111_DefaultConstantBufferUpdateSubresourceUP(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDst, UINT DstSub,
+                                              const D3D10_DDI_BOX *pBox, const VOID *pSys, UINT RowPitch,
+                                              UINT DepthPitch, UINT CopyFlags)
+{
+   (void)CopyFlags;
+   ResourceUpdateSubResourceUP(hDevice, hDst, DstSub, pBox, pSys, RowPitch, DepthPitch);
+}
+
+static void APIENTRY
+D111_ResourceCopyRegion(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDst, UINT DstSub, UINT DstX, UINT DstY,
+                        UINT DstZ, D3D10DDI_HRESOURCE hSrc, UINT SrcSub, const D3D10_DDI_BOX *pSrcBox,
+                        UINT CopyFlags)
+{
+   (void)CopyFlags;
+   ResourceCopyRegion(hDevice, hDst, DstSub, DstX, DstY, DstZ, hSrc, SrcSub, pSrcBox);
+}
+
+static void APIENTRY
+D111_ResourceConvertRegion(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDst, UINT DstSub, UINT DstX, UINT DstY,
+                           UINT DstZ, D3D10DDI_HRESOURCE hSrc, UINT SrcSub, const D3D10_DDI_BOX *pSrcBox,
+                           UINT CopyFlags)
+{
+   (void)CopyFlags;
+   ResourceCopyRegion(hDevice, hDst, DstSub, DstX, DstY, DstZ, hSrc, SrcSub, pSrcBox);
+}
+
+/* ---- Flush (D3D11.1 / WDDM 2.0 flavours) and the other Device.cpp statics ---- */
+
+static BOOL APIENTRY
+D111_Flush(D3D10DDI_HDEVICE hDevice, UINT FlushFlags)
+{
+   (void)FlushFlags;
+   DeviceFlush(hDevice);
+   return TRUE;   /* "TRUE if the driver submitted work" - always flushing is valid */
+}
+
+static BOOL APIENTRY
+D120_Flush(D3D10DDI_HDEVICE hDevice, UINT ContextType, UINT FlushFlags)
+{
+   (void)ContextType; (void)FlushFlags;
+   DeviceFlush(hDevice);
+   return TRUE;
+}
+
+static void APIENTRY
+D113_CheckMultisampleQualityLevels(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT SampleCount, UINT Flags,
+                                   UINT *pNumQualityLevels)
+{
+   if (Flags) {   /* D3D11_CHECK_MULTISAMPLE_QUALITY_LEVELS_TILED_RESOURCE: no tiled resources */
+      *pNumQualityLevels = 0;
+      return;
+   }
+   DeviceCheckMultisampleQualityLevels(hDevice, Format, SampleCount, pNumQualityLevels);
+}
