+}
+SIZE_T D3D11CalcPrivateShaderResourceViewSize(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *p)
+{
+   return D11_CalcPrivateShaderResourceViewSize(hDevice, p);
+}
+void D3D11CreateShaderResourceView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *p,
+                                   D3D10DDI_HSHADERRESOURCEVIEW h, D3D10DDI_HRTSHADERRESOURCEVIEW hRT)
+{
+   D11_CreateShaderResourceView(hDevice, p, h, hRT);
+}
+
+/* D3D10UMD_MAX_DDI = 10 / 11.0 / 11.1 / 1.3 / 2.0 (default 2.0): the highest D3D11 DDI level offered, for A/B and
+ * rollback without a rebuild. D3D10UMD_NO_D3D11 = 1 is the same as 10. */
+UINT
+D3D11MaxLevel(void)
+{
+   if (!D3D11Enabled())
+      return 0;
+   const char *e = getenv("D3D10UMD_MAX_DDI");
+   if (!e || !*e)
+      return 120;
+   if (!strcmp(e, "10")) return 0;
+   if (!strcmp(e, "11.0")) return 110;
+   if (!strcmp(e, "11.1")) return 111;
+   if (!strcmp(e, "1.3")) return 113;
+   return 120;
+}
+
+/* ---- D2/D3: the higher DDI tiers (same translation unit) ---- */
+#include "D3D11Tiers.inc"
