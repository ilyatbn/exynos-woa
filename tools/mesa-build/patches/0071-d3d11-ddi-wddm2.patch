+/* ---- DXGI 1.2 - 1.4 ---- */
+
+static HRESULT APIENTRY
+Dxgi_Blt1(DXGI_DDI_ARG_BLT1 *p)
+{
+   /* Our _Blt copies the whole source; a source sub-rectangle is not used by the present paths we see. */
+   DXGI_DDI_ARG_BLT b;
+   memset(&b, 0, sizeof b);
+   b.hDevice = p->hDevice;
+   b.hDstResource = p->hDstResource;
+   b.DstSubresource = p->DstSubresource;
+   b.DstLeft = p->DstLeft; b.DstTop = p->DstTop; b.DstRight = p->DstRight; b.DstBottom = p->DstBottom;
+   b.hSrcResource = p->hSrcResource;
+   b.SrcSubresource = p->SrcSubresource;
+   b.Flags = p->Flags;
+   b.Rotate = p->Rotate;
+   return _Blt(&b);
+}
+
+/* Offer/reclaim: everything lives in the one aperture segment (system memory); nothing to give back, nothing lost. */
+static HRESULT APIENTRY Dxgi_OfferResources(DXGI_DDI_ARG_OFFERRESOURCES *) { return S_OK; }
+static HRESULT APIENTRY
+Dxgi_ReclaimResources(DXGI_DDI_ARG_RECLAIMRESOURCES *p)
+{
+   if (p->pDiscarded)
+      for (UINT i = 0; i < p->Resources; i++)
+         p->pDiscarded[i] = FALSE;
+   return S_OK;
+}
