diff --git a/src/gallium/frontends/d3d10umd/Adapter.cpp b/src/gallium/frontends/d3d10umd/Adapter.cpp
index be28d99..3345c75 100644
--- a/src/gallium/frontends/d3d10umd/Adapter.cpp
+++ b/src/gallium/frontends/d3d10umd/Adapter.cpp
@@ -142,7 +142,19 @@ OpenAdapter10(__inout D3D10DDIARG_OPENADAPTER *pOpenData)   // IN
    /* exynos-woa D1: the D3D11 interface unless D3D10UMD_NO_D3D11 is set (State.h SUPPORT_D3D11 stays 0). */
    case D3D11_0_DDI_INTERFACE_VERSION:
    case D3D11_0_7_DDI_INTERFACE_VERSION:
-      if (D3D11Enabled())
+      if (D3D11MaxLevel() >= 110)
+         break;
+      return E_FAIL;
+   case D3D11_1_DDI_INTERFACE_VERSION:
+      if (D3D11MaxLevel() >= 111)
+         break;
+      return E_FAIL;
+   case D3DWDDM1_3_DDI_INTERFACE_VERSION:
+      if (D3D11MaxLevel() >= 113)
+         break;
+      return E_FAIL;
+   case D3DWDDM2_0_DDI_INTERFACE_VERSION:
+      if (D3D11MaxLevel() >= 120)
          break;
       return E_FAIL;
    default:
@@ -193,8 +205,11 @@ GetSupportedVersions(D3D10DDI_HADAPTER hAdapter,
    LOG_ENTRYPOINT();
 
    /* exynos-woa D1: D3D11_0 (pipeline level 10_0, D3D11.cpp) after the D3D10 versions, unless D3D10UMD_NO_D3D11. */
-   static const UINT64 d3d11[] = { D3D11_0_DDI_SUPPORTED, D3D11_0_7_DDI_SUPPORTED };
-   UINT32 n = ARRAYSIZE(SupportedDDIInterfaceVersions) + (D3D11Enabled() ? ARRAYSIZE(d3d11) : 0);
+   static const UINT64 d3d11[] = { D3D11_0_DDI_SUPPORTED, D3D11_0_7_DDI_SUPPORTED, D3D11_1_DDI_SUPPORTED,
+                                   D3DWDDM1_3_DDI_SUPPORTED, D3DWDDM2_0_DDI_SUPPORTED };
+   const UINT lv = D3D11MaxLevel();
+   const UINT n11 = lv >= 120 ? 5 : lv >= 113 ? 4 : lv >= 111 ? 3 : lv >= 110 ? 2 : 0;
+   UINT32 n = ARRAYSIZE(SupportedDDIInterfaceVersions) + n11;
 
    if (pSupportedDDIInterfaceVersions && *puEntries < n)
       return E_OUTOFMEMORY;
@@ -205,7 +220,8 @@ GetSupportedVersions(D3D10DDI_HADAPTER hAdapter,
              SupportedDDIInterfaceVersions,
              sizeof SupportedDDIInterfaceVersions);
       if (n > ARRAYSIZE(SupportedDDIInterfaceVersions))
-         memcpy(pSupportedDDIInterfaceVersions + ARRAYSIZE(SupportedDDIInterfaceVersions), d3d11, sizeof d3d11);
+         memcpy(pSupportedDDIInterfaceVersions + ARRAYSIZE(SupportedDDIInterfaceVersions), d3d11,
+                n11 * sizeof d3d11[0]);
    }
 
    return S_OK;
diff --git a/src/gallium/frontends/d3d10umd/D3D11.cpp b/src/gallium/frontends/d3d10umd/D3D11.cpp
index f8cc472..4e9348a 100644
--- a/src/gallium/frontends/d3d10umd/D3D11.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D11.cpp
@@ -222,6 +222,25 @@ D3D11GetCaps(const D3D10_2DDIARG_GETCAPS *pData, HRESULT *phr)
       c->Caps = D3D11DDI_ENCODE_3DPIPELINESUPPORT_CAP(D3D11DDI_3DPIPELINELEVEL_10_0);
       return TRUE;
    }
+   case D3DWDDM2_0DDICAPS_GPUVA_CAPS: {
+      /* exynos-woa D3: zero here fails device creation at the WDDM2_0 interface (D3D11CreateDevice 0x887a0020 on
+       * the device; same finding in virtio-d3d11's MIT triton layer, tritonDDI.c GetCaps). The Mali AS takes
+       * 48-bit VAs (MMU_FEATURES 0x2830, notes/gpu-wddm3-research.md Q7); a resource stays far below that. */
+      if (pData->DataSize < sizeof(D3DWDDM2_0DDI_GPUVA_CAPS_DATA)) { *phr = E_INVALIDARG; return TRUE; }
+      D3DWDDM2_0DDI_GPUVA_CAPS_DATA *c = (D3DWDDM2_0DDI_GPUVA_CAPS_DATA *)pData->pData;
+      memset(c, 0, pData->DataSize);
+      c->MaxGPUVirtualAddressBitsPerResource = 32;
+      return TRUE;
+   }
+   case D3DWDDM2_0DDICAPS_MEMORY_ARCHITECTURE: {
+      /* One aperture segment of system memory; the Mali is not I/O coherent (KMD GpuInfo coherency none). */
+      if (pData->DataSize < sizeof(D3DWDDM2_0DDI_MEMORY_ARCHITECTURE_CAPS)) { *phr = E_INVALIDARG; return TRUE; }
+      D3DWDDM2_0DDI_MEMORY_ARCHITECTURE_CAPS *c = (D3DWDDM2_0DDI_MEMORY_ARCHITECTURE_CAPS *)pData->pData;
+      memset(c, 0, pData->DataSize);
+      c->UMA = TRUE;
+      c->CacheCoherent = FALSE;
+      return TRUE;
+   }
    default:
       return FALSE;
    }
@@ -242,3 +261,45 @@ D3D11Enabled(void)
    const char *e = getenv("D3D10UMD_NO_D3D11");
    return !(e && *e && *e != '0');
 }
+
+/* For D3D11_1.cpp (the higher tiers reuse these conversions). */
+SIZE_T D3D11CalcPrivateGeometryShaderWithStreamOutput(D3D10DDI_HDEVICE hDevice,
+                                                      const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *p)
+{
+   return D11_CalcPrivateGeometryShaderWithStreamOutput(hDevice, p, NULL);
+}
+void D3D11CreateGeometryShaderWithStreamOutput(D3D10DDI_HDEVICE hDevice,
+                                               const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *p,
+                                               D3D10DDI_HSHADER h, D3D10DDI_HRTSHADER hRT)
+{
