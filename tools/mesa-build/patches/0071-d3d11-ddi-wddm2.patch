+static void
+d120_rtv(const D3DWDDM2_0DDIARG_CREATERENDERTARGETVIEW *in, D3D10DDIARG_CREATERENDERTARGETVIEW *out)
+{
+   memset(out, 0, sizeof *out);
+   out->hDrvResource = in->hDrvResource;
