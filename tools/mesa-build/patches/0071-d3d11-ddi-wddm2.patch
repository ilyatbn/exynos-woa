+/* ClearView: render target views only (UAV and video processor views are pipeline level 11_0 / video features).
+ * No rects = the whole view (ClearRenderTargetView); rects = per-rect clears with a float colour. */
+static void APIENTRY
+D11x_ClearView(D3D10DDI_HDEVICE hDevice, D3D11DDI_HANDLETYPE viewType, VOID *hView, const FLOAT Color[4],
+               const D3D10_DDI_RECT *pRect, UINT NumRects)
+{
+   if (viewType != D3D10DDI_HT_RENDERTARGETVIEW || hView == NULL)
+      return;
+   D3D10DDI_HRENDERTARGETVIEW h;
+   h.pDrvPrivate = hView;
+   if (NumRects == 0 || pRect == NULL) {
+      FLOAT c[4] = { Color[0], Color[1], Color[2], Color[3] };
+      ClearRenderTargetView(hDevice, h, c);
+      return;
+   }
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   struct pipe_surface *surface = CastPipeRenderTargetView(h);
+   union pipe_color_union cc;
+   for (unsigned i = 0; i < 4; i++)
+      cc.f[i] = Color[i];
+   for (UINT r = 0; r < NumRects; r++) {
+      if (pRect[r].right <= pRect[r].left || pRect[r].bottom <= pRect[r].top)
+         continue;
+      pipe->clear_render_target(pipe, surface, &cc, pRect[r].left, pRect[r].top, pRect[r].right - pRect[r].left,
+                                pRect[r].bottom - pRect[r].top, false);
+   }
+}
