+
+/* ---- states ---- */
+
+/* D3D11.1 blend adds per-target logic ops; logic ops are a D3D11_OPTIONS feature we do not report. */
+static void
+d111_blend(const D3D11_1_DDI_BLEND_DESC *in, D3D10_1_DDI_BLEND_DESC *out)
+{
+   memset(out, 0, sizeof *out);
+   out->AlphaToCoverageEnable = in->AlphaToCoverageEnable;
+   out->IndependentBlendEnable = in->IndependentBlendEnable;
+   for (unsigned i = 0; i < D3D10_DDI_SIMULTANEOUS_RENDER_TARGET_COUNT; i++) {
+      const D3D11_1_DDI_RENDER_TARGET_BLEND_DESC *s = &in->RenderTarget[i];
+      D3D10_DDI_RENDER_TARGET_BLEND_DESC1 *d = &out->RenderTarget[i];
+      d->BlendEnable = s->BlendEnable;
+      d->SrcBlend = s->SrcBlend;
+      d->DestBlend = s->DestBlend;
+      d->BlendOp = s->BlendOp;
+      d->SrcBlendAlpha = s->SrcBlendAlpha;
+      d->DestBlendAlpha = s->DestBlendAlpha;
+      d->BlendOpAlpha = s->BlendOpAlpha;
+      d->RenderTargetWriteMask = s->RenderTargetWriteMask;
+   }
+}
+
+static SIZE_T APIENTRY
+D111_CalcPrivateBlendStateSize(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_BLEND_DESC *pDesc)
+{
+   D3D10_1_DDI_BLEND_DESC d;
+   d111_blend(pDesc, &d);
+   return CalcPrivateBlendStateSize1(hDevice, &d);
+}
+
+static void APIENTRY
+D111_CreateBlendState(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_BLEND_DESC *pDesc, D3D10DDI_HBLENDSTATE h,
+                      D3D10DDI_HRTBLENDSTATE hRT)
+{
+   D3D10_1_DDI_BLEND_DESC d;
+   d111_blend(pDesc, &d);
+   CreateBlendState1(hDevice, &d, h, hRT);
+}
+
+/* D3D11.1 / WDDM 2.0 rasterizer: the D3D10 fields first (same order), then ForcedSampleCount (target-independent
+ * rasterization) and ConservativeRasterizationMode - neither is reported, so both are dropped. */
+#define RAST_COPY(in, out)                                                                                        \
+   do {                                                                                                           \
+      memset(&(out), 0, sizeof(out));                                                                             \
+      (out).FillMode = (in)->FillMode; (out).CullMode = (in)->CullMode;                                           \
+      (out).FrontCounterClockwise = (in)->FrontCounterClockwise; (out).DepthBias = (in)->DepthBias;              \
+      (out).DepthBiasClamp = (in)->DepthBiasClamp; (out).SlopeScaledDepthBias = (in)->SlopeScaledDepthBias;      \
+      (out).DepthClipEnable = (in)->DepthClipEnable; (out).ScissorEnable = (in)->ScissorEnable;                  \
+      (out).MultisampleEnable = (in)->MultisampleEnable; (out).AntialiasedLineEnable = (in)->AntialiasedLineEnable;\
+   } while (0)
+
+static SIZE_T APIENTRY
+D111_CalcPrivateRasterizerStateSize(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_RASTERIZER_DESC *pDesc)
+{
+   D3D10_DDI_RASTERIZER_DESC d;
+   RAST_COPY(pDesc, d);
+   return CalcPrivateRasterizerStateSize(hDevice, &d);
+}
+
+static void APIENTRY
+D111_CreateRasterizerState(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_RASTERIZER_DESC *pDesc,
+                           D3D10DDI_HRASTERIZERSTATE h, D3D10DDI_HRTRASTERIZERSTATE hRT)
+{
+   D3D10_DDI_RASTERIZER_DESC d;
+   RAST_COPY(pDesc, d);
+   CreateRasterizerState(hDevice, &d, h, hRT);
+}
+
+static SIZE_T APIENTRY
+D120_CalcPrivateRasterizerStateSize(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDI_RASTERIZER_DESC *pDesc)
+{
+   D3D10_DDI_RASTERIZER_DESC d;
+   RAST_COPY(pDesc, d);
+   return CalcPrivateRasterizerStateSize(hDevice, &d);
+}
+
+static void APIENTRY
+D120_CreateRasterizerState(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDI_RASTERIZER_DESC *pDesc,
+                           D3D10DDI_HRASTERIZERSTATE h, D3D10DDI_HRTRASTERIZERSTATE hRT)
+{
+   D3D10_DDI_RASTERIZER_DESC d;
+   RAST_COPY(pDesc, d);
+   CreateRasterizerState(hDevice, &d, h, hRT);
+}
+
+/* ---- shaders: the D3D11.1 signatures are informational and d3d10umd never reads them (Shader.cpp takes
+ * pSignatures and does not dereference it), so NULL goes down. ---- */
