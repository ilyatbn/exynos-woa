+
+void
+D3D11FillDxgi(DXGI_DDI_BASE_ARGS *a, UINT level)
+{
+   if (level >= 12) {   /* DXGI 1.2 (D3D11_1) */
+      DXGI1_2_DDI_BASE_FUNCTIONS *f = a->pDXGIDDIBaseFunctions3;
+      f->pfnResolveSharedResource = D3D11ResolveSharedResource;
+      f->pfnBlt1 = Dxgi_Blt1;
+      f->pfnOfferResources = Dxgi_OfferResources;
+      f->pfnReclaimResources = Dxgi_ReclaimResources;
+      if (level == 12) {
+         f->pfnGetMultiplaneOverlayCaps = Dxgi_GetMultiplaneOverlayCaps;
+         f->pfnGetMultiplaneOverlayFilterRange = NULL;
+         f->pfnCheckMultiplaneOverlaySupport = NULL;
+         f->pfnPresentMultiplaneOverlay = NULL;
+      }
+   }
+   if (level >= 13) {   /* DXGI 1.3 (WDDM 1.3): different MPO slots, Present1 */
+      DXGI1_3_DDI_BASE_FUNCTIONS *f = a->pDXGIDDIBaseFunctions4;
+      f->pfnGetMultiplaneOverlayCaps = Dxgi_GetMultiplaneOverlayCaps;
+      f->pfnGetMultiplaneOverlayGroupCaps = Dxgi_GetMultiplaneOverlayGroupCaps;
+      f->pfnReserved1 = NULL;
+      f->pfnPresentMultiplaneOverlay = NULL;
+      f->pfnReserved2 = NULL;
+      f->pfnPresent1 = Dxgi_Present1;
+      f->pfnCheckPresentDurationSupport = Dxgi_CheckPresentDurationSupport;
+   }
+   if (level >= 14) {   /* DXGI 1.4 (WDDM 2.0) */
+      DXGI1_4_DDI_BASE_FUNCTIONS *f = a->pDXGIDDIBaseFunctions5;
+      f->pfnTrimResidencySet = Dxgi_TrimResidencySet;
+      f->pfnCheckMultiplaneOverlayColorSpaceSupport = Dxgi_CheckMultiplaneOverlayColorSpaceSupport;
+      f->pfnPresentMultiplaneOverlay1 = NULL;
+   }
+}
