+
+/* Present1: one surface (no MPO) -> the existing present. */
+static HRESULT APIENTRY
+Dxgi_Present1(DXGI_DDI_ARG_PRESENT1 *p)
+{
+   DXGI_DDI_ARG_PRESENT pr;
+   memset(&pr, 0, sizeof pr);
+   pr.hDevice = p->hDevice;
+   if (p->SurfacesToPresent && p->phSurfacesToPresent) {
+      pr.hSurfaceToPresent = p->phSurfacesToPresent[0].hSurface;
+      pr.SrcSubResourceIndex = p->phSurfacesToPresent[0].SubResourceIndex;
+   }
+   pr.hDstResource = p->hDstResource;
+   pr.DstSubResourceIndex = p->DstSubResourceIndex;
+   pr.pDXGIContext = p->pDXGIContext;
+   pr.Flags = p->Flags;
+   pr.FlipInterval = p->FlipInterval;
+   return _Present(&pr);
+}
