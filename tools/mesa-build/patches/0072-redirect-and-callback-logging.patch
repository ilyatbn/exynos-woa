From 76387689d0aa96c2c5e5d7040a8b0e62c265b2a1 Mon Sep 17 00:00:00 2001
From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Fri, 16 Oct 2026 23:06:42 +0300
Subject: [PATCH] d3d10umd: D3D10UMD_REDIRECT (DXGI may redirect to DWM),
 SRV/CheckFormatSupport/SetError logging; malikm shim: every runtime callback
 logged through wrappers (exynos-woa 0072/0073)

---
 include/win32-compat/malikm_drm.c         | 143 ++++++++++++++++++++++
 src/gallium/frontends/d3d10umd/D3D11.cpp  |  12 ++
 src/gallium/frontends/d3d10umd/Device.cpp |  12 +-
 src/gallium/frontends/d3d10umd/State.h    |   2 +
 4 files changed, 168 insertions(+), 1 deletion(-)

diff --git a/include/win32-compat/malikm_drm.c b/include/win32-compat/malikm_drm.c
index 64e60b3..9095464 100644
--- a/include/win32-compat/malikm_drm.c
+++ b/include/win32-compat/malikm_drm.c
@@ -1733,6 +1733,147 @@ out:
    return ret;
 }
 
+/* ---- exynos-woa 0073 (notes/gpu-umd-d3d11.md 23:00): every runtime callback the shim makes, logged ----
+ * The real KT/DXGI callbacks are kept once (they are the same functions for every runtime device); ddi.cb / ddi.dxgi
+ * of each binding point at the wrappers below. Every call goes into a 64-entry ring (callback, HRESULT, device,
+ * two handles); a failing call is logged with its arguments and, for the first 6 failures, the whole ring. */
+static D3DDDI_DEVICECALLBACKS cbreal;
+static DXGI_DDI_BASE_CALLBACKS dxgireal, dxgiwrap;
+static int cbwrapped;
+struct cbring { const char *name; HRESULT hr; HANDLE dev; UINT a, b; DWORD tick; };
+static struct cbring cbr[64];
+static unsigned cbr_n, cbr_dumps;
+
+static HRESULT
+cblog(const char *name, HRESULT hr, HANDLE dev, UINT a, UINT b)
+{
+   {
+      /* proof of life: the first two calls of each callback are logged even when they succeed */
+      static const char *seen[32]; static unsigned seen_n[32];
+      for (unsigned i = 0; i < 32; i++) {
+         if (seen[i] == name || seen[i] == NULL) {
+            seen[i] = name;
+            if (seen_n[i]++ < 2)
+               malikm_tlog("CB ok? %s hr 0x%08lx dev %p a 0x%x b 0x%x", name, (unsigned long)hr, dev, a, b);
+            break;
+         }
+      }
+   }
+   struct cbring *r = &cbr[cbr_n++ % 64];
+   r->name = name; r->hr = hr; r->dev = dev; r->a = a; r->b = b; r->tick = GetTickCount();
+   if (hr < 0) {
+      malikm_tlog("CB FAIL %s hr 0x%08lx dev %p a 0x%x b 0x%x (binding %d)", name, (unsigned long)hr, dev, a, b,
+                  cur_bind);
+      if (cbr_dumps++ < 6) {
+         unsigned first = cbr_n > 64 ? cbr_n - 64 : 0;
+         for (unsigned i = first; i < cbr_n; i++) {
+            struct cbring *q = &cbr[i % 64];
+            malikm_tlog("  ring %u: %lu %s hr 0x%08lx dev %p a 0x%x b 0x%x", i, (unsigned long)q->tick, q->name,
+                        (unsigned long)q->hr, q->dev, q->a, q->b);
+         }
+      }
+   }
+   return hr;
+}
+
+static HRESULT APIENTRY
+w_AllocateCb(HANDLE d, D3DDDICB_ALLOCATE *x)
+{
+   HRESULT hr = cbreal.pfnAllocateCb(d, x);
+   return cblog("Allocate", hr, d, x->NumAllocations && x->pAllocationInfo ? x->pAllocationInfo[0].hAllocation : 0,
+                (UINT)(UINT_PTR)x->hResource);
+}
+static HRESULT APIENTRY
+w_DeallocateCb(HANDLE d, const D3DDDICB_DEALLOCATE *x)
+{
+   return cblog("Deallocate", cbreal.pfnDeallocateCb(d, x), d, x->NumAllocations && x->HandleList ? x->HandleList[0] : 0,
+                (UINT)(UINT_PTR)x->hResource);
+}
+static HRESULT APIENTRY
+w_LockCb(HANDLE d, D3DDDICB_LOCK *x)
+{
+   return cblog("Lock", cbreal.pfnLockCb(d, x), d, x->hAllocation, x->Flags.Value);
+}
+static HRESULT APIENTRY
+w_UnlockCb(HANDLE d, const D3DDDICB_UNLOCK *x)
+{
+   return cblog("Unlock", cbreal.pfnUnlockCb(d, x), d, x->NumAllocations && x->phAllocations ? x->phAllocations[0] : 0,
+                x->NumAllocations);
+}
+static HRESULT APIENTRY
+w_RenderCb(HANDLE d, D3DDDICB_RENDER *x)
+{
+   /* the list is the shim's walloc (filled before the call): log its handles on failure */
+   UINT n = x->NumAllocations;
+   HRESULT hr = cbreal.pfnRenderCb(d, x);
+   if (hr < 0 && walloc)
+      for (UINT i = 0; i < n && i < 96; i++)
+         malikm_tlog("  render list[%u] = 0x%x%s", i, walloc[i].hAllocation, walloc[i].WriteOperation ? " W" : "");
+   return cblog("Render", hr, d, n, (UINT)(UINT_PTR)x->hContext);
+}
+static HRESULT APIENTRY
+w_EscapeCb(HANDLE a, const D3DDDICB_ESCAPE *x)
+{
+   const UINT *code = (const UINT *)x->pPrivateDriverData;
+   return cblog("Escape", cbreal.pfnEscapeCb(a, x), x->hDevice, code ? code[0] : 0, x->PrivateDriverDataSize);
+}
+static HRESULT APIENTRY
+w_SetDisplayModeCb(HANDLE d, D3DDDICB_SETDISPLAYMODE *x)
+{
+   return cblog("SetDisplayMode", cbreal.pfnSetDisplayModeCb(d, x), d, x->hPrimaryAllocation, 0);
+}
+static HRESULT APIENTRY
+w_SignalSynchronizationObject2Cb(HANDLE d, const D3DDDICB_SIGNALSYNCHRONIZATIONOBJECT2 *x)
+{
+   return cblog("Signal2", cbreal.pfnSignalSynchronizationObject2Cb(d, x), d, (UINT)(UINT_PTR)x->hContext,
+                x->Flags.Value);
+}
+static HRESULT APIENTRY
+w_MakeResidentCb(HANDLE d, D3DDDI_MAKERESIDENT *x)
+{
+   HRESULT hr = cbreal.pfnMakeResidentCb(d, x);
+   /* E_PENDING is success with a fence to wait on */
+   return hr == E_PENDING ? (cblog("MakeResident(pending)", S_OK, d, x->NumAllocations ? x->AllocationList[0] : 0,
+                                   (UINT)x->PagingFenceValue), hr)
+                          : cblog("MakeResident", hr, d, x->NumAllocations ? x->AllocationList[0] : 0, x->hPagingQueue);
+}
+static HRESULT APIENTRY
+w_CreatePagingQueueCb(HANDLE d, D3DDDICB_CREATEPAGINGQUEUE *x)
+{
+   return cblog("CreatePagingQueue", cbreal.pfnCreatePagingQueueCb(d, x), d, x->hPagingQueue, 0);
+}
+static HRESULT APIENTRY
+w_CreateContextCb(HANDLE d, D3DDDICB_CREATECONTEXT *x)
+{
+   return cblog("CreateContext", cbreal.pfnCreateContextCb(d, x), d, x->NodeOrdinal, 0);
+}
+static HRESULT APIENTRY
+w_PresentCb(HANDLE d, DXGIDDICB_PRESENT *x)
+{
+   return cblog("Present", dxgireal.pfnPresentCb(d, x), d, x->hSrcAllocation, x->hDstAllocation);
+}
+
+/* Point a binding's callback copies at the wrappers (the first binding records the real functions). */
+static void
+cb_wrap(void)
+{
+   if (!cbwrapped) {
+      cbreal = ddi.cb;
+      if (ddi.dxgi)
+         dxgireal = *ddi.dxgi;
+      dxgiwrap = dxgireal;
+      dxgiwrap.pfnPresentCb = dxgireal.pfnPresentCb ? w_PresentCb : NULL;
+      cbwrapped = 1;
+   }
+#define W(f) if (cbreal.pfn##f) ddi.cb.pfn##f = w_##f
+   W(AllocateCb); W(DeallocateCb); W(LockCb); W(UnlockCb); W(RenderCb); W(EscapeCb);
+   W(SetDisplayModeCb); W(SignalSynchronizationObject2Cb); W(MakeResidentCb); W(CreatePagingQueueCb);
+   W(CreateContextCb);
+#undef W
+   if (ddi.dxgi)
+      ddi.dxgi = &dxgiwrap;
+}
+
 /* The runtime's device and callbacks, from d3d10umd's CreateDevice. 0 if
  * this is maliwddm's adapter and Panfrost now goes through the callbacks.
  * G13 (exynos-woa): 1 if it is maliwddm's adapter WITHOUT a GPU (GPU_INFO
@@ -1788,6 +1929,7 @@ malikm_bind_d3dddi(HANDLE hRTAdapter, HANDLE hRTDevice, const void *pKTCallbacks
          ddi.context = c.hContext;
          ddi.cb = *cb;
          ddi.dxgi = pDXGIBaseCallbacks;
+         cb_wrap();   /* exynos-woa 0073 */
          ret = 1;
       }
    } else if (es >= 0 && g.Count != 0 && g.Valid != 0) {
@@ -1801,6 +1943,7 @@ malikm_bind_d3dddi(HANDLE hRTAdapter, HANDLE hRTDevice, const void *pKTCallbacks
          ddi.context = c.hContext;
          ddi.cb = *cb;
          ddi.dxgi = pDXGIBaseCallbacks;
+         cb_wrap();   /* exynos-woa 0073 */
          wcmd = c.pCommandBuffer;
          wcmd_size = c.CommandBufferSize;
          walloc = c.pAllocationList;
diff --git a/src/gallium/frontends/d3d10umd/D3D11.cpp b/src/gallium/frontends/d3d10umd/D3D11.cpp
index 4e9348a..986d25f 100644
--- a/src/gallium/frontends/d3d10umd/D3D11.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D11.cpp
@@ -34,6 +34,11 @@
 #include <string.h>
 #include <stdlib.h>
 
+extern "C" void malikm_tlog(const char *fmt, ...);   /* exynos-woa: malikm_drm.c */
+
+
+/* exynos-woa 0073: State.h SetError logs through this (C++ linkage, no varargs in the header). */
+void malikm_tlog_cpp(const char *what, long hr) { malikm_tlog("%s 0x%08lx", what, (unsigned long)hr); }
 
 /* ---- the ten wrappers (argument structs that changed since D3D10.1) ---- */
 
@@ -104,6 +109,13 @@ D11_CreateShaderResourceView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATES
 {
    D3D10_1DDIARG_CREATESHADERRESOURCEVIEW v;
    d11_srv_to_101(pCreate, &v);
+   {
+      /* exynos-woa D4: DWM fail-fasts on CreateShaderResourceView of redirected swap chain buffers - what it asks */
+      static unsigned n;
+      if (n++ < 200)
+         malikm_tlog("SRV fmt %u dim %u res %p mip %u/%u", (unsigned)pCreate->Format, (unsigned)pCreate->ResourceDimension,
+                     pCreate->hDrvResource.pDrvPrivate, pCreate->Tex2D.MostDetailedMip, pCreate->Tex2D.MipLevels);
+   }
    CreateShaderResourceView1(hDevice, &v, hView, hRTView);
 }
 
diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index 6777f6c..93a95c0 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -390,7 +390,12 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    if (level >= 111)
       D3D11FillDxgi(&pCreateData->DXGIBaseDDI, level == 111 ? 12 : level == 113 ? 13 : 14);
 
-   if (0) {
+   /* exynos-woa D4 (notes/gpu-umd-d3d11.md): DXGI_STATUS_NO_REDIRECTION keeps DXGI from binding a swap chain's back
+    * buffers to DWM (ETW: no BindBackBuffersToDwm / DWMRedirection events on our adapter, both on WARP); composition
+    * swap chains (Terminal's SwapChainPanel, DirectComposition) then never get a DXGI tracked fence and die in
+    * d3d11!WaitTrackedFenceImpl. D3D10UMD_REDIRECT=1 lets DXGI redirect (S_OK); default unchanged until validated. */
+   const char *redir = getenv("D3D10UMD_REDIRECT");
+   if (redir && *redir && *redir != '0') {
       return S_OK;
    } else {
       // Tell DXGI to not use the shared resource presentation path when
@@ -559,6 +564,11 @@ CheckFormatSupport(D3D10DDI_HDEVICE hDevice, // IN
 
    *pFormatCaps = 0;
 
+   struct log_on_exit {   /* exynos-woa D4: what the runtime asks and what it gets (first 300 queries) */
+      DXGI_FORMAT f; UINT *c;
+      ~log_on_exit() { static unsigned n; if (n++ < 300) malikm_tlog("CheckFormatSupport %u -> 0x%x", (unsigned)f, *c); }
+   } log_ = { Format, pFormatCaps };
+
    enum pipe_format format = FormatTranslate(Format, false);
    if (format == PIPE_FORMAT_NONE) {
       *pFormatCaps = D3D10_DDI_FORMAT_SUPPORT_NOT_SUPPORTED;
diff --git a/src/gallium/frontends/d3d10umd/State.h b/src/gallium/frontends/d3d10umd/State.h
index 65c90d6..3e62e38 100644
--- a/src/gallium/frontends/d3d10umd/State.h
+++ b/src/gallium/frontends/d3d10umd/State.h
@@ -156,6 +156,8 @@ static inline void
 SetError(D3D10DDI_HDEVICE hDevice, HRESULT hr)
 {
    if (FAILED(hr)) {
+      extern void malikm_tlog_cpp(const char *what, long hr);   /* exynos-woa 0073: every error the UMD reports */
+      malikm_tlog_cpp("SetError", (long)hr);
       Device *pDevice = CastDevice(hDevice);
       pDevice->UMCallbacks.pfnSetErrorCb(pDevice->hRTCoreLayer, hr);
    }
-- 
