From 0c54e1fc485c5aaf0d61d2ebbd288f3d32b38821 Mon Sep 17 00:00:00 2001
From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Sat, 17 Oct 2026 00:34:18 +0300
Subject: [PATCH] F2 fixes from d3dsm41 (exynos-woa 0080): samplepos trailing
 DWORD accepted by the SM4 parser; TGSI SAMPLE_INFO takes one source (as
 documented); panfrost v6-v8 TEXTURE_SAMPLES sysval for
 nir_texop_texture_samples

---
 .../auxiliary/tgsi/tgsi_info_opcodes.h        |  2 +-
 src/gallium/drivers/panfrost/pan_cmdstream.c  |  6 +++++
 src/gallium/drivers/panfrost/pan_context.h    |  3 +++
 src/gallium/drivers/panfrost/pan_helpers.c    |  1 +
 .../drivers/panfrost/pan_nir_lower_sysvals.c  | 22 +++++++++++--------
 src/gallium/frontends/d3d10umd/ShaderParse.c  |  5 ++++-
 6 files changed, 28 insertions(+), 11 deletions(-)

diff --git a/src/gallium/auxiliary/tgsi/tgsi_info_opcodes.h b/src/gallium/auxiliary/tgsi/tgsi_info_opcodes.h
index bfe9663..d74e382 100644
--- a/src/gallium/auxiliary/tgsi/tgsi_info_opcodes.h
+++ b/src/gallium/auxiliary/tgsi/tgsi_info_opcodes.h
@@ -155,7 +155,7 @@ OPCODE(1, 4, OTHR, SAMPLE_L)
 OPCODE(1, 3, OTHR, GATHER4)
 OPCODE(1, 2, OTHR, SVIEWINFO)
 OPCODE(1, 2, OTHR, SAMPLE_POS)
-OPCODE(1, 2, OTHR, SAMPLE_INFO)
+OPCODE(1, 1, OTHR, SAMPLE_INFO)   /* exynos-woa F2: docs/gallium/tgsi.rst "SAMPLE_INFO dst, source" - one source */
 OPCODE(1, 1, COMP, UARL)
 OPCODE(1, 3, COMP, UCMP)
 OPCODE(1, 1, COMP, IABS)
diff --git a/src/gallium/drivers/panfrost/pan_cmdstream.c b/src/gallium/drivers/panfrost/pan_cmdstream.c
index 9da718f..9daf189 100644
--- a/src/gallium/drivers/panfrost/pan_cmdstream.c
+++ b/src/gallium/drivers/panfrost/pan_cmdstream.c
@@ -1334,6 +1334,12 @@ panfrost_upload_sysvals(struct panfrost_batch *batch, void *ptr_cpu,
          panfrost_upload_txs_sysval(batch, st, PAN_SYSVAL_ID(sysval),
                                     &uniforms[i]);
          break;
+      case PAN_SYSVAL_TEXTURE_SAMPLES: {
+         /* exynos-woa F2: sample count of the bound view's resource (1 when not multisampled, 0 when unbound) */
+         struct panfrost_sampler_view *v = batch->ctx->sampler_views[st][PAN_SYSVAL_ID(sysval)];
+         uniforms[i].u[0] = v && v->base.texture ? MAX2(v->base.texture->nr_samples, 1) : 0;
+         break;
+      }
       case PAN_SYSVAL_SSBO:
          panfrost_upload_ssbo_sysval(batch, st, PAN_SYSVAL_ID(sysval),
                                      &uniforms[i]);
diff --git a/src/gallium/drivers/panfrost/pan_context.h b/src/gallium/drivers/panfrost/pan_context.h
index 651bce3..6b91f98 100644
--- a/src/gallium/drivers/panfrost/pan_context.h
+++ b/src/gallium/drivers/panfrost/pan_context.h
@@ -307,6 +307,9 @@ enum {
    PAN_SYSVAL_NUM_VERTICES = 18,
    PAN_SYSVAL_PRINTF_BUFFER = 19,
    PAN_SYSVAL_IMAGE_SAMPLES = 20,
+   /* exynos-woa F2: nir_texop_texture_samples (D3D sampleinfo / GL textureSamples) on v6-v8, where the texture
+    * descriptor cannot be queried from the shader (pan_nir_lower_tex lowers it only for v9+); id = texture index */
+   PAN_SYSVAL_TEXTURE_SAMPLES = 21,
 };
 
 #define PAN_TXS_SYSVAL_ID(texidx, dim, is_array)                               \
diff --git a/src/gallium/drivers/panfrost/pan_helpers.c b/src/gallium/drivers/panfrost/pan_helpers.c
index 99012fd..16409d6 100644
--- a/src/gallium/drivers/panfrost/pan_helpers.c
+++ b/src/gallium/drivers/panfrost/pan_helpers.c
@@ -20,6 +20,7 @@ panfrost_analyze_sysvals(struct panfrost_compiled_shader *ss)
          break;
 
       case PAN_SYSVAL_TEXTURE_SIZE:
+      case PAN_SYSVAL_TEXTURE_SAMPLES:   /* exynos-woa F2 */
          dirty_shader |= PAN_DIRTY_STAGE_TEXTURE;
          break;
 
diff --git a/src/gallium/drivers/panfrost/pan_nir_lower_sysvals.c b/src/gallium/drivers/panfrost/pan_nir_lower_sysvals.c
index 3cc1314..bcb3653 100644
--- a/src/gallium/drivers/panfrost/pan_nir_lower_sysvals.c
+++ b/src/gallium/drivers/panfrost/pan_nir_lower_sysvals.c
@@ -147,7 +147,7 @@ uses_sysvals(unsigned arch, nir_shader *shader)
                   return true;
             } else if (instr->type == nir_instr_type_tex) {
                nir_tex_instr *tex = nir_instr_as_tex(instr);
-               if (tex->op == nir_texop_txs)
+               if (tex->op == nir_texop_txs || tex->op == nir_texop_texture_samples)
                   return true;
             }
          }
@@ -200,15 +200,19 @@ lower(nir_builder *b, nir_instr *instr, void *data)
       nir_tex_instr *tex = nir_instr_as_tex(instr);
       old = &tex->def;
 
-      if (tex->op != nir_texop_txs)
+      if (tex->op == nir_texop_texture_samples && ctx->arch < 9) {
+         /* exynos-woa F2: same static-index limitation as txs below */
+         sysval = PAN_SYSVAL(TEXTURE_SAMPLES, tex->texture_index);
+      } else if (tex->op != nir_texop_txs) {
          return false;
-
-      /* XXX: This is broken for dynamic indexing */
-      sysval = PAN_SYSVAL(TEXTURE_SIZE,
-                          PAN_TXS_SYSVAL_ID(tex->texture_index,
-                                            nir_tex_instr_dest_size(tex) -
-                                               (tex->is_array ? 1 : 0),
-                                            tex->is_array));
+      } else {
+         /* XXX: This is broken for dynamic indexing */
+         sysval = PAN_SYSVAL(TEXTURE_SIZE,
+                             PAN_TXS_SYSVAL_ID(tex->texture_index,
+                                               nir_tex_instr_dest_size(tex) -
+                                                  (tex->is_array ? 1 : 0),
+                                               tex->is_array));
+      }
    } else {
       return false;
    }
diff --git a/src/gallium/frontends/d3d10umd/ShaderParse.c b/src/gallium/frontends/d3d10umd/ShaderParse.c
index a3eaeb9..5d5d19a 100644
--- a/src/gallium/frontends/d3d10umd/ShaderParse.c
+++ b/src/gallium/frontends/d3d10umd/ShaderParse.c
@@ -601,7 +601,10 @@ Shader_parse_opcode(struct Shader_parser *parser,
       break;
    }
 
-   assert(curr == parser->curr + length);
+   /* exynos-woa F2: fxc emits samplepos with one trailing zero DWORD after its operands (d3dsm41: length 8, operands
+    * 7 - tools/phone/wddm2 notes 2026-10-17); the opcode length is authoritative, padding is skipped. */
+   assert(curr == parser->curr + length ||
+          (opcode->type == D3D10_1_SB_OPCODE_SAMPLE_POS && curr <= parser->curr + length));
 
 skip:
    /* Advance to the next opcode. */
-- 
2.40.1.windows.1

