From 0f4736767251a5a452f073a1135d7240fc273eda Mon Sep 17 00:00:00 2001
From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Sat, 17 Oct 2026 07:45:06 +0300
Subject: [PATCH] d3d10umd: D3D11 video decoder DDI skeleton (exynos-woa 0083,
 G17 V6a) - H.264 VLD_NOFGT profile, NV12 decoder output (one R8 surface W x
 1.5H), 1 config (BitstreamRaw 2), 4 buffer types with DYNAMIC usage (the
 runtime creates the buffers with BUFFER_INFO.Usage as their resource usage,
 measured), decoder/output-view objects, frame calls record buffers; tables
 via RetrieveSubObject 2/3, generated stubs (gen-video-ddi.py)

---
 src/gallium/frontends/d3d10umd/D3D11.h        |   3 +
 src/gallium/frontends/d3d10umd/Device.cpp     |  13 +
 src/gallium/frontends/d3d10umd/Resource.cpp   |  28 +
 src/gallium/frontends/d3d10umd/State.h        |   4 +
 src/gallium/frontends/d3d10umd/Video.cpp      | 325 ++++++++++
 src/gallium/frontends/d3d10umd/meson.build    |   1 +
 .../frontends/d3d10umd/video_fill_11_1.inc    |  82 +++
 .../frontends/d3d10umd/video_fill_wddm2_0.inc |  95 +++
 .../frontends/d3d10umd/video_stubs.inc        | 593 ++++++++++++++++++
 9 files changed, 1144 insertions(+)
 create mode 100644 src/gallium/frontends/d3d10umd/Video.cpp
 create mode 100644 src/gallium/frontends/d3d10umd/video_fill_11_1.inc
 create mode 100644 src/gallium/frontends/d3d10umd/video_fill_wddm2_0.inc
 create mode 100644 src/gallium/frontends/d3d10umd/video_stubs.inc

diff --git a/src/gallium/frontends/d3d10umd/D3D11.h b/src/gallium/frontends/d3d10umd/D3D11.h
index c6a0631..6e55eeb 100644
--- a/src/gallium/frontends/d3d10umd/D3D11.h
+++ b/src/gallium/frontends/d3d10umd/D3D11.h
@@ -6,6 +6,9 @@
 void D3D11FillDeviceFuncs(D3D11DDI_DEVICEFUNCS *pFuncs);
 BOOL D3D11GetCaps(const D3D10_2DDIARG_GETCAPS *pData, HRESULT *phr);
 HRESULT APIENTRY D3D11ResolveSharedResource(DXGI_DDI_ARG_RESOLVESHAREDRESOURCE *pArgs);
+/* exynos-woa G17 V6a: video function tables (Video.cpp) */
+HRESULT APIENTRY VideoRetrieveSubObject(D3D10DDI_HDEVICE hDevice, UINT32 SubDeviceID, SIZE_T ParamSize, void *pParams,
+                                       SIZE_T OutputParamSize, void *pOutputParamsBuffer);
 BOOL D3D11Enabled(void);
 /* D2/D3 (D3D11_1.cpp) */
 void D3D11_1FillDeviceFuncs(D3D11_1DDI_DEVICEFUNCS *pFuncs);
diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index 3f75108..d6128e7 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -392,6 +392,14 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    /* D3D11_1 -> DXGI 1.2, WDDM1_3 -> DXGI 1.3, WDDM2_0 -> DXGI 1.4 (exynos-woa D2/D3) */
    if (level >= 111)
       D3D11FillDxgi(&pCreateData->DXGIBaseDDI, level == 111 ? 12 : level == 113 ? 13 : 14);
+   /* exynos-woa G17 V6a: the video function tables through RetrieveSubObject (D3D11.1+ interfaces; MS Learn
+    * D3D10DDIARG_CREATEDEVICE ppfnRetrieveSubObject "in/out: pointer to sub-object retrieval function pointer").
+    * D3D10UMD_NO_VIDEO=1 hides them - diagnosis only. */
+   {
+      const char *nv = getenv("D3D10UMD_NO_VIDEO");
+      if (level >= 111 && pCreateData->ppfnRetrieveSubObject && !(nv && *nv && *nv != '0'))
+         *pCreateData->ppfnRetrieveSubObject = VideoRetrieveSubObject;
+   }
 
    /* exynos-woa D4 (notes/gpu-umd-d3d11.md): DXGI_STATUS_NO_REDIRECTION keeps DXGI from binding a swap chain's back
     * buffers to DWM (ETW: no BindBackBuffersToDwm / DWMRedirection events on our adapter, both on WARP); composition
@@ -645,6 +653,11 @@ CheckFormatSupportCaps(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT *pForm
 
    *pFormatCaps = 0;
 
+   if (Format == DXGI_FORMAT_NV12) {
+      /* exynos-woa G17 V6a: NV12 exists for the video decoder only (Resource::nv12_height layout) */
+      *pFormatCaps = D3D11_1DDI_FORMAT_SUPPORT_DECODER_OUTPUT;
+      return;
+   }
    enum pipe_format format = FormatTranslate(Format, false);
    if (format == PIPE_FORMAT_NONE) {
       *pFormatCaps = D3D10_DDI_FORMAT_SUPPORT_NOT_SUPPORTED;
diff --git a/src/gallium/frontends/d3d10umd/Resource.cpp b/src/gallium/frontends/d3d10umd/Resource.cpp
index 4a6ba05..887e751 100644
--- a/src/gallium/frontends/d3d10umd/Resource.cpp
+++ b/src/gallium/frontends/d3d10umd/Resource.cpp
@@ -43,6 +43,7 @@
 #include "util/u_surface.h"
 #include "frontend/winsys_handle.h"   /* G13 0034: OpenResource over external memory */
 #include "drm-uapi/drm_fourcc.h"      /* exynos-woa H3: DRM_FORMAT_MOD_LINEAR for BO imports */
+extern "C" void malikm_tlog(const char *fmt, ...);   /* exynos-woa H4: timing/event log (malikm_drm.c) */
 
 
 /*
@@ -63,6 +64,13 @@ CalcPrivateResourceSize(D3D10DDI_HDEVICE hDevice,
                         __in const D3D10DDIARG_CREATERESOURCE *pCreateResource)  // IN
 {
    LOG_ENTRYPOINT();
+   if (pCreateResource->BindFlags & D3D11_DDI_BIND_DECODER) {   /* exynos-woa G17 V6a: decoder buffers / outputs */
+      malikm_tlog("CalcPrivateResourceSize dim %u fmt %u %ux%u bind 0x%x usage %u cpu 0x%x misc 0x%x",
+                  (unsigned)pCreateResource->ResourceDimension, (unsigned)pCreateResource->Format,
+                  pCreateResource->pMipInfoList[0].TexelWidth, pCreateResource->pMipInfoList[0].TexelHeight,
+                  pCreateResource->BindFlags, (unsigned)pCreateResource->Usage, pCreateResource->MapFlags,
+                  pCreateResource->MiscFlags);
+   }
    return sizeof(Resource);
 }
 
@@ -300,6 +308,16 @@ CreateResource(D3D10DDI_HDEVICE hDevice,                                // IN
    Resource *pResource = CastResource(hResource);
 
    memset(pResource, 0, sizeof *pResource);
+   {
+      /* exynos-woa G17 V6a: what the runtime creates around the video decoder (first 60 resources) */
+      static unsigned n;
+      if (n++ < 60)
+         malikm_tlog("CreateResource dim %u fmt %u %ux%u mips %u array %u bind 0x%x usage %u cpu 0x%x misc 0x%x",
+                     (unsigned)pCreateResource->ResourceDimension, (unsigned)pCreateResource->Format,
+                     pCreateResource->pMipInfoList[0].TexelWidth, pCreateResource->pMipInfoList[0].TexelHeight,
+                     pCreateResource->MipLevels, pCreateResource->ArraySize, pCreateResource->BindFlags,
+                     (unsigned)pCreateResource->Usage, pCreateResource->MapFlags, pCreateResource->MiscFlags);
+   }
 
 #if 0
    if (pCreateResource->pPrimaryDesc) {
@@ -326,6 +344,8 @@ CreateResource(D3D10DDI_HDEVICE hDevice,                                // IN
    if (pCreateResource->Format == DXGI_FORMAT_UNKNOWN) {
       assert(pCreateResource->ResourceDimension == D3D10DDIRESOURCE_BUFFER);
       templat.format = PIPE_FORMAT_R8_UINT;
+   } else if (pCreateResource->Format == DXGI_FORMAT_NV12) {
+      templat.format = PIPE_FORMAT_R8_UNORM;   /* exynos-woa G17 V6a: see Resource::nv12_height */
    } else {
       BOOL bindDepthStencil = !!(pCreateResource->BindFlags & D3D10_DDI_BIND_DEPTH_STENCIL);
       templat.format = FormatTranslate(pCreateResource->Format, bindDepthStencil);
@@ -333,6 +353,14 @@ CreateResource(D3D10DDI_HDEVICE hDevice,                                // IN
 
    templat.width0     = pCreateResource->pMipInfoList[0].TexelWidth;
    templat.height0    = pCreateResource->pMipInfoList[0].TexelHeight;
+   if (pCreateResource->Format == DXGI_FORMAT_NV12) {
+      if (pCreateResource->MipLevels != 1 || (templat.width0 & 1) || (templat.height0 & 1)) {
+         SetError(hDevice, E_INVALIDARG);   /* NV12: one level, even dimensions (4:2:0) */
+         return;
+      }
+      pResource->nv12_height = templat.height0;
+      templat.height0 += templat.height0 / 2;
+   }
    templat.depth0     = pCreateResource->pMipInfoList[0].TexelDepth;
    templat.array_size = pCreateResource->ArraySize;
    templat.last_level = pCreateResource->MipLevels - 1;
diff --git a/src/gallium/frontends/d3d10umd/State.h b/src/gallium/frontends/d3d10umd/State.h
index 9806671..0697a25 100644
--- a/src/gallium/frontends/d3d10umd/State.h
+++ b/src/gallium/frontends/d3d10umd/State.h
@@ -184,6 +184,10 @@ struct Resource
    /* exynos-woa H5 (0059): a kernel allocation the runtime frees with this resource (created shared/present, or
     * opened) that the shim lists as a BO; DestroyResource tells the shim it is gone. 0 if none. */
    unsigned kmt_runtime_alloc;
+   /* exynos-woa G17 V6a: an NV12 texture (decoder output / video processor input), stored as ONE R8 surface
+    * Width x (Height + Height/2): the luma plane, then the interleaved CbCr plane (Height/2 rows of Width bytes) -
+    * the layout the MFC returns and the video processor (V6c) reads. nv12_height = the luma height, 0 if not NV12. */
+   unsigned nv12_height;
 };
 
 
diff --git a/src/gallium/frontends/d3d10umd/Video.cpp b/src/gallium/frontends/d3d10umd/Video.cpp
new file mode 100644
index 0000000..97242f2
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/Video.cpp
@@ -0,0 +1,325 @@
+/*
+ * exynos-woa G17 V6a (notes/g17-dxva-mfc.md): the D3D11 video decoder DDI of the Mali UMD - the H.264 subset that
+ * Microsoft's H.264 decoder (msmpeg2vdec, Media Foundation) uses through ID3D11VideoDevice/ID3D11VideoContext:
+ * one profile (D3D11_1DDI_DECODER_PROFILE_H264_VLD_NOFGT), NV12 output, one configuration with short slice control
+ * (ConfigBitstreamRaw 2 = DXVA_Slice_H264_Short, no encryption). The tables are handed to the runtime through
+ * RetrieveSubObject (MS Learn PFND3D10DDI_RETRIEVESUBOBJECT: SubDeviceID 2 = D3D11_1DDI_VIDEODEVICEFUNCS,
+ * 3 = D3DWDDM2_0DDI_VIDEODEVICEFUNCS; input D3D11_1DDI_VIDEO_INPUT / the 2.0 equivalent with the function table).
+ *
+ * V6a: queries, decoder and output-view objects, and the frame calls record what they receive (buffer types and
+ * sizes, output view) - the decode itself (DXVA H.264 -> Annex-B -> MFC IOCTLs -> NV12 copy into the output view)
+ * is V6b. EndFrame without a decoder backend fills nothing and logs once.
+ *
+ * Every member that is not in the H.264 subset comes from the generated stubs (video_stubs.inc, gen-video-ddi.py).
+ */
+
+#include "Draw.h"
+#include "Device.h"
+#include "Resource.h"
+#include "State.h"
+#include "D3D11.h"
+
+#include "Debug.h"
+
+#include <initguid.h>
+
+extern "C" void malikm_tlog(const char *fmt, ...);
+
+/* MS Learn / WDK d3d10umddi.h: D3D11_1DDI_DECODER_PROFILE_H264_VLD_NOFGT; dxva.h DXVA_NoEncrypt */
+static const GUID kH264VldNoFgt = { 0x1b81be68, 0xa0c7, 0x11d3, { 0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5 } };
+static const GUID kNoEncrypt = { 0x1b81bed0, 0xa0c7, 0x11d3, { 0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5 } };
+
+/* MFC limit validated so far (notes/d10-mfc-decode-flow.md V3: 1080p High with B-frames, bit-exact) */
+#define VID_MAX_W 1920
+#define VID_MAX_H 1088
+
+struct VideoDecoder {
+   D3D11_1DDI_VIDEO_DECODER_DESC Desc;
+   D3D11_1DDI_VIDEO_DECODER_CONFIG Config;
+   void *Output;            /* current frame's output view (VideoOutputView *) */
+   unsigned Frames;
+   unsigned BufferCounts[11];
+};
+
+struct VideoOutputView {
+   D3D10DDI_HRESOURCE Resource;
+   UINT ArraySlice;
+};
+
+static BOOL
+IsH264(const GUID *g)
+{
+   return g && IsEqualGUID(*g, kH264VldNoFgt);
+}
+
+static BOOL
+DescOk(const D3D11_1DDI_VIDEO_DECODER_DESC *d)
+{
+   return d && IsH264(&d->Guid) && d->OutputFormat == DXGI_FORMAT_NV12 && d->SampleWidth && d->SampleHeight &&
+          d->SampleWidth <= VID_MAX_W && d->SampleHeight <= VID_MAX_H;
+}
+
+static VOID APIENTRY
+Vid_GetVideoDecoderProfileCount(D3D10DDI_HDEVICE hDevice, UINT *pCount)
+{
+   (void)hDevice;
+   *pCount = 1;
+}
+
+static VOID APIENTRY
+Vid_GetVideoDecoderProfile(D3D10DDI_HDEVICE hDevice, UINT Index, GUID *pGuid)
+{
+   if (Index != 0) {
+      SetError(hDevice, E_INVALIDARG);
+      return;
+   }
+   *pGuid = kH264VldNoFgt;
+}
+
+static VOID APIENTRY
+Vid_CheckVideoDecoderFormat(D3D10DDI_HDEVICE hDevice, CONST GUID *pGuid, DXGI_FORMAT Format, BOOL *pSupported)
+{
+   (void)hDevice;
+   *pSupported = IsH264(pGuid) && Format == DXGI_FORMAT_NV12;
+}
+
+static VOID APIENTRY
+Vid_GetVideoDecoderConfigCount(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT *pCount)
+{
+   (void)hDevice;
+   *pCount = DescOk(pDesc) ? 1 : 0;
+   malikm_tlog("video: config count %ux%u fmt %u -> %u", pDesc ? pDesc->SampleWidth : 0,
+               pDesc ? pDesc->SampleHeight : 0, pDesc ? (unsigned)pDesc->OutputFormat : 0, *pCount);
+}
+
+static VOID APIENTRY
+Vid_GetVideoDecoderConfig(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT Index,
+                          D3D11_1DDI_VIDEO_DECODER_CONFIG *pConfig)
+{
+   if (!DescOk(pDesc) || Index != 0) {
+      SetError(hDevice, E_INVALIDARG);
+      return;
+   }
+   memset(pConfig, 0, sizeof(*pConfig));
+   pConfig->guidConfigBitstreamEncryption = kNoEncrypt;
+   pConfig->guidConfigMBcontrolEncryption = kNoEncrypt;
+   pConfig->guidConfigResidDiffEncryption = kNoEncrypt;
+   pConfig->ConfigBitstreamRaw = 2;   /* DXVA_Slice_H264_Short (start codes kept): what a stateful MFC can take */
+   pConfig->ConfigMinRenderTargetBuffCount = 0;
+   pConfig->ConfigDecoderSpecific = 0;
+}
+
+static VOID APIENTRY
+Vid_GetVideoDecoderBufferTypeCount(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT *pCount)
+{
+   (void)hDevice;
+   /* only the profile matters here - the runtime may describe the operation without the output size/format */
+   *pCount = pDesc && IsH264(&pDesc->Guid) ? 4 : 0;
+   malikm_tlog("video: buffer type count %u (desc %ux%u fmt %u)", *pCount, pDesc ? pDesc->SampleWidth : 0,
+               pDesc ? pDesc->SampleHeight : 0, pDesc ? (unsigned)pDesc->OutputFormat : 0);
+}
+
+static VOID APIENTRY
+Vid_GetVideoDecoderBufferInfo(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT Index,
+                              D3D11_1DDI_VIDEO_DECODER_BUFFER_INFO *pInfo)
+{
+   /* picture parameters (DXVA_PicParams_H264), inverse quantisation (DXVA_Qmatrix_H264), slice control (short
+    * entries), bitstream - sizes generous for 1080p. Usage: the runtime creates each buffer as a resource with this
+    * value as its D3D10_DDI_RESOURCE_USAGE (measured, notes/g17-dxva-mfc.md: DEFAULT and IMMUTABLE fail
+    * CreateVideoDecoder with E_UNEXPECTED, DYNAMIC gives CPU-write buffers) although MS Learn types the member as
+    * D3D11_1DDI_VIDEO_USAGE. DYNAMIC: the app writes, the decoder reads. */
+#define VID_BUF_USAGE ((D3D11_1DDI_VIDEO_USAGE)D3D10_DDI_USAGE_DYNAMIC)
+   static const D3D11_1DDI_VIDEO_DECODER_BUFFER_INFO kInfo[4] = {
+      { D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS, 4096, VID_BUF_USAGE },
+      { D3D11_1DDI_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX, 4096, VID_BUF_USAGE },
+      { D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL, 64 * 1024, VID_BUF_USAGE },
+      { D3D11_1DDI_VIDEO_DECODER_BUFFER_BITSTREAM, 4 * 1024 * 1024, VID_BUF_USAGE },
+   };
+   malikm_tlog("video: buffer info %u (desc %ux%u fmt %u)", Index, pDesc ? pDesc->SampleWidth : 0,
+               pDesc ? pDesc->SampleHeight : 0, pDesc ? (unsigned)pDesc->OutputFormat : 0);
+   if (!pDesc || !IsH264(&pDesc->Guid) || Index >= 4) {
+      SetError(hDevice, E_INVALIDARG);
+      return;
+   }
+   *pInfo = kInfo[Index];
+}
+
+static SIZE_T APIENTRY
+Vid_CalcPrivateVideoDecoderSize(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDIARG_CREATEVIDEODECODER *pArgs)
+{
+   (void)hDevice;
+   malikm_tlog("video: CalcPrivateVideoDecoderSize %ux%u raw %u", pArgs->Desc.SampleWidth, pArgs->Desc.SampleHeight,
+               pArgs->Config.ConfigBitstreamRaw);
+   return sizeof(VideoDecoder);
+}
+
+static HRESULT APIENTRY
+Vid_CreateVideoDecoder(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDIARG_CREATEVIDEODECODER *pArgs,
+                       D3D11_1DDI_HDECODE hDecode, D3D11_1DDI_HRTDECODE hRTDecode)
+{
+   (void)hDevice; (void)hRTDecode;
+   VideoDecoder *d = (VideoDecoder *)hDecode.pDrvPrivate;
+   memset(d, 0, sizeof(*d));
+   if (!DescOk(&pArgs->Desc) || pArgs->Config.ConfigBitstreamRaw != 2) {
+      malikm_tlog("video: CreateVideoDecoder rejected (raw %u)", pArgs->Config.ConfigBitstreamRaw);
+      return E_INVALIDARG;
+   }
+   d->Desc = pArgs->Desc;
+   d->Config = pArgs->Config;
+   malikm_tlog("video: decoder %ux%u created", d->Desc.SampleWidth, d->Desc.SampleHeight);
+   return S_OK;
+}
+
+static VOID APIENTRY
+Vid_DestroyVideoDecoder(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode)
+{
+   (void)hDevice;
+   VideoDecoder *d = (VideoDecoder *)hDecode.pDrvPrivate;
+   malikm_tlog("video: decoder destroyed after %u frames (pp %u iq %u sc %u bs %u)", d->Frames, d->BufferCounts[1],
+               d->BufferCounts[5], d->BufferCounts[6], d->BufferCounts[7]);
+}
+
+static HRESULT APIENTRY
+Vid_VideoDecoderExtension(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode,
+                          CONST D3D11_1DDIARG_VIDEODECODEREXTENSION *pArgs)
+{
+   (void)hDevice; (void)hDecode; (void)pArgs;
+   return E_NOTIMPL;
+}
+
+static HRESULT APIENTRY
+Vid_VideoDecoderBeginFrame(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode,
+                           CONST D3D11_1DDIARG_VIDEODECODERBEGINFRAME *pArgs)
+{
+   (void)hDevice;
+   VideoDecoder *d = (VideoDecoder *)hDecode.pDrvPrivate;
+   if (pArgs->pContentKey || pArgs->ContentKeySize)
+      return E_INVALIDARG;   /* no protected content */
+   d->Output = pArgs->hOutputView.pDrvPrivate;
+   return S_OK;
+}
+
+static void
+CountBuffer(VideoDecoder *d, UINT Type, UINT Size)
+{
+   if (Type < 11)
+      d->BufferCounts[Type]++;
+   if (d->Frames < 3)
+      malikm_tlog("video: frame %u buffer type %u size %u", d->Frames, Type, Size);
+}
+
+static HRESULT APIENTRY
+Vid_VideoDecoderSubmitBuffers(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode, UINT Count,
+                              CONST D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *pDesc)
+{
+   (void)hDevice;
+   VideoDecoder *d = (VideoDecoder *)hDecode.pDrvPrivate;
+   for (UINT i = 0; i < Count; i++)
+      CountBuffer(d, pDesc[i].BufferType, pDesc[i].DataSize);
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+Vid_VideoDecoderSubmitBuffers1(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode, UINT Count,
+                               CONST D3DWDDM2_0DDI_VIDEO_DECODER_BUFFER_DESC1 *pDesc)
+{
+   (void)hDevice;
+   VideoDecoder *d = (VideoDecoder *)hDecode.pDrvPrivate;
+   for (UINT i = 0; i < Count; i++) {
+      if (pDesc[i].pIV || pDesc[i].SubSampleMappingCount)
+         return E_INVALIDARG;   /* no encryption */
+      CountBuffer(d, pDesc[i].BufferType, pDesc[i].DataSize);
+   }
+   return S_OK;
+}
+
+static VOID APIENTRY
+Vid_VideoDecoderEndFrame(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecode)
+{
+   (void)hDevice;
+   VideoDecoder *d = (VideoDecoder *)hDecode.pDrvPrivate;
+   if (d->Frames++ == 0)
+      malikm_tlog("video: EndFrame - no decode backend yet (V6a), output left as is");
+   d->Output = NULL;
+}
+
+static SIZE_T APIENTRY
+Vid_CalcPrivateVideoDecoderOutputViewSize(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *p)
+{
+   (void)hDevice; (void)p;
+   return sizeof(VideoOutputView);
+}
+
+static HRESULT APIENTRY
+Vid_CreateVideoDecoderOutputView(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *p,
+                                 D3D11_1DDI_HVIDEODECODEROUTPUTVIEW hView, D3D11_1DDI_HRTVIDEODECODEROUTPUTVIEW hRT)
+{
+   (void)hDevice; (void)hRT;
+   VideoOutputView *v = (VideoOutputView *)hView.pDrvPrivate;
+   if (!IsH264(&p->DecodeProfile) || p->MipSlice != 0)
+      return E_INVALIDARG;
+   v->Resource = p->hDrvResource;
+   v->ArraySlice = p->FirstArraySlice;
+   return S_OK;
+}
+
+static VOID APIENTRY
+Vid_DestroyVideoDecoderOutputView(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEODECODEROUTPUTVIEW hView)
+{
+   (void)hDevice; (void)hView;
+}
+
+static HRESULT APIENTRY
+Vid_GetContentProtectionCaps(D3D10DDI_HDEVICE hDevice, CONST GUID *pCryptoType, CONST GUID *pDecodeProfile,
+                             D3D11_1DDI_VIDEO_CONTENT_PROTECTION_CAPS *pCaps)
+{
+   (void)hDevice; (void)pCryptoType; (void)pDecodeProfile;
+   memset(pCaps, 0, sizeof(*pCaps));   /* no content protection */
+   return S_OK;
+}
