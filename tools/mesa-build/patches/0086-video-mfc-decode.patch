index b2f14f7..f1d5bb7 100644
--- a/src/gallium/frontends/d3d10umd/Video.cpp
+++ b/src/gallium/frontends/d3d10umd/Video.cpp
@@ -20,11 +20,43 @@
 #include "D3D11.h"
 
 #include "Debug.h"
+#include "VideoH264.h"
+
+#include "util/u_inlines.h"
 
 #include <initguid.h>
+#include <winioctl.h>
