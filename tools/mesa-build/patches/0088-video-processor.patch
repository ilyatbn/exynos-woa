diff --git a/src/gallium/frontends/d3d10umd/VideoCsc.c b/src/gallium/frontends/d3d10umd/VideoCsc.c
new file mode 100644
index 0000000..5af1140
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/VideoCsc.c
@@ -0,0 +1,97 @@
+/*
+ * exynos-woa G17 V6c: NV12 -> RGBA8 compute kernel of the video processor - see VideoCsc.h. Built as NIR (panfrost
+ * takes compute kernels as NIR only), in the form the gallium drivers receive from the state trackers: texel fetch by
+ * texture index, image store by image index, constants through UBO 0.
+ *
+ * Colour: ITU-R BT.601 / BT.709 YCbCr -> R'G'B' (Kr, Kb per standard), studio range Y 16-235 / C 16-240 of 255.
+ * Chroma is taken from the 2x2 block the pixel is in (no interpolation).
+ */
+
+#include "VideoCsc.h"
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "util/format/u_formats.h"
+
+void
+vcsc_matrix(struct vcsc_constants *c, int bt709, int ycbcr_full, int rgb_studio)
+{
+   const float kr = bt709 ? 0.2126f : 0.299f, kb = bt709 ? 0.0722f : 0.114f, kg = 1.0f - kr - kb;
+   /* Y, C (centred) in [0,1] from the stored values */
+   const float ys = ycbcr_full ? 1.0f : 255.0f / 219.0f, yo = ycbcr_full ? 0.0f : -16.0f / 255.0f;
+   const float cs = ycbcr_full ? 1.0f : 255.0f / 224.0f, co = -128.0f / 255.0f;
+   /* R = y + 2(1-Kr) cr; G = y - 2Kb(1-Kb)/Kg cb - 2Kr(1-Kr)/Kg cr; B = y + 2(1-Kb) cb */
+   const float m[3][3] = {
+      { 1.0f, 0.0f, 2.0f * (1.0f - kr) },
+      { 1.0f, -2.0f * kb * (1.0f - kb) / kg, -2.0f * kr * (1.0f - kr) / kg },
+      { 1.0f, 2.0f * (1.0f - kb), 0.0f },
+   };
+   const float os = rgb_studio ? 219.0f / 255.0f : 1.0f, oo = rgb_studio ? 16.0f / 255.0f : 0.0f;
+
+   for (unsigned r = 0; r < 3; r++) {
+      float a = m[r][0] * ys, b = m[r][1] * cs, cc = m[r][2] * cs;
+      c->rgb[r][0] = a * os;
+      c->rgb[r][1] = b * os;
+      c->rgb[r][2] = cc * os;
+      c->rgb[r][3] = (a * yo + b * co + cc * co) * os + oo;
+   }
+}
+
+void *
+vcsc_create(struct pipe_context *pipe)
+{
+   const nir_shader_compiler_options *opts = pipe->screen->nir_options[MESA_SHADER_COMPUTE];
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, opts, "d3d10umd video csc");
+   nir_shader *s = b.shader;
+
+   s->info.workgroup_size[0] = VCSC_BLOCK;
+   s->info.workgroup_size[1] = VCSC_BLOCK;
+   s->info.workgroup_size[2] = 1;
+   s->info.num_textures = 1;
+   s->info.num_images = 1;
+   s->info.num_ubos = 1;
+   s->info.first_ubo_is_default_ubo = true;   /* constant buffer 0 = UBO 0 (panfrost asserts it) */
+   BITSET_SET(s->info.textures_used, 0);
+   BITSET_SET(s->info.textures_used_by_txf, 0);
+   BITSET_SET(s->info.images_used, 0);
+
+   nir_def *id = nir_iadd(&b, nir_imul(&b, nir_load_workgroup_id(&b), nir_imm_ivec3(&b, VCSC_BLOCK, VCSC_BLOCK, 1)),
+                          nir_load_local_invocation_id(&b));
+   nir_def *x = nir_channel(&b, id, 0), *y = nir_channel(&b, id, 1);
+   nir_def *size = nir_load_ubo(&b, 4, 32, nir_imm_int(&b, 0), nir_imm_int(&b, 0), .align_mul = 16,
+                                .align_offset = 0, .range_base = 0, .range = ~0u);
+   nir_def *w = nir_channel(&b, size, 0), *h = nir_channel(&b, size, 1), *layer = nir_channel(&b, size, 2);
+
+   nir_push_if(&b, nir_iand(&b, nir_ult(&b, x, w), nir_ult(&b, y, h)));
+   {
+      nir_def *cx = nir_iand_imm(&b, x, ~1u);
+      nir_def *cy = nir_iadd(&b, h, nir_ushr_imm(&b, y, 1));
+#define FETCH(px, py)                                                                                         \
+   nir_channel(&b, nir_txf(&b, nir_vec3(&b, px, py, layer), .lod = nir_imm_int(&b, 0), .texture_index = 0,    \
+                           .dim = GLSL_SAMPLER_DIM_2D, .is_array = true, .dest_type = nir_type_float32), 0)
+      nir_def *yuv1 = nir_vec4(&b, FETCH(x, y), FETCH(cx, cy), FETCH(nir_iadd_imm(&b, cx, 1), cy),
+                               nir_imm_float(&b, 1.0f));
+#undef FETCH
+      nir_def *rgb[3];
+      for (unsigned r = 0; r < 3; r++) {
+         nir_def *row = nir_load_ubo(&b, 4, 32, nir_imm_int(&b, 0), nir_imm_int(&b, 16 + 16 * r), .align_mul = 16,
+                                     .align_offset = 0, .range_base = 0, .range = ~0u);
+         rgb[r] = nir_fsat(&b, nir_fdot4(&b, row, yuv1));
+      }
+      nir_image_store(&b, nir_imm_int(&b, 0), nir_vec4(&b, x, y, nir_imm_int(&b, 0), nir_imm_int(&b, 0)),
+                      nir_undef(&b, 1, 32), nir_vec4(&b, rgb[0], rgb[1], rgb[2], nir_imm_float(&b, 1.0f)),
+                      nir_imm_int(&b, 0), .image_dim = GLSL_SAMPLER_DIM_2D, .image_array = false,
+                      .format = PIPE_FORMAT_R8G8B8A8_UNORM, .access = ACCESS_NON_READABLE,
+                      .src_type = nir_type_float32);
+   }
+   nir_pop_if(&b, NULL);
+
+   nir_validate_shader(s, "d3d10umd video csc");
+   struct pipe_compute_state cs = { 0 };
+   cs.ir_type = PIPE_SHADER_IR_NIR;
+   cs.prog = s;
+   return pipe->create_compute_state(pipe, &cs);
+}
diff --git a/src/gallium/frontends/d3d10umd/VideoCsc.h b/src/gallium/frontends/d3d10umd/VideoCsc.h
new file mode 100644
index 0000000..7c4d2f0
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/VideoCsc.h
@@ -0,0 +1,36 @@
+/*
+ * exynos-woa G17 V6c (notes/g17-dxva-mfc.md): the colour conversion kernel of the video processor. A compute shader
+ * reads an NV12 texture in the Resource::nv12_height layout (one R8 surface: luma rows, then interleaved CbCr rows)
+ * through sampler view 0 and writes RGBA8 into image 0 - compute state only, which a D3D10/10.1-level application
+ * never binds, so the video processor needs no state save/restore around it.
+ *
+ * Constant buffer 0 (vcsc_constants): the picture size, the layer, and a 3x4 matrix taking (Y, Cb, Cr, 1) in [0, 1]
+ * to RGB.
+ */
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pipe_context;
+
+struct vcsc_constants {
+   uint32_t width, luma_height, layer, pad;   /* pixels to convert; the CbCr rows start at luma_height */
+   float rgb[3][4];                           /* R, G, B = row . (Y, Cb, Cr, 1) */
+};
+
+#define VCSC_BLOCK 8u   /* workgroup: VCSC_BLOCK x VCSC_BLOCK threads, one pixel each */
+
+/* the kernel's compute state object (pipe->create_compute_state), NULL on failure */
+void *vcsc_create(struct pipe_context *pipe);
+
+/* fill the matrix for BT.601 (bt709 = 0) or BT.709 YCbCr, studio (16-235) or full range input, to full or studio range
+ * RGB */
+void vcsc_matrix(struct vcsc_constants *c, int bt709, int ycbcr_full, int rgb_studio);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/gallium/frontends/d3d10umd/VideoProc.cpp b/src/gallium/frontends/d3d10umd/VideoProc.cpp
new file mode 100644
index 0000000..41ae142
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/VideoProc.cpp
@@ -0,0 +1,658 @@
+/*
+ * exynos-woa G17 V6c (notes/g17-dxva-mfc.md): the D3D11 video processor of the Mali UMD - what Media Foundation's
+ * renderers and the Media Engine use to turn decoded NV12 into RGB (VideoProcessorBlt). One input stream, NV12 in
+ * (Resource::nv12_height layout), BGRA8 / RGBA8 out, scaling, source / destination / target rectangles, background
+ * colour, BT.601 / BT.709 studio or full range in, full or studio range RGB out. No deinterlacing (progressive only),
+ * no filters, no rotation, no stereo, no alpha modes beyond opaque.
+ *
+ * Blt = the colour conversion kernel (VideoCsc.c, compute state only) into an RGBA8 picture owned by the processor,
+ * then pipe->blit (driver-internal state handling) for scaling, format and the destination rectangle, and
+ * clear_render_target for the background - nothing the application bound is touched.
+ *
+ * MS Learn: D3D11_1DDI_VIDEODEVICEFUNCS / D3DWDDM2_0DDI_VIDEODEVICEFUNCS members of the same names; every VOID member
+ * here must not SetError for valid input (the runtime validates arguments before calling).
+ */
+
+#include "Draw.h"
+#include "Device.h"
+#include "Resource.h"
+#include "State.h"
+#include "D3D11.h"
+#include "VideoCsc.h"
+#include "VideoProc.h"
+
+#include "util/u_inlines.h"
+#include "util/u_sampler.h"
+
+extern "C" void malikm_tlog(const char *fmt, ...);
+
+struct VideoProcEnum {
+   D3D11_1DDI_VIDEO_PROCESSOR_CONTENT_DESC Desc;
+};
+
+struct VideoProcStream {
+   BOOL SrcEnabled, DstEnabled;
+   RECT Src, Dst;
+   BOOL Bt709, YCbCrFull;
+};
+
+struct VideoProcessor {
+   D3D11_1DDI_VIDEO_PROCESSOR_CONTENT_DESC Desc;
+   BOOL TargetEnabled;
+   RECT Target;
+   BOOL BgYCbCr;
+   D3D11_1DDI_VIDEO_COLOR Bg;
+   BOOL RgbStudio;            /* output RGB 16-235 */
+   VideoProcStream Stream;
+   void *Csc;                 /* compute state (VideoCsc.c), created at the first Blt */
+   struct pipe_resource *Rgb; /* the converted picture */
+   unsigned Blts;
+};
+
+struct VideoProcInputView {
+   D3D10DDI_HRESOURCE Resource;
+   UINT ArraySlice;
+};
+
+struct VideoProcOutputView {
+   D3D10DDI_HRESOURCE Resource;
+   UINT MipSlice, ArraySlice;
+};
+
+static VideoProcessor *
+VP(D3D11_1DDI_HVIDEOPROCESSOR h)
+{
+   return (VideoProcessor *)h.pDrvPrivate;
+}
+
+/* D3DDDI_COLOR_SPACE_TYPE (d3dukmdt.h) -> matrix / range of a YCbCr input, or of an RGB output */
+static void
+ColorSpace1(D3DDDI_COLOR_SPACE_TYPE cs, BOOL *bt709, BOOL *full)
+{
+   switch (cs) {
+   case D3DDDI_COLOR_SPACE_YCBCR_STUDIO_G22_LEFT_P601: *bt709 = FALSE; *full = FALSE; break;
+   case D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P601:   *bt709 = FALSE; *full = TRUE; break;
+   case D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_NONE_P709_X601: *bt709 = FALSE; *full = TRUE; break;
+   case D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P709:   *bt709 = TRUE; *full = TRUE; break;
+   case D3DDDI_COLOR_SPACE_RGB_FULL_G22_NONE_P709:     *bt709 = TRUE; *full = TRUE; break;
+   case D3DDDI_COLOR_SPACE_RGB_STUDIO_G22_NONE_P709:   *bt709 = TRUE; *full = FALSE; break;
+   default:                                            *bt709 = TRUE; *full = FALSE; break;   /* studio 709 */
+   }
+}
+
+static BOOL
+IsOutputFormat(DXGI_FORMAT f)
+{
+   return f == DXGI_FORMAT_B8G8R8A8_UNORM || f == DXGI_FORMAT_R8G8B8A8_UNORM || f == DXGI_FORMAT_B8G8R8X8_UNORM;
+}
+
+/* ---- enumerator and caps ---- */
+
+SIZE_T APIENTRY
+Vid_CalcPrivateVideoProcessorEnumSize(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEOPROCESSORENUM *p)
+{
+   (void)hDevice; (void)p;
+   return sizeof(VideoProcEnum);
+}
+
+HRESULT APIENTRY
+Vid_CreateVideoProcessorEnum(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEOPROCESSORENUM *p,
+                             D3D11_1DDI_HVIDEOPROCESSORENUM hEnum, D3D11_1DDI_HRTVIDEOPROCESSORENUM hRT)
+{
+   (void)hDevice; (void)hRT;
+   VideoProcEnum *e = (VideoProcEnum *)hEnum.pDrvPrivate;
+   e->Desc = p->Desc;
+   if (p->Desc.InputFrameFormat != D3D11_1DDI_VIDEO_FRAME_FORMAT_PROGRESSIVE) {
+      malikm_tlog("video: CreateVideoProcessorEnum: interlaced input not supported");
+      return E_INVALIDARG;
+   }
+   return S_OK;
+}
+
+VOID APIENTRY
+Vid_DestroyVideoProcessorEnum(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum)
+{
+   (void)hDevice; (void)hEnum;
+}
+
+VOID APIENTRY
+Vid_CheckVideoProcessorFormat(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum, DXGI_FORMAT Format,
+                              UINT *pSupported)
+{
+   (void)hDevice; (void)hEnum;
+   *pSupported = (Format == DXGI_FORMAT_NV12 ? D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT : 0) |
+                 (IsOutputFormat(Format) ? D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_OUTPUT : 0);
+}
+
+VOID APIENTRY
+Vid_GetVideoProcessorCaps(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum,
+                          D3D11_1DDI_VIDEO_PROCESSOR_CAPS *pCaps)
+{
+   (void)hDevice; (void)hEnum;
+   memset(pCaps, 0, sizeof(*pCaps));
+   pCaps->DeviceCaps = D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_RGB_RANGE_CONVERSION |
+                       D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_YCbCr_MATRIX_CONVERSION |
+                       D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_NOMINAL_RANGE;
+   pCaps->RateConversionCapsCount = 1;
+   pCaps->MaxInputStreams = 1;
+   pCaps->MaxStreamStates = 1;
+}
+
+VOID APIENTRY
+Vid_GetVideoProcessorRateConversionCaps(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum, UINT Index,
+                                        D3D11_1DDI_VIDEO_PROCESSOR_RATE_CONVERSION_CAPS *pCaps)
+{
+   (void)hDevice; (void)hEnum; (void)Index;
+   memset(pCaps, 0, sizeof(*pCaps));   /* one entry: progressive, no reference frames, no rate conversion */
+}
+
+VOID APIENTRY
+Vid_GetVideoProcessorCustomRate(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum, UINT ConvIndex,
+                                UINT RateIndex, D3D11_1DDI_VIDEO_PROCESSOR_CUSTOM_RATE *pRate)
+{
+   (void)hEnum; (void)ConvIndex; (void)RateIndex; (void)pRate;
+   SetError(hDevice, E_INVALIDARG);   /* CustomRateCount is 0: no valid index exists */
+}
+
+VOID APIENTRY
+Vid_GetVideoProcessorFilterRange(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum,
+                                 D3D11_1DDI_VIDEO_PROCESSOR_FILTER Filter, D3D11_1DDI_VIDEO_PROCESSOR_FILTER_RANGE *pRange)
+{
+   (void)hEnum; (void)Filter; (void)pRange;
+   SetError(hDevice, E_INVALIDARG);   /* FilterCaps is 0 */
+}
+
+VOID APIENTRY
+Vid_CheckVideoProcessorFormatConversion(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum,
+                                        D3DWDDM2_0DDI_CHECK_VIDEO_PROCESSOR_FORMAT_CONVERSION *p)
+{
+   (void)hDevice; (void)hEnum;
+   BOOL inYuv = p->InputColorSpace >= D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_NONE_P709_X601 &&
+                p->InputColorSpace <= D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P709;
+   BOOL outRgb = p->OutputColorSpace == D3DDDI_COLOR_SPACE_RGB_FULL_G22_NONE_P709 ||
+                 p->OutputColorSpace == D3DDDI_COLOR_SPACE_RGB_STUDIO_G22_NONE_P709;
+   p->Supported = p->InputFormat == DXGI_FORMAT_NV12 && inYuv && IsOutputFormat(p->OutputFormat) && outRgb;
+}
+
+/* ---- processor ---- */
+
+SIZE_T APIENTRY
+Vid_CalcPrivateVideoProcessorSize(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEOPROCESSOR *p)
+{
+   (void)hDevice; (void)p;
+   return sizeof(VideoProcessor);
+}
+
+HRESULT APIENTRY
+Vid_CreateVideoProcessor(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEOPROCESSOR *p,
+                         D3D11_1DDI_HVIDEOPROCESSOR hVP, D3D11_1DDI_HRTVIDEOPROCESSOR hRT)
+{
+   (void)hDevice; (void)hRT;
+   VideoProcessor *vp = VP(hVP);
+   memset(vp, 0, sizeof(*vp));
+   if (p->RateConversionCapsIndex != 0)
+      return E_INVALIDARG;
+   vp->Desc = ((VideoProcEnum *)p->hVideoProcessorEnum.pDrvPrivate)->Desc;
+   vp->Stream.Bt709 = vp->Desc.InputHeight > 576;   /* the D3D11 default stream colour space follows the size */
+   malikm_tlog("video: video processor %ux%u -> %ux%u created", vp->Desc.InputWidth, vp->Desc.InputHeight,
+               vp->Desc.OutputWidth, vp->Desc.OutputHeight);
+   return S_OK;
+}
+
+VOID APIENTRY
+Vid_DestroyVideoProcessor(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVP)
+{
+   VideoProcessor *vp = VP(hVP);
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   malikm_tlog("video: video processor destroyed after %u blts", vp->Blts);
+   if (vp->Csc)
+      pipe->delete_compute_state(pipe, vp->Csc);
+   pipe_resource_reference(&vp->Rgb, NULL);
+}
+
+VOID APIENTRY
+Vid_VideoProcessorSetOutputTargetRect(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVP, BOOL Enable,
+                                      const RECT *pRect)
+{
+   (void)hDevice;
+   VP(hVP)->TargetEnabled = Enable;
+   if (Enable && pRect)
+      VP(hVP)->Target = *pRect;
+}
+
+VOID APIENTRY
+Vid_VideoProcessorSetOutputBackgroundColor(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVP, BOOL YCbCr,
+                                           const D3D11_1DDI_VIDEO_COLOR *pColor)
+{
+   (void)hDevice;
+   VP(hVP)->BgYCbCr = YCbCr;
+   if (pColor)
+      VP(hVP)->Bg = *pColor;
+}
+
+VOID APIENTRY
+Vid_VideoProcessorSetOutputColorSpace(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVP,
+                                      const D3D11_1DDI_VIDEO_PROCESSOR_COLOR_SPACE *pCs)
+{
+   (void)hDevice;
+   VP(hVP)->RgbStudio = pCs->RGB_Range;   /* 0 full 0-255, 1 studio 16-235 */
+}
+
+VOID APIENTRY
+Vid_VideoProcessorSetOutputColorSpace1(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVP,
+                                       D3DDDI_COLOR_SPACE_TYPE ColorSpace)
+{
+   (void)hDevice;
+   BOOL bt709, full;
+   ColorSpace1(ColorSpace, &bt709, &full);
+   VP(hVP)->RgbStudio = !full;
+}
+
+VOID APIENTRY
+Vid_VideoProcessorSetOutputAlphaFillMode(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVP,
+                                         D3D11_1DDI_VIDEO_PROCESSOR_ALPHA_FILL_MODE Mode, UINT StreamIndex)
+{
+   (void)hDevice; (void)hVP; (void)Mode; (void)StreamIndex;   /* opaque output (FeatureCaps without ALPHA_FILL) */
+}
+
