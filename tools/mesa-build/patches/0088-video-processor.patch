+/* ---- Blt ---- */
+
+static BOOL
+ClipRect(RECT *r, LONG w, LONG h)
+{
+   r->left = MAX2(r->left, 0);
+   r->top = MAX2(r->top, 0);
+   r->right = MIN2(r->right, w);
+   r->bottom = MIN2(r->bottom, h);
+   return r->right > r->left && r->bottom > r->top;
+}
+
+HRESULT APIENTRY
+Vid_VideoProcessorBlt(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hVP,
+                      D3D11_1DDI_HVIDEOPROCESSOROUTPUTVIEW hOutput, UINT OutputFrame, UINT StreamCount,
+                      const D3D11_1DDI_VIDEO_PROCESSOR_STREAM *pStreams)
+{
+   (void)OutputFrame;
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   VideoProcessor *vp = VP(hVP);
+   VideoProcOutputView *ov = (VideoProcOutputView *)hOutput.pDrvPrivate;
+   Resource *out = CastResource(ov->Resource);
+   struct pipe_resource *dst = out->resource;
+   unsigned blt = vp->Blts++;
+   LARGE_INTEGER freq, t0, t1;   /* CPU time spent in Blt (logged) */
+   QueryPerformanceFrequency(&freq);
+   QueryPerformanceCounter(&t0);
+
+   /* the output area: the target rectangle (or the whole output), the background around the stream */
+   LONG ow = (LONG)u_minify(dst->width0, ov->MipSlice), oh = (LONG)u_minify(dst->height0, ov->MipSlice);
+   RECT target = vp->TargetEnabled ? vp->Target : RECT{ 0, 0, ow, oh };
+   if (!ClipRect(&target, ow, oh))
+      return S_OK;
+
+   const D3D11_1DDI_VIDEO_PROCESSOR_STREAM *s = StreamCount ? &pStreams[0] : NULL;
+   VideoProcInputView *iv = (s && s->Enable) ? (VideoProcInputView *)s->hInputSurface.pDrvPrivate : NULL;
+   Resource *in = iv ? CastResource(iv->Resource) : NULL;
+   RECT src = { 0, 0, 0, 0 }, dstr = target;
+   BOOL draw = FALSE;
+   if (in && in->resource && in->nv12_height) {
+      LONG iw = (LONG)in->resource->width0, ih = (LONG)in->nv12_height;
+      src = vp->Stream.SrcEnabled ? vp->Stream.Src : RECT{ 0, 0, iw, ih };
+      dstr = vp->Stream.DstEnabled ? vp->Stream.Dst : target;
+      draw = ClipRect(&src, iw, ih) && ClipRect(&dstr, ow, oh);
+   }
+
+   /* background: the target area the stream does not cover */
+   if (!draw || dstr.left > target.left || dstr.top > target.top || dstr.right < target.right ||
+       dstr.bottom < target.bottom) {
+      union pipe_color_union c;
+      if (vp->BgYCbCr) {
+         struct vcsc_constants k;
+         vcsc_matrix(&k, vp->Stream.Bt709, vp->Stream.YCbCrFull, vp->RgbStudio);
+         const float yuv[4] = { vp->Bg.YCbCr.Y, vp->Bg.YCbCr.Cb, vp->Bg.YCbCr.Cr, 1.0f };
+         for (unsigned i = 0; i < 3; i++)
+            c.f[i] = CLAMP(k.rgb[i][0] * yuv[0] + k.rgb[i][1] * yuv[1] + k.rgb[i][2] * yuv[2] + k.rgb[i][3], 0.0f,
+                           1.0f);
+      } else {
+         c.f[0] = vp->Bg.RGBA.R; c.f[1] = vp->Bg.RGBA.G; c.f[2] = vp->Bg.RGBA.B;
+      }
+      c.f[3] = 1.0f;
+      struct pipe_surface surf = {};
+      surf.format = dst->format;
+      surf.level = ov->MipSlice;
+      surf.first_layer = surf.last_layer = ov->ArraySlice;
+      surf.texture = dst;
+      pipe->clear_render_target(pipe, &surf, &c, target.left, target.top, target.right - target.left,
+                                target.bottom - target.top, false);
+   }
+   if (!draw)
+      return S_OK;
+
+   /* colour conversion of the whole input picture into the processor's RGBA8 picture */
+   unsigned iw = in->resource->width0, ih = in->nv12_height;
+   if (!vp->Csc && !(vp->Csc = vcsc_create(pipe))) {
+      malikm_tlog("video: video processor: no conversion kernel");
+      return E_FAIL;
+   }
+   if (!vp->Rgb || vp->Rgb->width0 < iw || vp->Rgb->height0 < ih) {
+      struct pipe_resource t = {};
+      t.target = PIPE_TEXTURE_2D;
+      t.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+      t.width0 = iw;
+      t.height0 = ih;
+      t.depth0 = 1;
+      t.array_size = 1;
+      t.bind = PIPE_BIND_SHADER_IMAGE | PIPE_BIND_SAMPLER_VIEW;
+      pipe_resource_reference(&vp->Rgb, NULL);
+      vp->Rgb = pipe->screen->resource_create(pipe->screen, &t);
+      if (!vp->Rgb)
+         return E_OUTOFMEMORY;
+   }
+   struct pipe_sampler_view tmpl;
+   u_sampler_view_default_template(&tmpl, in->resource, PIPE_FORMAT_R8_UNORM);
+   tmpl.target = PIPE_TEXTURE_2D_ARRAY;
+   tmpl.u.tex.first_layer = tmpl.u.tex.last_layer = iv->ArraySlice;
+   struct pipe_sampler_view *view = pipe->create_sampler_view(pipe, in->resource, &tmpl);
+   if (!view)
+      return E_FAIL;
+   struct pipe_image_view img = {};
+   img.resource = vp->Rgb;
+   img.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   img.access = img.shader_access = PIPE_IMAGE_ACCESS_WRITE;
+   struct vcsc_constants k = {};
+   k.width = iw;
+   k.luma_height = ih;
+   k.layer = 0;   /* the view starts at the input's array slice */
+   vcsc_matrix(&k, vp->Stream.Bt709, vp->Stream.YCbCrFull, vp->RgbStudio);
+   struct pipe_constant_buffer cb = {};
+   cb.user_buffer = &k;
+   cb.buffer_size = sizeof(k);
+
+   pipe->bind_compute_state(pipe, vp->Csc);
+   pipe->set_sampler_views(pipe, MESA_SHADER_COMPUTE, 0, 1, 0, &view);
+   pipe->set_shader_images(pipe, MESA_SHADER_COMPUTE, 0, 1, 0, &img);
+   pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, 0, &cb);
+   struct pipe_grid_info grid = {};
+   grid.work_dim = 2;
+   grid.block[0] = VCSC_BLOCK; grid.block[1] = VCSC_BLOCK; grid.block[2] = 1;
+   grid.grid[0] = DIV_ROUND_UP(iw, VCSC_BLOCK); grid.grid[1] = DIV_ROUND_UP(ih, VCSC_BLOCK); grid.grid[2] = 1;
+   pipe->launch_grid(pipe, &grid);
+   pipe->set_sampler_views(pipe, MESA_SHADER_COMPUTE, 0, 0, 1, NULL);
+   pipe->set_shader_images(pipe, MESA_SHADER_COMPUTE, 0, 0, 1, NULL);
+   pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, 0, NULL);
+   pipe->memory_barrier(pipe, PIPE_BARRIER_TEXTURE | PIPE_BARRIER_IMAGE | PIPE_BARRIER_FRAMEBUFFER);
+   pipe_sampler_view_reference(&view, NULL);
+
+   /* scale / place it: the driver's blit (its own state save and restore) */
+   struct pipe_blit_info b = {};
+   b.src.resource = vp->Rgb;
+   b.src.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   u_box_2d(src.left, src.top, src.right - src.left, src.bottom - src.top, &b.src.box);
+   b.dst.resource = dst;
+   b.dst.level = ov->MipSlice;
+   b.dst.format = dst->format;
+   u_box_3d(dstr.left, dstr.top, ov->ArraySlice, dstr.right - dstr.left, dstr.bottom - dstr.top, 1, &b.dst.box);
+   b.mask = PIPE_MASK_RGBA;
+   b.filter = PIPE_TEX_FILTER_LINEAR;
+   pipe->blit(pipe, &b);
+
+   QueryPerformanceCounter(&t1);
+   if (blt < 3 || (blt % 100) == 0)
+      malikm_tlog("video: blt %u: src %ld,%ld-%ld,%ld (%ux%u slice %u) -> dst %ld,%ld-%ld,%ld of %ldx%ld fmt %u, %s %s, "
+                  "%lld us", blt, src.left, src.top, src.right, src.bottom, iw, ih, iv->ArraySlice, dstr.left,
+                  dstr.top, dstr.right, dstr.bottom, ow, oh, (unsigned)out->Format, vp->Stream.Bt709 ? "709" : "601",
+                  vp->Stream.YCbCrFull ? "full" : "studio", (t1.QuadPart - t0.QuadPart) * 1000000 / freq.QuadPart);
+   return S_OK;
+}
