From 2c5b403585a5b905d83d7b6a5508ab918210fd59 Mon Sep 17 00:00:00 2001
From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Sat, 17 Oct 2026 08:56:54 +0300
Subject: [PATCH] d3d10umd video: expose the H.264 decode profile when the MFC
 device is present (exynos-woa 0091, G17 V6d2) - replaces the
 D3D10UMD_VIDEO_DEV development gate now that decode works

---
 src/gallium/frontends/d3d10umd/Video.cpp | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/gallium/frontends/d3d10umd/Video.cpp b/src/gallium/frontends/d3d10umd/Video.cpp
index c64e6b0..bf2301e 100644
--- a/src/gallium/frontends/d3d10umd/Video.cpp
+++ b/src/gallium/frontends/d3d10umd/Video.cpp
@@ -102,16 +102,18 @@ struct VideoOutputView {
    UINT ArraySlice;
 };
 
-/* Until V6b decodes into the output view the profile stays hidden: advertising it would make Media Foundation
- * (msmpeg2vdec) choose DXVA over its software decoder and present empty frames. D3D10UMD_VIDEO_DEV=1 exposes it to
- * test tools (d3dvdec) - a development gate, removed when the decode works. */
+/* The H.264 profile exists when the decoder does: the MFC device interface is present (checked once per process).
+ * Without it the profile stays hidden, so callers keep their software decoder instead of failing CreateVideoDecoder. */
 static BOOL
 VideoEnabled(void)
 {
    static int enabled = -1;
    if (enabled < 0) {
-      const char *v = getenv("D3D10UMD_VIDEO_DEV");
-      enabled = v && *v && *v != '0';
+      ULONG len = 0;
+      enabled = CM_Get_Device_Interface_List_SizeW(&len, (LPGUID)&kMfcInterface, NULL,
+                                                   CM_GET_DEVICE_INTERFACE_LIST_PRESENT) == CR_SUCCESS && len > 1;
+      malikm_tlog("video: MFC %s - H.264 decode profile %s", enabled ? "present" : "absent",
+                  enabled ? "exposed" : "hidden");
    }
    return enabled;
 }
