diff --git a/src/gallium/frontends/d3d10umd/State.h b/src/gallium/frontends/d3d10umd/State.h
index cbe68d4..9c4b0b7 100644
--- a/src/gallium/frontends/d3d10umd/State.h
+++ b/src/gallium/frontends/d3d10umd/State.h
@@ -198,6 +198,13 @@ struct Resource
    /* G17 (notes/g17-dxva-mfc.md): a flip-model swap chain buffer (created SHARED - DWM opens it): its presents must reach
     * the runtime (DXGI waits for the buffer releases), so the GDI fallback (DxgiFns.cpp gdi_present) is not used for it */
    bool flip_model;
+   /* exynos-woa G23 (notes/g23-bc-emulation.md): BCn emulation - the BCn format the data is decoded from (FormatBcDecode;
+    * PIPE_FORMAT_NONE = not emulated, the resource is in its own format). The pipe resource is in FormatBcBacking. Per
+    * subresource: the compressed buffer a Map hands out (allocated at the first map, kept; decoded into the resource
+    * at the Unmap of a write map) and the PIPE_MAP_* usage of the open map (0 = none). */
+   enum pipe_format bc_format;
+   uint8_t **bc_shadow;
+   unsigned *bc_map_usage;
 };
 
 
