From 801d1c13220ed8d77fcdc4a23b5346cbb5a671ce Mon Sep 17 00:00:00 2001
From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Sat, 17 Oct 2026 23:41:10 +0300
Subject: [PATCH 108/108] d3d10umd: trace the first 400 DDI calls of a process
 (exynos-woa 0108)

---
 src/gallium/frontends/d3d10umd/Debug.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/gallium/frontends/d3d10umd/Debug.cpp b/src/gallium/frontends/d3d10umd/Debug.cpp
index 5938fc8..5092e64 100644
--- a/src/gallium/frontends/d3d10umd/Debug.cpp
+++ b/src/gallium/frontends/d3d10umd/Debug.cpp
@@ -35,8 +35,15 @@ umd_entry_stat(const char *func)
    return NULL;
 }
 
+extern "C" void malikm_tlog(const char *fmt, ...);
+
 UmdEntryTimer::UmdEntryTimer(const char *f) : func(f), t0(0)
 {
+   /* exynos-woa G23: the first 400 outermost DDI calls of a process go to the trace log - which call came last before
+    * an application gave up (dgVoodoo's D3D11 init: no SetError, no runtime error visible) */
+   static volatile LONG ddi_logged;
+   if (umd_entry_depth == 0 && ddi_logged < 400 && InterlockedIncrement(&ddi_logged) <= 400)
+      malikm_tlog("DDI %s", f);
    if (umd_entry_depth++ == 0) {
       LARGE_INTEGER q;
       QueryPerformanceCounter(&q);
-- 
2.40.1.windows.1

