@@ -227,10 +245,10 @@ D3D11GetCaps(const D3D10_2DDIARG_GETCAPS *pData, HRESULT *phr)
       if (pData->DataSize < sizeof(D3D11DDI_SHADER_CAPS)) { *phr = E_INVALIDARG; return TRUE; }
       memset(pData->pData, 0, pData->DataSize);   /* no doubles */
       {
