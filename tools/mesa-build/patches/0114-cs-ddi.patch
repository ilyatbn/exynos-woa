@@ -0,0 +1,31 @@
+/*
+ * Compute.h --
+ *    exynos-woa G24: DirectCompute 4.x entry points (Compute.cpp).
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef COMPUTE_H
+#define COMPUTE_H
+
+#include "DriverIncludes.h"
+
+void APIENTRY CreateComputeShader(D3D10DDI_HDEVICE, const UINT *, D3D10DDI_HSHADER, D3D10DDI_HRTSHADER);
+void APIENTRY CsSetShader(D3D10DDI_HDEVICE, D3D10DDI_HSHADER);
+void APIENTRY CsSetShaderResources(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HSHADERRESOURCEVIEW *);
+void APIENTRY CsSetSamplers(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HSAMPLER *);
+void APIENTRY CsSetConstantBuffers(D3D10DDI_HDEVICE, UINT, UINT, const D3D10DDI_HRESOURCE *);
+SIZE_T APIENTRY CalcPrivateUnorderedAccessViewSize(D3D10DDI_HDEVICE, const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *);
+void APIENTRY CreateUnorderedAccessView(D3D10DDI_HDEVICE, const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *,
+                                        D3D11DDI_HUNORDEREDACCESSVIEW, D3D11DDI_HRTUNORDEREDACCESSVIEW);
+void APIENTRY DestroyUnorderedAccessView(D3D10DDI_HDEVICE, D3D11DDI_HUNORDEREDACCESSVIEW);
+void APIENTRY CsSetUnorderedAccessViews(D3D10DDI_HDEVICE, UINT, UINT, const D3D11DDI_HUNORDEREDACCESSVIEW *,
+                                        const UINT *);
+void APIENTRY Dispatch(D3D10DDI_HDEVICE, UINT, UINT, UINT);
+void APIENTRY DispatchIndirect(D3D10DDI_HDEVICE, D3D10DDI_HRESOURCE, UINT);
+void APIENTRY ClearUnorderedAccessViewUint(D3D10DDI_HDEVICE, D3D11DDI_HUNORDEREDACCESSVIEW, const UINT[4]);
+void APIENTRY ClearUnorderedAccessViewFloat(D3D10DDI_HDEVICE, D3D11DDI_HUNORDEREDACCESSVIEW, const FLOAT[4]);
+bool CreateBufferExShaderResourceView(D3D10DDI_HDEVICE, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *,
+                                      D3D10DDI_HSHADERRESOURCEVIEW);
+
+#endif /* COMPUTE_H */
diff --git a/src/gallium/frontends/d3d10umd/D3D11.cpp b/src/gallium/frontends/d3d10umd/D3D11.cpp
index de82936..0b243c4 100644
--- a/src/gallium/frontends/d3d10umd/D3D11.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D11.cpp
@@ -30,6 +30,7 @@
 #include "Debug.h"
 
 #include "D3D11.h"
+#include "Compute.h"   /* exynos-woa G24 */
 
 #include <string.h>
 #include <stdlib.h>
@@ -74,6 +75,7 @@ D11_CreateResource(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATERESOURCE *p
                    D3D10DDI_HRESOURCE hResource, D3D10DDI_HRTRESOURCE hRTResource)
 {
    CreateResource(hDevice, (const D3D10DDIARG_CREATERESOURCE *)pCreate, hResource, hRTResource);
+   CastResource(hResource)->byte_stride = pCreate->ByteStride;   /* exynos-woa G24: structured buffer views */
 }
 
 /* D3D11DDIARG_CREATESHADERRESOURCEVIEW = the D3D10.1 struct plus the BufferEx (raw/structured buffer) union member;
@@ -108,6 +110,8 @@ D11_CreateShaderResourceView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATES
                              D3D10DDI_HSHADERRESOURCEVIEW hView, D3D10DDI_HRTSHADERRESOURCEVIEW hRTView)
 {
    D3D10_1DDIARG_CREATESHADERRESOURCEVIEW v;
