+         if (!(no && *no == '1'))
             ((D3D11DDI_SHADER_CAPS *)pData->pData)->Caps |= D3D11DDICAPS_SHADER_COMPUTE_PLUS_RAW_AND_STRUCTURED_BUFFERS_IN_SHADER_4_X;
       }
       return TRUE;
diff --git a/src/gallium/frontends/d3d10umd/D3D11Tiers.inc b/src/gallium/frontends/d3d10umd/D3D11Tiers.inc
