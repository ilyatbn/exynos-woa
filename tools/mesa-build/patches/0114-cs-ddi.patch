@@ -55,13 +55,12 @@ SetConstantBuffers11(mesa_shader_stage stage, D3D10DDI_HDEVICE hDevice, UINT Sta
 D111_SETCB(VsSetConstantBuffers, MESA_SHADER_VERTEX)
 D111_SETCB(PsSetConstantBuffers, MESA_SHADER_FRAGMENT)
 D111_SETCB(GsSetConstantBuffers, MESA_SHADER_GEOMETRY)
-/* Hull/domain/compute exist only at pipeline level 11_0; nothing binds them at 10_0. */
+/* Hull/domain exist only at pipeline level 11_0; nothing binds them at 10_0. Compute 4.x is real since G24. */
 static void APIENTRY
