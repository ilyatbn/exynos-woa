diff --git a/src/gallium/frontends/d3d10umd/Compute.cpp b/src/gallium/frontends/d3d10umd/Compute.cpp
new file mode 100644
index 0000000..4f49e03
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/Compute.cpp
@@ -0,0 +1,328 @@
+/*
+ * Compute.cpp --
+ *    exynos-woa G24 (notes/g24-compute-cs4x.md): DirectCompute 4.x - compute shaders (cs_4_0 / cs_4_1), raw and
+ *    structured buffer views (SRV / UAV), Dispatch / DispatchIndirect, UAV clears - on the D3D11 DDI at feature level
+ *    10_x (D3D11DDICAPS_SHADER_COMPUTE_PLUS_RAW_AND_STRUCTURED_BUFFERS_IN_SHADER_4_X). MS Learn "Compute Shader
+ *    Overview", "Using Compute Shader on Direct3D 10.x Hardware": one UAV (raw or structured buffer), <= 768 threads per
+ *    group with Z = 1, 16 KB groupshared, no atomics, no doubles.
+ *
+ *    The DXBC is translated to TGSI (ShaderTGSI.c Shader_tgsi_translate_ex), then to NIR here (Panfrost takes NIR
+ *    compute CSOs only), with the groupshared size as static_shared_mem. Raw / structured t# and u# become SSBO
+ *    bindings 0..n-1 in declaration order (Shader_extra::buffers); Dispatch binds the current views to them.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "Compute.h"
+#include "Shader.h"
+#include "ShaderParse.h"
+#include "State.h"
+#include "Debug.h"
+#include "Format.h"
+
+#include "nir/tgsi_to_nir.h"
+#include "tgsi/tgsi_ureg.h"
+#include "util/format/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+
+extern "C" void malikm_tlog(const char *fmt, ...);
+
+
+static inline UnorderedAccessView *
+CastUnorderedAccessView(D3D11DDI_HUNORDEREDACCESSVIEW h)
+{
+   return static_cast<UnorderedAccessView *>(h.pDrvPrivate);
+}
+
+
+void APIENTRY
+CreateComputeShader(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode, D3D10DDI_HSHADER hShader,
+                    D3D10DDI_HRTSHADER hRTShader)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_context *pipe = pDevice->pipe;
+   Shader *pShader = CastShader(hShader);
+   (void)hRTShader;
+
+   memset(pShader, 0, sizeof *pShader);
+   pShader->type = MESA_SHADER_COMPUTE;
+   pShader->extra = (struct Shader_extra *)CALLOC_STRUCT(Shader_extra);
+   if (!pShader->extra) {
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   const struct tgsi_token *tokens = Shader_tgsi_translate_ex(pShaderCode, NULL, pShader->extra);
+   if (!tokens) {
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   nir_shader *nir = tgsi_to_nir(tokens, pipe->screen, false);
+   ureg_free_tokens(tokens);
+
+   struct pipe_compute_state cs;
+   memset(&cs, 0, sizeof cs);
+   cs.ir_type = PIPE_SHADER_IR_NIR;
+   cs.prog = nir;
+   cs.static_shared_mem = pShader->extra->shared_size;
+   pShader->handle = pipe->create_compute_state(pipe, &cs);
+
+   static unsigned logged;
+   if (logged++ < 16)
+      malikm_tlog("CreateComputeShader: group %ux%ux%u shared %u B buffers %u -> %p", pShader->extra->block[0],
+                  pShader->extra->block[1], pShader->extra->block[2], pShader->extra->shared_size,
+                  pShader->extra->num_buffers, pShader->handle);
+   if (!pShader->handle)
+      SetError(hDevice, E_OUTOFMEMORY);
+}
+
+
+void APIENTRY
+CsSetShader(D3D10DDI_HDEVICE hDevice, D3D10DDI_HSHADER hShader)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   Shader *pShader = hShader.pDrvPrivate ? CastShader(hShader) : NULL;
+
+   pDevice->bound_cs = pShader;
+   pDevice->pipe->bind_compute_state(pDevice->pipe, pShader ? pShader->handle : NULL);
+}
+
+
+void APIENTRY
+CsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumViews,
+                     const D3D10DDI_HSHADERRESOURCEVIEW *phViews)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_sampler_view **views = pDevice->sampler_views[MESA_SHADER_COMPUTE];
+
+   for (UINT i = 0; i < NumViews && StartSlot + i < PIPE_MAX_SHADER_SAMPLER_VIEWS; i++) {
+      ShaderResourceView *v = phViews[i].pDrvPrivate ? CastShaderResourceView(phViews[i]) : NULL;
+      pDevice->cs_srvs[StartSlot + i] = v;   /* raw / structured buffers: bound at Dispatch */
+      views[StartSlot + i] = v ? v->handle : NULL;
+   }
+   pDevice->pipe->set_sampler_views(pDevice->pipe, MESA_SHADER_COMPUTE, 0, PIPE_MAX_SHADER_SAMPLER_VIEWS, 0, views);
+}
+
+
+void APIENTRY
+CsSetSamplers(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumSamplers, const D3D10DDI_HSAMPLER *phSamplers)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   void **samplers = pDevice->samplers[MESA_SHADER_COMPUTE];
+
+   for (UINT i = 0; i < NumSamplers && StartSlot + i < PIPE_MAX_SAMPLERS; i++)
+      samplers[StartSlot + i] = CastPipeSamplerState(phSamplers[i]);
+   pDevice->pipe->bind_sampler_states(pDevice->pipe, MESA_SHADER_COMPUTE, 0, PIPE_MAX_SAMPLERS, samplers);
+}
+
+
+void APIENTRY
+CsSetConstantBuffers(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumBuffers, const D3D10DDI_HRESOURCE *phBuffers)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+
+   for (UINT i = 0; i < NumBuffers; i++) {
+      struct pipe_constant_buffer cb;
+      memset(&cb, 0, sizeof cb);
+      cb.buffer = CastPipeResource(phBuffers[i]);
+      cb.buffer_size = cb.buffer ? cb.buffer->width0 : 0;
+      pDevice->pipe->set_constant_buffer(pDevice->pipe, MESA_SHADER_COMPUTE, StartSlot + i, &cb);
+   }
+}
+
+
+SIZE_T APIENTRY
+CalcPrivateUnorderedAccessViewSize(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *pCreate)
+{
+   (void)hDevice;
+   (void)pCreate;
+   return sizeof(UnorderedAccessView);
+}
+
+
+/* Bytes per element of a buffer view: 4 for raw, the resource's structure stride for structured (format UNKNOWN),
+ * else the typed format's size. */
+static unsigned
+BufferViewElementSize(const Resource *r, DXGI_FORMAT format, bool raw)
+{
+   if (raw)
+      return 4;
+   if (format == DXGI_FORMAT_UNKNOWN)
+      return r->byte_stride;
+   enum pipe_format f = FormatTranslate(format, false);
+   return f == PIPE_FORMAT_NONE ? 4 : util_format_get_blocksize(f);
+}
+
+
+void APIENTRY
+CreateUnorderedAccessView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *pCreate,
+                          D3D11DDI_HUNORDEREDACCESSVIEW hView, D3D11DDI_HRTUNORDEREDACCESSVIEW hRTView)
+{
+   LOG_ENTRYPOINT();
+   UnorderedAccessView *u = CastUnorderedAccessView(hView);
+   (void)hRTView;
+
+   memset(u, 0, sizeof *u);
+   if (pCreate->ResourceDimension != D3D10DDIRESOURCE_BUFFER &&
+       pCreate->ResourceDimension != D3D11DDIRESOURCE_BUFFEREX) {
+      /* typed texture UAVs are cs_5_0 only - not offered at feature level 10_x */
+      LOG_UNSUPPORTED(true);
+      SetError(hDevice, E_NOTIMPL);
+      return;
+   }
+   Resource *r = CastResource(pCreate->hDrvResource);
+   unsigned es = BufferViewElementSize(r, pCreate->Format, !!(pCreate->Buffer.Flags & D3D11_DDI_BUFFER_UAV_FLAG_RAW));
+   pipe_resource_reference(&u->resource, r->resource);
+   u->offset = pCreate->Buffer.FirstElement * es;
+   u->size = pCreate->Buffer.NumElements * es;
+}
+
+
+void APIENTRY
+DestroyUnorderedAccessView(D3D10DDI_HDEVICE hDevice, D3D11DDI_HUNORDEREDACCESSVIEW hView)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   UnorderedAccessView *u = CastUnorderedAccessView(hView);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(pDevice->cs_uavs); i++)
+      if (pDevice->cs_uavs[i] == u)
+         pDevice->cs_uavs[i] = NULL;
+   pipe_resource_reference(&u->resource, NULL);
+}
+
+
+void APIENTRY
+CsSetUnorderedAccessViews(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumViews,
+                          const D3D11DDI_HUNORDEREDACCESSVIEW *phViews, const UINT *pUAVInitialCounts)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   (void)pUAVInitialCounts;   /* append / counter UAVs are cs_5_0 only */
+
+   for (UINT i = 0; i < NumViews && StartSlot + i < ARRAY_SIZE(pDevice->cs_uavs); i++)
+      pDevice->cs_uavs[StartSlot + i] = phViews[i].pDrvPrivate ? CastUnorderedAccessView(phViews[i]) : NULL;
+}
+
+
+/* Bind the current views to the bound compute shader's SSBO slots and launch. */
+static void
+LaunchCompute(Device *pDevice, UINT x, UINT y, UINT z, struct pipe_resource *indirect, unsigned indirect_offset)
+{
+   struct pipe_context *pipe = pDevice->pipe;
+   Shader *cs = pDevice->bound_cs;
+   if (!cs || !cs->handle || !cs->extra)
+      return;
+
+   const struct Shader_extra *ex = cs->extra;
+   struct pipe_shader_buffer bufs[SHADER_MAX_BUFFERS];
+   unsigned writable = 0;
+   memset(bufs, 0, sizeof bufs);
+   for (unsigned i = 0; i < ex->num_buffers; i++) {
+      if (ex->buffers[i].uav) {
+         UnorderedAccessView *u = pDevice->cs_uavs[ex->buffers[i].slot];
+         if (u) {
+            bufs[i].buffer = u->resource;
+            bufs[i].buffer_offset = u->offset;
+            bufs[i].buffer_size = u->size;
+         }
+         writable |= 1u << i;
+      } else {
+         ShaderResourceView *v = pDevice->cs_srvs[ex->buffers[i].slot];
+         if (v) {
+            bufs[i].buffer = v->buffer;
+            bufs[i].buffer_offset = v->buffer_offset;
+            bufs[i].buffer_size = v->buffer_size;
+         }
+      }
+   }
+   if (ex->num_buffers)
+      pipe->set_shader_buffers(pipe, MESA_SHADER_COMPUTE, 0, ex->num_buffers, bufs, writable);
+
+   struct pipe_grid_info info;
+   memset(&info, 0, sizeof info);
+   info.work_dim = 3;
+   info.block[0] = ex->block[0];
+   info.block[1] = ex->block[1];
+   info.block[2] = ex->block[2];
+   info.grid[0] = x;
+   info.grid[1] = y;
+   info.grid[2] = z;
+   info.indirect = indirect;
+   info.indirect_offset = indirect_offset;
+   pipe->launch_grid(pipe, &info);
+   /* D3D orders a dispatch's UAV writes before later work that reads the buffer */
+   pipe->memory_barrier(pipe, PIPE_BARRIER_ALL);
+
+   static unsigned logged;
+   if (logged++ < 8)
+      malikm_tlog("Dispatch %ux%ux%u (group %ux%ux%u, %u buffers%s)", x, y, z, ex->block[0], ex->block[1], ex->block[2],
+                  ex->num_buffers, indirect ? ", indirect" : "");
+}
+
+
+void APIENTRY
+Dispatch(D3D10DDI_HDEVICE hDevice, UINT ThreadGroupCountX, UINT ThreadGroupCountY, UINT ThreadGroupCountZ)
+{
+   LOG_ENTRYPOINT();
+   if (ThreadGroupCountX && ThreadGroupCountY && ThreadGroupCountZ)
+      LaunchCompute(CastDevice(hDevice), ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ, NULL, 0);
+}
+
+
+void APIENTRY
+DispatchIndirect(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hBufferForArgs, UINT AlignedByteOffsetForArgs)
+{
+   LOG_ENTRYPOINT();
+   LaunchCompute(CastDevice(hDevice), 0, 0, 0, CastPipeResource(hBufferForArgs), AlignedByteOffsetForArgs);
+}
+
+
+/* Raw / structured buffer UAVs: D3D fills every 32-bit element with Values[0] (MS Learn ClearUnorderedAccessViewUint:
+ * "for raw or structured buffers only the first value is used"). */
+void APIENTRY
+ClearUnorderedAccessViewUint(D3D10DDI_HDEVICE hDevice, D3D11DDI_HUNORDEREDACCESSVIEW hView, const UINT Values[4])
+{
+   LOG_ENTRYPOINT();
+   UnorderedAccessView *u = CastUnorderedAccessView(hView);
+   if (u->resource && u->size)
+      CastDevice(hDevice)->pipe->clear_buffer(CastDevice(hDevice)->pipe, u->resource, u->offset, u->size, &Values[0], 4);
+}
+
+
+void APIENTRY
+ClearUnorderedAccessViewFloat(D3D10DDI_HDEVICE hDevice, D3D11DDI_HUNORDEREDACCESSVIEW hView, const FLOAT Values[4])
+{
+   LOG_ENTRYPOINT();
+   UnorderedAccessView *u = CastUnorderedAccessView(hView);
+   if (u->resource && u->size)
+      CastDevice(hDevice)->pipe->clear_buffer(CastDevice(hDevice)->pipe, u->resource, u->offset, u->size, &Values[0], 4);
+}
+
+
+/* A raw (D3D11_DDI_BUFFEREX_SRV_FLAG_RAW) or structured (format UNKNOWN) buffer SRV: no sampler view - the byte range
+ * is bound as an SSBO by the shaders that declare it. Returns false for other views. */
+bool
+CreateBufferExShaderResourceView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pCreate,
+                                 D3D10DDI_HSHADERRESOURCEVIEW hView)
+{
+   (void)hDevice;
+   if (pCreate->ResourceDimension != D3D11DDIRESOURCE_BUFFEREX)
+      return false;
+   bool raw = !!(pCreate->BufferEx.Flags & D3D11_DDI_BUFFEREX_SRV_FLAG_RAW);
+   if (!raw && pCreate->Format != DXGI_FORMAT_UNKNOWN)
+      return false;   /* a typed buffer view: the normal sampler-view path */
+   ShaderResourceView *v = CastShaderResourceView(hView);
+   Resource *r = CastResource(pCreate->hDrvResource);
+   unsigned es = BufferViewElementSize(r, pCreate->Format, raw);
+   memset(v, 0, sizeof *v);
+   pipe_resource_reference(&v->buffer, r->resource);
+   v->buffer_offset = pCreate->BufferEx.FirstElement * es;
+   v->buffer_size = pCreate->BufferEx.NumElements * es;
+   return true;
+}
diff --git a/src/gallium/frontends/d3d10umd/Compute.h b/src/gallium/frontends/d3d10umd/Compute.h
