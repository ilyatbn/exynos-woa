    if (screen->is_format_supported(screen, f, PIPE_TEXTURE_2D, 0, 0, PIPE_BIND_SAMPLER_VIEW))
       return PIPE_FORMAT_NONE;   /* sampled natively: no emulation */
+   /* exynos-woa G26 (notes/g26-bc-etc2.md): re-compress to the ETC2 / EAC format of the same block size where the
+    * screen samples it (BcEtc.c) - the decoded RGBA8 backing took 4-8x the memory and ran NFSU2's 2 GB address space
+    * out. D3D10UMD_BC_DECODE=1 keeps the uncompressed backing: diagnosis only (AGENTS.md rule 12). */
+   static int force_decode = -1;
+   if (force_decode < 0) {
+      const char *e = getenv("D3D10UMD_BC_DECODE");
+      force_decode = e && *e == '1';
+   }
+   enum pipe_format etc = bcetc_target(FormatBcDecode(f));
+   if (etc != PIPE_FORMAT_NONE && !force_decode) {
+      if (util_format_is_srgb(f))
+         etc = util_format_srgb(etc);
+      if (etc != PIPE_FORMAT_NONE &&
+          screen->is_format_supported(screen, etc, PIPE_TEXTURE_2D, 0, 0, PIPE_BIND_SAMPLER_VIEW))
+         return etc;
+   }
    return b;
 }
 
