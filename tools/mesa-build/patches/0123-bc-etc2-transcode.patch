+/* exynos-woa G26 (notes/g26-bc-etc2.md): the BC -> ETC2 transcode of a large rectangle runs in bands of block rows on
+ * the process's Windows thread pool (games upload hundreds of 1024x1024 textures while loading; one core under WOW64
+ * emulation took ~1 s per BC3 texture). Every band writes its own rows only. */
+struct bcetc_job {
+   enum pipe_format bc, etc;
+   uint8_t *dst;
+   const uint8_t *src;
+   unsigned dst_stride, src_stride, w, h, rows_per_band, bands;
+   volatile LONG next;
+};
+
+static VOID CALLBACK
+bcetc_band(PTP_CALLBACK_INSTANCE, PVOID ctx, PTP_WORK)
+{
+   struct bcetc_job *j = (struct bcetc_job *)ctx;
+   for (;;) {
+      LONG b = InterlockedIncrement(&j->next) - 1;
+      if (b >= (LONG)j->bands)
+         return;
+      unsigned r0 = (unsigned)b * j->rows_per_band;
+      unsigned h0 = r0 * 4, hb = MIN2(j->rows_per_band * 4, j->h - h0);
+      bcetc_transcode(j->bc, j->etc, j->dst + (size_t)r0 * j->dst_stride, j->dst_stride,
+                      j->src + (size_t)r0 * j->src_stride, j->src_stride, j->w, hb);
+   }
+}
+
+static void
+bcetc_transcode_parallel(enum pipe_format bc, enum pipe_format etc, uint8_t *dst, unsigned dst_stride,
+                         const uint8_t *src, unsigned src_stride, unsigned w, unsigned h)
+{
+   unsigned rows = (h + 3) / 4, blocks = rows * ((w + 3) / 4);
+   static unsigned workers;
+   if (!workers) {
+      SYSTEM_INFO si;
+      GetSystemInfo(&si);
+      workers = CLAMP(si.dwNumberOfProcessors, 1, 8);
+      /* D3D10UMD_BC_THREADS=n: diagnosis only (AGENTS.md rule 12) - measures what the bands buy */
+      const char *e = getenv("D3D10UMD_BC_THREADS");
+      if (e && atoi(e) > 0)
+         workers = CLAMP((unsigned)atoi(e), 1, 8);
+      malikm_tlog("BC transcode: %u workers (%lu processors)", workers, (unsigned long)si.dwNumberOfProcessors);
+   }
+   struct bcetc_job j;
+   j.bc = bc; j.etc = etc; j.dst = dst; j.src = src;
+   j.dst_stride = dst_stride; j.src_stride = src_stride; j.w = w; j.h = h;
+   j.rows_per_band = MAX2(1, rows / (workers * 4));   /* ~4 bands per worker: an even spread */
+   j.bands = (rows + j.rows_per_band - 1) / j.rows_per_band;
+   j.next = 0;
+   PTP_WORK work = NULL;
+   if (blocks < 1024 || workers < 2 || j.bands < 2 || !(work = CreateThreadpoolWork(bcetc_band, &j, NULL))) {
+      bcetc_transcode(bc, etc, dst, dst_stride, src, src_stride, w, h);
+      return;
+   }
+   for (unsigned i = 1; i < workers; i++)
+      SubmitThreadpoolWork(work);
+   /* this thread takes bands too, then waits for the rest */
+   bcetc_band(NULL, &j, work);
+   WaitForThreadpoolWorkCallbacks(work, FALSE);
+   CloseThreadpoolWork(work);
+}
