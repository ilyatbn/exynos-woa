+++ b/src/gallium/frontends/d3d10umd/BcEtc.h
@@ -0,0 +1,40 @@
+/*
+ * exynos-woa G26 (notes/g26-bc-etc2.md): BC1-BC5 re-compressed to ETC2 / EAC on upload, for GPUs that sample ETC2 but
+ * not BCn (Mali-G76: TEXTURE_FEATURES0 bits 1-4 + 17-19 set, 7-16 clear). Every target block has the size and the 4x4
+ * texel footprint of its source block, so layouts, pitches and box arithmetic are those of the BC data:
+ *   BC1 RGB -> ETC2_RGB8, BC1 RGBA -> ETC2_RGB8A1 (punch-through), BC2 / BC3 -> ETC2_RGBA8 (EAC alpha),
+ *   BC4 U/S -> ETC2_R11 U/S (EAC), BC5 U/S -> ETC2_RG11 U/S.
+ * Bit layouts follow Mesa's own decoder (src/mesa/main/texcompress_etc.c, src/util/format/texcompress_etc_tmp.h).
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef BCETC_H
+#define BCETC_H
+
+#include "util/format/u_formats.h"
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The ETC2 / EAC format BCn data of format bc (a UNORM / SNORM BCn format; sRGB is the caller's business) is
+ * re-compressed to, PIPE_FORMAT_NONE if none. */
+enum pipe_format bcetc_target(enum pipe_format bc);
+
+/* Re-compress the w x h texel rectangle (whole 4x4 blocks: ceil(w/4) x ceil(h/4) of them) of BCn data src (src_stride =
+ * bytes per block row) to the ETC2 / EAC format etc (bcetc_target(bc), or its sRGB twin) at dst (dst_stride = bytes per
+ * block row). */
+void bcetc_transcode(enum pipe_format bc, enum pipe_format etc, uint8_t *dst, unsigned dst_stride,
+                     const uint8_t *src, unsigned src_stride, unsigned w, unsigned h);
+
+/* Single-block entry points (the PC test, tools/mesa-build/bcetc-test). rgba: 16 texels, row-major (y * 4 + x), RGBA8.
+ * v: 16 values, row-major, in the target's units (alpha 0..255, R11 unsigned 0..2047, signed -1023..1023). */
+void bcetc_encode_rgb(const uint8_t rgba[64], bool punchthrough, bool allow_individual, uint8_t out[8]);
+void bcetc_encode_eac(const int v[16], int kind /* 0 alpha8, 1 r11 unsigned, 2 r11 signed */, uint8_t out[8]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
