diff --git a/src/gallium/frontends/d3d10umd/GsEmu.cpp b/src/gallium/frontends/d3d10umd/GsEmu.cpp
new file mode 100644
index 0000000..efb8c4c
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/GsEmu.cpp
@@ -0,0 +1,326 @@
+/*
+ * exynos-woa G25 (notes/g25-geometry-shaders.md): geometry-shader emulation, see GsEmu.h.
+ *
+ * A draw with an emulated GS bound (n = input primitives over all instances, vpp = vertices per input primitive):
+ *  1. the application's draw with a stream-output variant of the bound VS (every output register r -> dwords
+ *     4r..4r+3 of buffer A) and rasterizer discard: A holds n * vpp vertices, primitives assembled;
+ *  2. index buffer I cleared to 0xffffffff, then the GS's compute shader: one invocation per primitive reads its
+ *     vertices from A, writes emitted vertices to B (fixed slots, maxout per primitive) and their indices / strip cuts
+ *     to I (2 * maxout per primitive); the GS's constant buffers are bound to the compute stage, CONST[15][0] = {n, VS
+ *     stride};
+ *  3. I drawn as an indexed point list / line strip / triangle strip with primitive restart through a passthrough VS
+ *     (attribute j = B register r, output = the GS output's semantic).
+ * Then the application's VS, rasterizer, compute and vertex state is put back.
+ * Limits: no GS samplers / resources, no stream output from the GS, strips with primitive restart in the
+ * application's indexed draw count as unbroken (the primitives past what stream output wrote read stale vertices).
+ * SPDX-License-Identifier: MIT
+ */
+#include "GsEmu.h"
+#include "State.h"
+#include "Shader.h"
+#include "ShaderParse.h"
+
+#include "cso_cache/cso_context.h"
+#include "tgsi/tgsi_scan.h"
+#include "tgsi/tgsi_ureg.h"
+#include "util/u_draw.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+
+extern "C" void malikm_tlog(const char *fmt, ...);
+
+struct GsEmu {
+   struct pipe_resource *a, *b, *i;
+   unsigned a_size, b_size, i_size;
+   struct pipe_stream_output_target *so;   /* on a */
+   void *rs_discard;
+};
+
+static unsigned
+prims_for(enum mesa_prim mode, unsigned c)
+{
+   switch (mode) {
+   case MESA_PRIM_POINTS: return c;
+   case MESA_PRIM_LINES: return c / 2;
+   case MESA_PRIM_LINE_STRIP: return c >= 2 ? c - 1 : 0;
+   case MESA_PRIM_TRIANGLES: return c / 3;
+   case MESA_PRIM_TRIANGLE_STRIP:
+   case MESA_PRIM_TRIANGLE_FAN: return c >= 3 ? c - 2 : 0;
+   case MESA_PRIM_LINES_ADJACENCY: return c / 4;
+   case MESA_PRIM_LINE_STRIP_ADJACENCY: return c >= 4 ? c - 3 : 0;
+   case MESA_PRIM_TRIANGLES_ADJACENCY: return c / 6;
+   case MESA_PRIM_TRIANGLE_STRIP_ADJACENCY: return c >= 6 ? (c - 4) / 2 : 0;
+   default: return 0;
+   }
+}
+
+/* Grow *res to at least size bytes (powers of two). */
+static bool
+ensure_buffer(struct pipe_screen *screen, struct pipe_resource **res, unsigned *cur, unsigned size, unsigned bind)
+{
+   if (*res && *cur >= size)
+      return true;
+   unsigned s = 4096;
+   while (s < size)
+      s *= 2;
+   pipe_resource_reference(res, NULL);
+   *res = pipe_buffer_create(screen, bind, PIPE_USAGE_DEFAULT, s);
+   *cur = *res ? s : 0;
+   return *res != NULL;
+}
+
+static struct GsEmu *
+gsemu_get(Device *dev)
+{
+   if (!dev->gs_emu) {
+      dev->gs_emu = CALLOC_STRUCT(GsEmu);
+      if (dev->gs_emu) {
+         struct pipe_rasterizer_state rs;
+         memset(&rs, 0, sizeof rs);
+         rs.rasterizer_discard = 1;
+         rs.half_pixel_center = 1;
+         rs.depth_clip_near = rs.depth_clip_far = 1;
+         dev->gs_emu->rs_discard = dev->pipe->create_rasterizer_state(dev->pipe, &rs);
+      }
+   }
+   return dev->gs_emu;
+}
+
+/* The VS with stream output of every output register r to dwords 4r..4r+3 (cached in the VS). */
+static bool
+make_so_vs(struct pipe_context *pipe, Shader *vs)
+{
+   struct tgsi_shader_info info;
+   tgsi_scan_shader(vs->state.tokens, &info);
+   if (!info.num_outputs || info.num_outputs > PIPE_MAX_SO_OUTPUTS)
+      return false;
+   struct pipe_shader_state st;
+   memset(&st, 0, sizeof st);
+   st.type = PIPE_SHADER_IR_TGSI;
+   st.tokens = vs->state.tokens;
+   unsigned regs = 0;
+   for (unsigned o = 0; o < info.num_outputs; o++) {
+      unsigned r = vs->output_mapping[o];
+      st.stream_output.output[o].register_index = o;
+      st.stream_output.output[o].start_component = 0;
+      st.stream_output.output[o].num_components = 4;
+      st.stream_output.output[o].output_buffer = 0;
+      st.stream_output.output[o].dst_offset = r * 4;
+      st.stream_output.output[o].stream = 0;
+      regs = MAX2(regs, r + 1);
+   }
+   st.stream_output.num_outputs = info.num_outputs;
+   st.stream_output.stride[0] = regs * 4;
+   vs->gs_so_vs = pipe->create_vs_state(pipe, &st);
+   vs->gs_so_regs = regs;
+   malikm_tlog("GS emulation: VS %p stream-output variant %p, %u outputs, %u registers", vs, vs->gs_so_vs,
+               info.num_outputs, regs);
+   return vs->gs_so_vs != NULL;
+}
+
+/* in j = B register r (the j-th used one) -> out with the GS output's semantic (cached in the GS). */
+static bool
+make_pt_vs(struct pipe_context *pipe, Shader *gs)
+{
+   const struct Shader_extra *ex = gs->extra;
+   struct ureg_program *u = ureg_create(MESA_SHADER_VERTEX);
+   if (!u)
+      return false;
+   unsigned j = 0;
+   for (unsigned r = 0; r < ex->gs_out_regs; r++) {
+      if (!ex->gs_out[r].used)
+         continue;
+      ureg_MOV(u, ureg_DECL_output(u, (enum tgsi_semantic)ex->gs_out[r].name, ex->gs_out[r].index),
+               ureg_DECL_vs_input(u, j++));
+   }
+   ureg_END(u);
+   gs->gs_pt_tokens = ureg_get_tokens(u, NULL);
+   ureg_destroy(u);
+   if (!gs->gs_pt_tokens)
+      return false;
+   struct pipe_shader_state st;
+   memset(&st, 0, sizeof st);
+   st.type = PIPE_SHADER_IR_TGSI;
+   st.tokens = gs->gs_pt_tokens;
+   gs->gs_pt_vs = pipe->create_vs_state(pipe, &st);
+   return gs->gs_pt_vs != NULL;
+}
+
+bool
+GsEmuDraw(Device *dev, const struct pipe_draw_info *info, const struct pipe_draw_start_count_bias *draw)
+{
+   Shader *gs = dev->bound_gs_emu, *vs = dev->bound_vs;
+   if (!gs || !gs->gs_cs || !gs->extra || !vs || !vs->handle || !vs->state.tokens)
+      return false;
+   struct pipe_context *pipe = dev->pipe;
+   const struct Shader_extra *ex = gs->extra;
+   unsigned inst = info->instance_count ? info->instance_count : 1;
+   unsigned n = prims_for((enum mesa_prim)info->mode, draw->count) * inst;
+   unsigned vpp = MAX2(ex->gs_vpp, 1), maxout = ex->gs_maxout;
+   if (!n || !maxout || !ex->gs_out_regs)
+      return true;   /* nothing a GS could emit */
+   if (!vs->gs_so_vs && !make_so_vs(pipe, vs))
+      return true;
+   if (!gs->gs_pt_vs && !make_pt_vs(pipe, gs))
+      return true;
+   struct GsEmu *e = gsemu_get(dev);
+   if (!e || !e->rs_discard)
+      return true;
+   unsigned vs_stride = vs->gs_so_regs * 16, gs_stride = ex->gs_out_regs * 16;
+   unsigned a_need = n * vpp * vs_stride, b_need = n * maxout * gs_stride, i_need = n * 2 * maxout * 4;
+   struct pipe_resource *old_a = e->a;
+   if (!ensure_buffer(pipe->screen, &e->a, &e->a_size, a_need, PIPE_BIND_STREAM_OUTPUT | PIPE_BIND_SHADER_BUFFER) ||
+       !ensure_buffer(pipe->screen, &e->b, &e->b_size, b_need, PIPE_BIND_VERTEX_BUFFER | PIPE_BIND_SHADER_BUFFER) ||
+       !ensure_buffer(pipe->screen, &e->i, &e->i_size, i_need, PIPE_BIND_INDEX_BUFFER | PIPE_BIND_SHADER_BUFFER))
+      return true;
+   if (!e->so || e->a != old_a) {
+      pipe_so_target_reference(&e->so, NULL);
+      e->so = pipe->create_stream_output_target(pipe, e->a, 0, e->a_size);
+      if (!e->so)
+         return true;
+   }
+
+   /* 1. VS outputs -> A */
+   pipe->bind_vs_state(pipe, vs->gs_so_vs);
+   pipe->bind_rasterizer_state(pipe, e->rs_discard);
+   unsigned zero = 0;
+   pipe->set_stream_output_targets(pipe, 1, &e->so, &zero, (enum mesa_prim)info->mode);
+   pipe->draw_vbo(pipe, info, 0, NULL, draw, 1);
+   pipe->set_stream_output_targets(pipe, 0, NULL, NULL, MESA_PRIM_UNKNOWN);
+   pipe->bind_rasterizer_state(pipe, dev->bound_rs);
+
+   /* 2. the GS as compute: A -> B, I */
+   uint32_t restart = 0xffffffffu;
+   pipe->clear_buffer(pipe, e->i, 0, i_need, &restart, 4);
+   pipe->bind_compute_state(pipe, gs->gs_cs);
+   struct pipe_shader_buffer sb[3];
+   memset(sb, 0, sizeof sb);
+   sb[0].buffer = e->a; sb[0].buffer_size = a_need;
+   sb[1].buffer = e->b; sb[1].buffer_size = b_need;
+   sb[2].buffer = e->i; sb[2].buffer_size = i_need;
+   pipe->set_shader_buffers(pipe, MESA_SHADER_COMPUTE, 0, 3, sb, 0x6);
+   for (unsigned s = 0; s < GS_EMU_TRACKED_CBS - 1; s++)
+      pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, s, &dev->tracked_cb[0][s]);
+   uint32_t param[4] = { n, vs_stride, 0, 0 };
+   struct pipe_constant_buffer pcb;
+   memset(&pcb, 0, sizeof pcb);
+   pcb.user_buffer = param;
+   pcb.buffer_size = sizeof param;
+   pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, GS_EMU_TRACKED_CBS - 1, &pcb);
+   struct pipe_grid_info grid;
+   memset(&grid, 0, sizeof grid);
+   grid.block[0] = ex->block[0] ? ex->block[0] : 64;
+   grid.block[1] = grid.block[2] = 1;
+   grid.grid[0] = (n + grid.block[0] - 1) / grid.block[0];
+   grid.grid[1] = grid.grid[2] = 1;
+   pipe->launch_grid(pipe, &grid);
+   pipe->memory_barrier(pipe, PIPE_BARRIER_VERTEX_BUFFER | PIPE_BARRIER_INDEX_BUFFER | PIPE_BARRIER_SHADER_BUFFER);
+   {
+      /* D3D10UMD_GS_DUMP=1: diagnosis only (AGENTS.md rule 12) - the first dwords of A, B and I after the GS pass */
+      static int dump = -1;
+      if (dump < 0) {
+         const char *v = getenv("D3D10UMD_GS_DUMP");
+         dump = v && *v == '1' ? 4 : 0;
+      }
+      if (dump > 0) {
+         dump--;
+         struct pipe_resource *bufs[3] = { e->a, e->b, e->i };
+         const char *nm[3] = { "A", "B", "I" };
+         for (int k = 0; k < 3; k++) {
+            struct pipe_transfer *t = NULL;
+            const uint32_t *m = (const uint32_t *)pipe_buffer_map_range(pipe, bufs[k], 0, 64, PIPE_MAP_READ, &t);
+            if (!m) {
+               malikm_tlog("GS dump %s: map failed", nm[k]);
+               continue;
+            }
+            malikm_tlog("GS dump %s: %08x %08x %08x %08x %08x %08x %08x %08x  %08x %08x %08x %08x %08x %08x %08x %08x",
+                        nm[k], m[0], m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8], m[9], m[10], m[11], m[12], m[13],
+                        m[14], m[15]);
+            pipe_buffer_unmap(pipe, t);
+         }
+      }
+   }
+   /* the application's compute state back (its CS buffers are bound at each Dispatch) */
+   pipe->set_shader_buffers(pipe, MESA_SHADER_COMPUTE, 0, 3, NULL, 0);
+   for (unsigned s = 0; s < GS_EMU_TRACKED_CBS; s++)
+      pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, s, &dev->tracked_cb[1][s]);
+   pipe->bind_compute_state(pipe, dev->bound_cs ? dev->bound_cs->handle : NULL);
+
+   /* 3. B through the passthrough VS, strips from I */
+   pipe->bind_vs_state(pipe, gs->gs_pt_vs);
+   struct cso_velems_state ve;
+   memset(&ve, 0, sizeof ve);
+   for (unsigned r = 0; r < ex->gs_out_regs; r++) {
+      if (!ex->gs_out[r].used)
+         continue;
+      struct pipe_vertex_element *el = &ve.velems[ve.count++];
+      el->src_offset = r * 16;
+      el->src_stride = gs_stride;
+      el->vertex_buffer_index = 0;
+      el->src_format = PIPE_FORMAT_R32G32B32A32_FLOAT;
+   }
+   cso_set_vertex_elements(dev->cso, &ve);
+   struct pipe_vertex_buffer vb;
+   memset(&vb, 0, sizeof vb);
+   vb.buffer.resource = e->b;
+   cso_set_vertex_buffers(dev->cso, 1, &vb);
+   struct pipe_draw_info di;
+   util_draw_init_info(&di);
+   di.mode = ex->gs_out_prim;
+   di.index_size = 4;
+   di.index.resource = e->i;
+   di.primitive_restart = true;
+   di.restart_index = 0xffffffffu;
+   struct pipe_draw_start_count_bias dd;
+   memset(&dd, 0, sizeof dd);
+   dd.count = n * 2 * maxout;
+   pipe->draw_vbo(pipe, &di, 0, NULL, &dd, 1);
+
+   /* the application's VS and vertex state back (ResolveState rebinds them at the next draw) */
+   pipe->bind_vs_state(pipe, vs->handle);
+   dev->velems_changed = TRUE;
+   dev->vbuffers_changed = TRUE;
+
+   static unsigned logged;
+   if (logged++ < 8)
+      malikm_tlog("GS emulation draw: mode %u count %u x%u -> %u primitives, maxout %u, out prim %u, VS stride %u, "
+                  "GS stride %u", (unsigned)info->mode, draw->count, inst, n, maxout, ex->gs_out_prim, vs_stride, gs_stride);
+   return true;
+}
+
+void
+GsEmuDestroyDevice(Device *dev)
+{
+   struct GsEmu *e = dev->gs_emu;
+   for (unsigned st = 0; st < 2; st++)
+      for (unsigned s = 0; s < GS_EMU_TRACKED_CBS; s++)
+         pipe_resource_reference(&dev->tracked_cb[st][s].buffer, NULL);
+   if (!e)
+      return;
+   pipe_so_target_reference(&e->so, NULL);
+   pipe_resource_reference(&e->a, NULL);
+   pipe_resource_reference(&e->b, NULL);
+   pipe_resource_reference(&e->i, NULL);
+   if (e->rs_discard)
+      dev->pipe->delete_rasterizer_state(dev->pipe, e->rs_discard);
+   FREE(e);
+   dev->gs_emu = NULL;
+}
+
+void
+GsEmuDestroyShader(Device *dev, Shader *shader)
+{
+   struct pipe_context *pipe = dev->pipe;
+   if (shader->type == MESA_SHADER_VERTEX && shader->gs_so_vs) {
+      pipe->delete_vs_state(pipe, shader->gs_so_vs);
+      shader->gs_so_vs = NULL;
+   }
+   if (shader->type == MESA_SHADER_GEOMETRY) {
+      if (shader->gs_pt_vs)
+         pipe->delete_vs_state(pipe, shader->gs_pt_vs);
+      shader->gs_pt_vs = NULL;
+      if (shader->gs_pt_tokens)
+         ureg_free_tokens(shader->gs_pt_tokens);
+      shader->gs_pt_tokens = NULL;
+   }
+}
