+ * runs three passes - the VS with stream output, the GS as compute, the emitted strips through a passthrough VS.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef GS_EMU_H
+#define GS_EMU_H
+
+#include "DriverIncludes.h"
+
+struct Device;
+struct Shader;
+struct pipe_draw_info;
+struct pipe_draw_start_count_bias;
+
+/* Draws info/draw through the emulated GS bound on dev (Device::bound_gs_emu); true when the draw was handled (also
+ * when there was nothing to draw), false when no emulated GS applies and the caller draws normally. */
+bool GsEmuDraw(struct Device *dev, const struct pipe_draw_info *info, const struct pipe_draw_start_count_bias *draw);
+
+/* Releases dev's emulation buffers (DestroyDevice). */
+void GsEmuDestroyDevice(struct Device *dev);
+
+/* Releases the per-shader objects (the VS stream-output variant, the GS passthrough VS) - DestroyShader. */
+void GsEmuDestroyShader(struct Device *dev, struct Shader *shader);
+
+#endif
