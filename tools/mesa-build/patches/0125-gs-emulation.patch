+/* ---- exynos-woa G25: geometry shader as a compute shader (notes/g25-geometry-shaders.md) ----
+ * One invocation per input primitive (64 per group). Prologue: primitive = group * 64 + thread, active = primitive <
+ * count, then every declared input register of every vertex is loaded from buffer 0 (the VS outputs the draw captured
+ * with stream output: vertex (primitive * vpp + k), register r at r * 16, VS stride CONST[15][0].y). Output registers
+ * are temporaries; EMIT stores them to buffer 1 (vertex slot primitive * maxout + emitted) and appends that slot to the
+ * index buffer 2 (primitive * 2 maxout + indices), CUT appends 0xffffffff (primitive restart). Emits past maxout and
+ * past the index space are dropped; inactive invocations (the group's tail) store nothing. */
+#define GS_BLOCK 64
+
+static void
+gs_prologue(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   struct Shader_extra *ex = sx->extra;
+   unsigned vpp = MAX2(ex->gs_vpp, 1);
+   sx->gs_prologue_done = true;
+
+   ureg_DECL_buffer(u, 0, false);
+   ureg_DECL_buffer(u, 1, false);
+   ureg_DECL_buffer(u, 2, false);
+   ureg_DECL_constant2D(u, 0, 0, 15);
+   sx->gs_param = ureg_src_dimension(ureg_src_register(TGSI_FILE_CONSTANT, 0), 15);
+
+   struct ureg_src tid = ureg_DECL_system_value(u, TGSI_SEMANTIC_THREAD_ID, 0);
+   struct ureg_src bid = ureg_DECL_system_value(u, TGSI_SEMANTIC_BLOCK_ID, 0);
+   struct ureg_dst st = sx->gs_state = ureg_DECL_temporary(u);
+   struct ureg_dst pc = sx->gs_primc = ureg_DECL_temporary(u);
+   ureg_UMAD(u, ureg_writemask(st, TGSI_WRITEMASK_X), ureg_scalar(bid, TGSI_SWIZZLE_X), ureg_imm1u(u, GS_BLOCK),
+             ureg_scalar(tid, TGSI_SWIZZLE_X));
+   ureg_USLT(u, ureg_writemask(st, TGSI_WRITEMASK_Y), ureg_scalar(ureg_src(st), TGSI_SWIZZLE_X),
+             ureg_scalar(sx->gs_param, TGSI_SWIZZLE_X));
+   ureg_MOV(u, ureg_writemask(st, TGSI_WRITEMASK_ZW), ureg_imm1u(u, 0));
+   ureg_UADD(u, ureg_writemask(pc, TGSI_WRITEMASK_X), ureg_scalar(sx->gs_param, TGSI_SWIZZLE_X), ureg_imm1i(u, -1));
+   ureg_UMIN(u, ureg_writemask(pc, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(st), TGSI_SWIZZLE_X),
+             ureg_scalar(ureg_src(pc), TGSI_SWIZZLE_X));
+
+   struct ureg_dst base = ureg_writemask(ureg_DECL_temporary(u), TGSI_WRITEMASK_X);
+   struct ureg_dst addr = ureg_writemask(ureg_DECL_temporary(u), TGSI_WRITEMASK_X);
+   for (unsigned r = 0; r < SHADER_MAX_INPUTS; r++)
+      if (sx->gs_in_declared[r])
+         sx->gs_in[r] = ureg_DECL_array_temporary(u, vpp, false);
+   for (unsigned k = 0; k < vpp; k++) {
+      /* byte address of vertex (primitive * vpp + k) */
+      ureg_UMAD(u, base, ureg_scalar(ureg_src(pc), TGSI_SWIZZLE_X), ureg_imm1u(u, vpp), ureg_imm1u(u, k));
+      ureg_UMUL(u, base, ureg_scalar(ureg_src(base), TGSI_SWIZZLE_X), ureg_scalar(sx->gs_param, TGSI_SWIZZLE_Y));
+      for (unsigned r = 0; r < SHADER_MAX_INPUTS; r++) {
+         if (!sx->gs_in_declared[r])
+            continue;
+         struct ureg_dst dst = ureg_dst_array_offset(sx->gs_in[r], (int)k);
+         if (sx->gs_in_siv[r] == D3D10_SB_NAME_PRIMITIVE_ID) {
+            ureg_MOV(u, dst, ureg_scalar(ureg_src(st), TGSI_SWIZZLE_X));
+            continue;
+         }
+         ureg_UADD(u, addr, ureg_scalar(ureg_src(base), TGSI_SWIZZLE_X), ureg_imm1u(u, r * 16));
+         struct ureg_src src[2] = { ureg_src_register(TGSI_FILE_BUFFER, 0), ureg_scalar(ureg_src(addr), TGSI_SWIZZLE_X) };
+         ureg_memory_insn(u, TGSI_OPCODE_LOAD, &dst, 1, src, 2, 0, TGSI_TEXTURE_BUFFER, PIPE_FORMAT_NONE);
+      }
+   }
+   ureg_release_temporary(u, base);
+   ureg_release_temporary(u, addr);
+}
+
+/* v[k][r] (or vPrim) as a source. */
+static struct ureg_src
+gs_input_src(struct Shader_xlate *sx, const struct Shader_operand *op)
+{
+   unsigned r = op->index_dim == 2 ? op->index[1].imm : op->index[0].imm;
+   if (r >= SHADER_MAX_INPUTS || !sx->gs_in_declared[r]) {
+      LOG_UNSUPPORTED(true);
+      return ureg_imm1f(sx->ureg, 0.0f);
+   }
+   if (op->index_dim == 2 && op->index[0].index_rep != D3D10_SB_OPERAND_INDEX_IMMEDIATE32) {
+      /* a relative vertex index: through the register's array */
+      struct ureg_src rel = translate_relative_operand(sx, &op->index[0].rel);
+      int off = op->index[0].index_rep == D3D10_SB_OPERAND_INDEX_IMMEDIATE32_PLUS_RELATIVE ? (int)op->index[0].imm : 0;
+      return ureg_src_indirect(ureg_src(ureg_dst_array_offset(sx->gs_in[r], off)), rel);
+   }
+   unsigned k = op->index_dim == 2 ? op->index[0].imm : 0;
+   return ureg_src(ureg_dst_array_offset(sx->gs_in[r], (int)k));
+}
+
+/* EMIT: store the output registers as vertex (primitive * maxout + emitted), append its index. */
+static void
+gs_emit(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   struct Shader_extra *ex = sx->extra;
+   unsigned maxout = MAX2(ex->gs_maxout, 1), stride = MAX2(ex->gs_out_regs, 1) * 16;
+   struct ureg_src st = ureg_src(sx->gs_state);
+   struct ureg_dst c = ureg_DECL_temporary(u);
+   /* c.x = active && emitted < maxout && indices < 2 maxout */
+   ureg_USLT(u, ureg_writemask(c, TGSI_WRITEMASK_Y), ureg_scalar(st, TGSI_SWIZZLE_Z), ureg_imm1u(u, maxout));
+   ureg_USLT(u, ureg_writemask(c, TGSI_WRITEMASK_Z), ureg_scalar(st, TGSI_SWIZZLE_W), ureg_imm1u(u, 2 * maxout));
+   ureg_AND(u, ureg_writemask(c, TGSI_WRITEMASK_X), ureg_scalar(st, TGSI_SWIZZLE_Y), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Y));
+   ureg_AND(u, ureg_writemask(c, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_X),
+            ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Z));
+   unsigned label = 0;
+   ureg_UIF(u, ureg_scalar(ureg_src(c), TGSI_SWIZZLE_X), &label);
+   {
+      /* c.y = vertex slot, c.z = its byte address, c.w = index byte address */
+      ureg_UMAD(u, ureg_writemask(c, TGSI_WRITEMASK_Y), ureg_scalar(st, TGSI_SWIZZLE_X), ureg_imm1u(u, maxout),
+                ureg_scalar(st, TGSI_SWIZZLE_Z));
+      ureg_UMUL(u, ureg_writemask(c, TGSI_WRITEMASK_Z), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Y), ureg_imm1u(u, stride));
+      for (unsigned r = 0; r < SHADER_MAX_OUTPUTS; r++) {
+         if (!ex->gs_out[r].used)
+            continue;
+         struct ureg_dst a = ureg_writemask(c, TGSI_WRITEMASK_W);
+         ureg_UADD(u, a, ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Z), ureg_imm1u(u, r * 16));
+         struct ureg_dst bst = ureg_dst(ureg_src_register(TGSI_FILE_BUFFER, 1));
+         struct ureg_src ss[2] = { ureg_scalar(ureg_src(c), TGSI_SWIZZLE_W), ureg_src(sx->gs_out[r]) };
+         ureg_memory_insn(u, TGSI_OPCODE_STORE, &bst, 1, ss, 2, 0, TGSI_TEXTURE_BUFFER, PIPE_FORMAT_NONE);
+      }
+      ureg_UMAD(u, ureg_writemask(c, TGSI_WRITEMASK_W), ureg_scalar(st, TGSI_SWIZZLE_X), ureg_imm1u(u, 2 * maxout),
+                ureg_scalar(st, TGSI_SWIZZLE_W));
+      ureg_UMUL(u, ureg_writemask(c, TGSI_WRITEMASK_W), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_W), ureg_imm1u(u, 4));
+      struct ureg_dst ist = ureg_writemask(ureg_dst(ureg_src_register(TGSI_FILE_BUFFER, 2)), TGSI_WRITEMASK_X);
+      struct ureg_src is[2] = { ureg_scalar(ureg_src(c), TGSI_SWIZZLE_W), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Y) };
+      ureg_memory_insn(u, TGSI_OPCODE_STORE, &ist, 1, is, 2, 0, TGSI_TEXTURE_BUFFER, PIPE_FORMAT_NONE);
+      ureg_UADD(u, ureg_writemask(sx->gs_state, TGSI_WRITEMASK_ZW), ureg_swizzle(st, TGSI_SWIZZLE_X, TGSI_SWIZZLE_Y,
+                TGSI_SWIZZLE_Z, TGSI_SWIZZLE_W), ureg_imm4u(u, 0, 0, 1, 1));
+   }
+   ureg_fixup_label(u, label, ureg_get_instruction_number(u));
+   ureg_ENDIF(u);
+   ureg_release_temporary(u, c);
+}
+
+/* CUT: append a primitive restart. */
+static void
+gs_cut(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   unsigned maxout = MAX2(sx->extra->gs_maxout, 1);
