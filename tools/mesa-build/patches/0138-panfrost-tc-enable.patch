From c9615c7b145ef51d3050e845dbf261ae0ada0d6b Mon Sep 17 00:00:00 2001
From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Sun, 18 Oct 2026 22:20:03 +0300
Subject: [PATCH] panfrost/d3d10umd: Gallium threaded context on
 (PIPE_CONTEXT_PREFER_THREADED), winsys marshalling hooks, DDI-entry pump, tc
 callback counts in the app report; MALIUMD_NO_TC=1 diagnosis switch
 (exynos-woa TC T4)

---
 src/gallium/drivers/panfrost/pan_context.c | 11 +++++++++++
 src/gallium/drivers/panfrost/pan_screen.c  |  4 ++++
 src/gallium/drivers/panfrost/pan_screen.h  |  3 +++
 src/gallium/frontends/d3d10umd/Debug.cpp   |  3 +++
 src/gallium/frontends/d3d10umd/Device.cpp  | 20 +++++++++++++++++++-
 src/gallium/frontends/d3d10umd/DxgiFns.cpp |  3 +++
 6 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/panfrost/pan_context.c b/src/gallium/drivers/panfrost/pan_context.c
index bd88a5f..1881461 100644
--- a/src/gallium/drivers/panfrost/pan_context.c
+++ b/src/gallium/drivers/panfrost/pan_context.c
@@ -1253,6 +1253,17 @@ panfrost_create_context(struct pipe_screen *screen, void *priv, unsigned flags)
    if (ret)
       goto failed;
 
+   /* exynos-woa TC T4 (notes/perf-threaded-context.md): every call goes through Gallium's threaded context and
+    * Panfrost runs on its driver thread. Synchronous flushes (no create_fence callback); no is_resource_busy, so
+    * every invalidation of a busy buffer gets new storage (panfrost_replace_buffer_storage). */
+   if (flags & PIPE_CONTEXT_PREFER_THREADED) {
+      struct pipe_context *tc = threaded_context_create(gallium, &pan_screen(screen)->transfer_pool,
+                                                        panfrost_replace_buffer_storage, NULL, NULL);
+      if (tc && tc != gallium)
+         ctx->tc_pipe = tc;
+      return tc;
+   }
+
    return gallium;
 
 failed:
diff --git a/src/gallium/drivers/panfrost/pan_screen.c b/src/gallium/drivers/panfrost/pan_screen.c
index 23659ae..dfa84c6 100644
--- a/src/gallium/drivers/panfrost/pan_screen.c
+++ b/src/gallium/drivers/panfrost/pan_screen.c
@@ -935,6 +935,7 @@ panfrost_destroy_screen(struct pipe_screen *pscreen)
    struct panfrost_screen *screen = pan_screen(pscreen);
 
    panfrost_resource_screen_destroy(pscreen);
+   slab_destroy_parent(&screen->transfer_pool);   /* exynos-woa TC T4 */
    panfrost_pool_cleanup(&screen->mempools.bin);
    panfrost_pool_cleanup(&screen->mempools.desc);
 
@@ -1014,6 +1015,9 @@ panfrost_create_screen(int fd, const struct pipe_screen_config *config,
    if (!screen)
       return NULL;
 
+   /* exynos-woa TC T4 */
+   slab_create_parent(&screen->transfer_pool, sizeof(struct panfrost_transfer), 16);
+
    struct panfrost_device *dev = pan_device(&screen->base);
 
    driParseConfigFiles(config->options, config->options_info,
diff --git a/src/gallium/drivers/panfrost/pan_screen.h b/src/gallium/drivers/panfrost/pan_screen.h
index 88382a1..7ea9842 100644
--- a/src/gallium/drivers/panfrost/pan_screen.h
+++ b/src/gallium/drivers/panfrost/pan_screen.h
@@ -7,6 +7,7 @@
 #ifndef PAN_SCREEN_H
 #define PAN_SCREEN_H
 
+#include "util/slab.h"
 #include <xf86drm.h>
 #include "pipe/p_defines.h"
 #include "pipe/p_screen.h"
@@ -114,6 +115,8 @@ struct panfrost_vtable {
 struct panfrost_screen {
    struct pipe_screen base;
    struct panfrost_device dev;
+   /* exynos-woa TC T4: the threaded context's transfer slabs (threaded_context_create) */
+   struct slab_parent_pool transfer_pool;
    struct {
       struct panfrost_pool bin;
       struct panfrost_pool desc;
diff --git a/src/gallium/frontends/d3d10umd/Debug.cpp b/src/gallium/frontends/d3d10umd/Debug.cpp
index e533722..248d642 100644
--- a/src/gallium/frontends/d3d10umd/Debug.cpp
+++ b/src/gallium/frontends/d3d10umd/Debug.cpp
@@ -36,6 +36,7 @@ umd_entry_stat(const char *func)
 }
 
 extern "C" void malikm_tlog(const char *fmt, ...);
+extern "C" void malikm_ddi_pump(void);   /* exynos-woa TC T4: malikm_drm.c T1 */
 
 UmdEntryTimer::UmdEntryTimer(const char *f) : func(f), t0(0)
 {
@@ -44,6 +45,8 @@ UmdEntryTimer::UmdEntryTimer(const char *f) : func(f), t0(0)
    static volatile LONG ddi_logged;
    if (umd_entry_depth == 0 && ddi_logged < 400 && InterlockedIncrement(&ddi_logged) <= 400)
       malikm_tlog("DDI %s", f);
+   if (umd_entry_depth == 0)
+      malikm_ddi_pump();   /* exynos-woa TC T4: run what the driver thread handed over (cheap when idle) */
    if (umd_entry_depth++ == 0) {
       LARGE_INTEGER q;
       QueryPerformanceCounter(&q);
diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index e64804d..c490890 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -46,6 +46,13 @@
 #include "Debug.h"
 #include "D3D11.h"
 extern "C" void malikm_tlog(const char *fmt, ...);   /* exynos-woa: malikm_drm.c */
+/* exynos-woa TC T4 (notes/perf-threaded-context.md): threaded context hooks (u_threaded_context.c) and the
+ * winsys runtime-callback marshalling (malikm_drm.c T1) */
+extern "C" void (*tc_driver_thread_hook)(void);
+extern "C" void (*tc_wait_hook)(void);
+extern "C" void malikm_mark_worker_thread(void);
+extern "C" void malikm_ddi_pump(void);
+extern "C" void malikm_marshal_enable(void);
 
 #include "util/u_sampler.h"
 #include "util/u_framebuffer.h"
@@ -175,7 +182,18 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    struct pipe_screen *screen = d3d10_create_screen();
    if (!screen)
       return E_OUTOFMEMORY;
-   struct pipe_context *pipe = screen->context_create(screen, NULL, 0);
+   /* exynos-woa TC T4: Panfrost on a driver thread (Gallium threaded context). The runtime callbacks it needs
+    * there run on this DDI thread (MS Learn pfnSetAsyncCallbacksCb: D3D10+ runtimes allow none from a worker).
+    * MALIUMD_NO_TC=1 turns it off - diagnosis only (AGENTS rule 12). */
+   unsigned ctx_flags = 0;
+   if (!debug_get_bool_option("MALIUMD_NO_TC", false)) {
+      tc_driver_thread_hook = malikm_mark_worker_thread;
+      tc_wait_hook = malikm_ddi_pump;
+      malikm_marshal_enable();
+      ctx_flags = PIPE_CONTEXT_PREFER_THREADED;
+   }
+   struct pipe_context *pipe = screen->context_create(screen, NULL, ctx_flags);
+   malikm_tlog("device: context %p threaded %d", (void *)pipe, pipe && pipe->priv ? 1 : 0);
    if (pipe)
       Shader_set_sample_position_source(pipe);   /* exynos-woa F2: samplepos table */
    pDevice->screen = screen;
diff --git a/src/gallium/frontends/d3d10umd/DxgiFns.cpp b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
index 0f71b3d..974de61 100644
--- a/src/gallium/frontends/d3d10umd/DxgiFns.cpp
+++ b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
@@ -42,6 +42,7 @@
 #include "util/u_inlines.h"
 
 extern "C" void malikm_ioctl_report(char *buf, size_t size, int n);   /* exynos-woa G21: malikm_drm.c */
+extern "C" void malikm_marshal_report(char *buf, size_t size);   /* exynos-woa TC T4: malikm_drm.c T1 */
 extern "C" void malikm_tlog(const char *fmt, ...);   /* exynos-woa H4: timing/event log (malikm_drm.c) */
 extern "C" void malikm_select_device(void *hRTDevice);   /* exynos-woa H5 (0060) */
 extern "C" int malikm_allocation_present(unsigned hAlloc, unsigned hDst, void *dxgi_context);   /* H4c (0055) */
@@ -281,6 +282,8 @@ _Present(DXGI_DDI_ARG_PRESENT *pPresentData)
             malikm_tlog("app umd calls %u: %s", n, umd_entry_calls_line);
             malikm_ioctl_report(top, sizeof top, 8);
             malikm_tlog("app ioctl top %u: %s", n, top);
+            malikm_marshal_report(top, sizeof top);
+            malikm_tlog("app %s", top);
             malikm_tlog("app pacing %u: wait mean %.0f max %.0f us, present mean %.0f max %.0f us, gaps <=25ms %u "
                         "<=50 %u <=100 %u <=250 %u more %u", n, sw / 120, mw, sp / 120, mp, h[0], h[1], h[2], h[3], h[4]);
             sw = mw = sp = mp = 0;
-- 
2.40.1.windows.1

