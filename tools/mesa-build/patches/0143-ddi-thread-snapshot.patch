From 9c8ca93dbd1e68c82104b0fb443fcda207441dca Mon Sep 17 00:00:00 2001
From: ilyatbn <ilyatbn@users.noreply.github.com>
Date: Sun, 18 Oct 2026 22:57:17 +0300
Subject: [PATCH] malikm: on a > 2 s driver-thread wait, snapshot the last DDI
 thread (eip + module-tagged stack scan) (exynos-woa TC T5 diagnosis aid)

---
 include/win32-compat/malikm_drm.c | 64 +++++++++++++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/include/win32-compat/malikm_drm.c b/include/win32-compat/malikm_drm.c
index f49e58b..5a217c0 100644
--- a/include/win32-compat/malikm_drm.c
+++ b/include/win32-compat/malikm_drm.c
@@ -1363,9 +1363,72 @@ mk_drain(void)
    ReleaseSRWLockExclusive(&mk_defer_lock);
 }
 
+/* exynos-woa TC T5 diagnosis: the thread that last entered the DDI, and what it is doing when the driver thread
+ * has waited > 2 s for it (suspended for the snapshot: instruction pointer + a stack scan for addresses inside any
+ * loaded module, module+offset, newest first). Module names only - nothing of Windows' own code is examined. */
+static volatile DWORD mk_ddi_tid;
+
+static void
+mk_log_addr(char *line, int *o, size_t size, uintptr_t v)
+{
+   HMODULE m = NULL;
+   char name[MAX_PATH];
+   if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR)v, &m) || !m || !GetModuleFileNameA(m, name, MAX_PATH))
+      return;
+   const char *b = strrchr(name, '\\');
+   *o += snprintf(line + *o, size - *o, " %s+%llx", b ? b + 1 : name, (unsigned long long)(v - (uintptr_t)m));
+}
+
+static void
+mk_snapshot_ddi_thread(void)
+{
+#if defined(_M_IX86)
+   DWORD tid = mk_ddi_tid;
+   HANDLE t = tid ? OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid)
+                  : NULL;
+   if (!t) {
+      malikm_tlog("tc: no DDI thread to inspect (tid %lu)", tid);
+      return;
+   }
+   static char line[3000];
+   int o = 0, found = 0;
+   line[0] = 0;
+   if (SuspendThread(t) != (DWORD)-1) {
+      CONTEXT c;
+      memset(&c, 0, sizeof c);
+      c.ContextFlags = CONTEXT_CONTROL;
+      if (GetThreadContext(t, &c)) {
+         o += snprintf(line + o, sizeof line - o, "eip");
+         mk_log_addr(line, &o, sizeof line, c.Eip);
+         o += snprintf(line + o, sizeof line - o, " | stack");
+         const uintptr_t *sp = (const uintptr_t *)(uintptr_t)c.Esp;
+         MEMORY_BASIC_INFORMATION mb;
+         uintptr_t top = (uintptr_t)sp;
+         if (VirtualQuery(sp, &mb, sizeof mb))
+            top = (uintptr_t)mb.BaseAddress + mb.RegionSize;
+         for (const uintptr_t *q = sp; (uintptr_t)(q + 1) <= top && found < 48 && o < (int)sizeof line - 80; q++) {
+            HMODULE m = NULL;
+            if (*q > 0x10000 &&
+                GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   (LPCSTR)*q, &m) && m) {
+               mk_log_addr(line, &o, sizeof line, *q);
+               found++;
+            }
+         }
+      }
+      ResumeThread(t);
+   }
+   CloseHandle(t);
+   malikm_tlog("tc: DDI thread %lu: %s", tid, line);
+#endif
+}
+
 void
 malikm_ddi_pump(void)
 {
+   if (!mk_worker && mk_on)
+      mk_ddi_tid = GetCurrentThreadId();
    if (mk_worker || (!mk_box && !mk_defer_n))
       return;
    mk_drain();
@@ -1428,6 +1491,7 @@ mk_call(struct mk_req *r)
       WaitForSingleObject(mk_done_ev, 500);
       if (!r->done && !logged && GetTickCount() - t0 > 2000) {
          malikm_tlog("tc: driver thread waits > 2 s for the DDI thread to run callback op %d", r->op);
+         mk_snapshot_ddi_thread();   /* exynos-woa TC T5 diagnosis */
          logged = 1;
       }
    }
-- 
