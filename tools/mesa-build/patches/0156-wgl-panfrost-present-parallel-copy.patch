@@ -137,6 +137,44 @@ static uint32_t *wgl_pan_bits;
 static size_t wgl_pan_bits_size;
 static SRWLOCK wgl_pan_bits_lock = SRWLOCK_INIT;   /* windows of other threads present concurrently */
 
+/* GL5 run 2: memcpy alone read the map at ~121 MB/s (36 ms per 1520x720 frame) - uncached reads are latency-bound
+ * per core, not width-bound. The rows are split over WGL_PAN_COPY_PARTS parts: this thread copies the first, thread
+ * pool callbacks the others. */
+#define WGL_PAN_COPY_PARTS 4
+struct wgl_pan_copy_part {
+   const uint8_t *src;
+   uint32_t *dst;
+   unsigned y0, y1, w, stride;
+   bool swizzle;
+};
+static struct wgl_pan_copy_part wgl_pan_parts[WGL_PAN_COPY_PARTS];
+static volatile LONG wgl_pan_parts_left;
+static HANDLE wgl_pan_parts_done;
+
+static void
+wgl_pan_copy_rows(const struct wgl_pan_copy_part *c)
+{
+   for (unsigned y = c->y0; y < c->y1; y++) {
+      uint32_t *dst = c->dst + (size_t)y * c->w;
+      memcpy(dst, c->src + (size_t)y * c->stride, (size_t)c->w * 4);
+      if (c->swizzle) {
+         for (unsigned x = 0; x < c->w; x++) {
+            uint32_t p = dst[x];
+            dst[x] = (p & 0xff00ff00u) | ((p & 0xffu) << 16) | ((p >> 16) & 0xffu);
+         }
+      }
+   }
+}
+
+static void CALLBACK
+wgl_pan_copy_cb(PTP_CALLBACK_INSTANCE inst, void *ctx)
+{
+   (void)inst;
+   wgl_pan_copy_rows((const struct wgl_pan_copy_part *)ctx);
+   if (InterlockedDecrement(&wgl_pan_parts_left) == 0)
+      SetEvent(wgl_pan_parts_done);
+}
+
