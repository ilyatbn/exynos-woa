-      memcpy(wgl_pan_bits, map, need);
-   } else {
-      for (unsigned y = 0; y < h; y++)
-         memcpy(wgl_pan_bits + (size_t)y * w, map + (size_t)y * xfer->stride, (size_t)w * 4);
+   if (!wgl_pan_parts_done)
+      wgl_pan_parts_done = CreateEventW(NULL, FALSE, FALSE, NULL);
+   unsigned parts = wgl_pan_parts_done && h >= 64 ? WGL_PAN_COPY_PARTS : 1;
+   for (unsigned i = 0; i < parts; i++) {
+      struct wgl_pan_copy_part *c = &wgl_pan_parts[i];
+      c->src = map;
+      c->dst = wgl_pan_bits;
+      c->y0 = h * i / parts;
+      c->y1 = h * (i + 1) / parts;
+      c->w = w;
+      c->stride = xfer->stride;
+      c->swizzle = !bgra;
    }
-   pipe_texture_unmap(ctx, xfer);
-   if (!bgra) {
-      for (size_t i = 0; i < (size_t)w * h; i++) {
-         uint32_t p = wgl_pan_bits[i];
-         wgl_pan_bits[i] = (p & 0xff00ff00u) | ((p & 0xffu) << 16) | ((p >> 16) & 0xffu);
+   wgl_pan_parts_left = (LONG)parts - 1;
+   /* Whichever part brings wgl_pan_parts_left to 0 signals the (auto-reset) event exactly once, and with more than
+    * one part this thread always waits for it once - so no signal is left over for the next frame. */
+   for (unsigned i = 1; i < parts; i++) {
+      if (!TrySubmitThreadpoolCallback(wgl_pan_copy_cb, &wgl_pan_parts[i], NULL)) {
+         wgl_pan_copy_rows(&wgl_pan_parts[i]);   /* no pool thread: copy it here */
+         if (InterlockedDecrement(&wgl_pan_parts_left) == 0)
+            SetEvent(wgl_pan_parts_done);
       }
    }
+   wgl_pan_copy_rows(&wgl_pan_parts[0]);
+   if (parts > 1)
+      WaitForSingleObject(wgl_pan_parts_done, INFINITE);
+   pipe_texture_unmap(ctx, xfer);
    QueryPerformanceCounter(&m1);
