+/*
+ * Copyright © 2026 exynos-woa
+ * SPDX-License-Identifier: MIT
+ *
+ * exynos-woa GL7b (notes/gl-icd.md): GPU-only present for the Panfrost OpenGL ICD through a DXGI swap chain.
+ */
+#ifndef WGL_PANFROST_FB_H
+#define WGL_PANFROST_FB_H
+
+#include <windows.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pipe_screen;
+struct stw_winsys_framebuffer;
+
+/* NULL when the window's pixel format or the D3D11 side does not allow it - the caller keeps its CPU present. */
+struct stw_winsys_framebuffer *
+wgl_panfrost_create_framebuffer(struct pipe_screen *screen, HWND hWnd, int iPixelFormat);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
