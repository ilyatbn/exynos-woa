diff --git a/src/gallium/frontends/d3d10umd/State.h b/src/gallium/frontends/d3d10umd/State.h
index 3be2d4a..14b97df 100644
--- a/src/gallium/frontends/d3d10umd/State.h
+++ b/src/gallium/frontends/d3d10umd/State.h
@@ -183,6 +183,19 @@ CastDevice(D3D10DDI_HDEVICE hDevice)
    return static_cast<Device *>(hDevice.pDrvPrivate);
 }
 
+/* exynos-woa G32 (0161, notes/games-unity.md): drop the frontend's reference through the context. Under Gallium's
+ * threaded context a plain pipe_resource_reference(&r, NULL) frees a resource at once while queued calls still name it
+ * (set_constant_buffer keeps the bare pointer, Mesa 26): Dave the Diver aborted in panfrost_set_constant_buffer on the
+ * driver thread (assert count != 1 = a freed buffer). pipe_context::resource_release "Following this call, the driver
+ * has full ownership of the resource" - the threaded context queues it behind the calls already recorded. */
+static inline void
+DeviceReleaseResource(struct pipe_context *pipe, struct pipe_resource **res)
+{
+   if (*res)
+      pipe_resource_release(pipe, *res);
+   *res = NULL;
+}
+
