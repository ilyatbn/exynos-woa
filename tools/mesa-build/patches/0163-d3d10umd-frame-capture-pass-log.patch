diff --git a/src/gallium/frontends/d3d10umd/FrameCap.cpp b/src/gallium/frontends/d3d10umd/FrameCap.cpp
new file mode 100644
index 0000000..e13f2dd
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/FrameCap.cpp
@@ -0,0 +1,208 @@
+/*
+ * Copyright 2026 exynos-woa
+ * SPDX-License-Identifier: MIT
+ *
+ * exynos-woa G32 (0163, notes/games-unity.md): one-frame pass log for rendering bugs. Dave the Diver's day scene
+ * renders black while its UI draws; the driver reports no error. A capture is armed by the file
+ * C:\S10eTmp\framecap.flg (checked every 30 presents; deleted when seen): the NEXT frame is written to the malikm tlog
+ * as one line per render pass (render targets: format, size, resource; depth; clears with colour; draws; the pixel
+ * shaders used (pointer + TGSI hash) and the blend states; the PS textures sampled (resource, format, size)) plus one
+ * line per copy. Diagnosis only: costs nothing while not armed.
+ */
+
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "Draw.h"
+#include "State.h"
+
+#include "util/format/u_format.h"
+#include "tgsi/tgsi_parse.h"
+
+extern "C" void malikm_tlog(const char *fmt, ...);
+
+#define FC_MAX_IDS 6
+
+struct fc_pass {
+   bool open;
+   unsigned index;
+   char rts[300];
+   unsigned clears, draws, instanced;
+   float clear_color[4];
+   void *ps[FC_MAX_IDS];
+   unsigned ps_n;
+   void *blend[FC_MAX_IDS];
+   unsigned blend_n;
+   struct pipe_resource *tex[FC_MAX_IDS];
+   unsigned tex_n;
+};
+
+static struct {
+   int armed;             /* 0 idle, 1 = capture from the next Present, 2 = capturing */
+   unsigned presents;
+   unsigned passes, copies;
+   struct fc_pass pass;
+   void *cur_ps;
+   void *cur_blend;
+} fc;
+
+static unsigned
+fc_hash(const struct pipe_shader_state *state)
+{
+   if (!state || !state->tokens)
+      return 0;
+   unsigned n = tgsi_num_tokens(state->tokens);
+   const uint32_t *t = (const uint32_t *)state->tokens;
+   uint32_t h = 2166136261u;
+   for (unsigned i = 0; i < n; i++) {
+      h ^= t[i];
+      h *= 16777619u;
+   }
+   return h;
+}
+
+static void
+fc_add(void **set, unsigned *n, void *p)
+{
+   for (unsigned i = 0; i < *n; i++)
+      if (set[i] == p)
+         return;
+   if (*n < FC_MAX_IDS)
+      set[(*n)++] = p;
+}
+
+static void
+fc_close_pass(void)
+{
+   struct fc_pass *p = &fc.pass;
+   if (!p->open)
+      return;
+   char ps[200] = "", tex[400] = "", bl[120] = "";
+   int o = 0;
+   for (unsigned i = 0; i < p->ps_n; i++) {
+      Shader *s = (Shader *)p->ps[i];
+      o += snprintf(ps + o, sizeof(ps) - o, "%s%p/%08x", i ? "," : "", p->ps[i], s ? fc_hash(&s->state) : 0);
+   }
+   o = 0;
+   for (unsigned i = 0; i < p->tex_n; i++) {
+      struct pipe_resource *r = p->tex[i];
+      o += snprintf(tex + o, sizeof(tex) - o, "%s%p %s %ux%u", i ? ", " : "", (void *)r,
+                    r ? util_format_short_name(r->format) : "-", r ? r->width0 : 0, r ? r->height0 : 0);
+   }
+   o = 0;
+   for (unsigned i = 0; i < p->blend_n; i++)
+      o += snprintf(bl + o, sizeof(bl) - o, "%s%p", i ? "," : "", p->blend[i]);
+   malikm_tlog("fc pass %u: %s; clears %u (last %.2f %.2f %.2f %.2f) draws %u (instanced %u) ps {%s} blend {%s} "
+               "tex {%s}", p->index, p->rts, p->clears, p->clear_color[0], p->clear_color[1], p->clear_color[2],
+               p->clear_color[3], p->draws, p->instanced, ps, bl, tex);
+   p->open = false;
+}
+
+static void
+fc_open_pass(Device *dev)
+{
+   struct fc_pass *p = &fc.pass;
+   memset(p, 0, sizeof(*p));
+   p->open = true;
+   p->index = fc.passes++;
+   int o = 0;
+   for (unsigned i = 0; i < dev->fb.nr_cbufs; i++) {
+      struct pipe_resource *r = dev->fb.cbufs[i].texture;
+      if (r)
+         o += snprintf(p->rts + o, sizeof(p->rts) - o, "rt%u %p %s %ux%u%s ", i, (void *)r,
+                       util_format_short_name(dev->fb.cbufs[i].format), r->width0, r->height0,
+                       r->nr_samples > 1 ? " ms" : "");
+   }
+   struct pipe_resource *z = dev->fb.zsbuf.texture;
+   if (z)
+      snprintf(p->rts + o, sizeof(p->rts) - o, "zs %p %s %ux%u", (void *)z, util_format_short_name(z->format),
+               z->width0, z->height0);
+   else if (!o)
+      snprintf(p->rts, sizeof(p->rts), "(no targets)");
+}
+
+void
+FrameCapPresent(Device *dev)
+{
+   if (fc.armed == 2) {
+      fc_close_pass();
+      malikm_tlog("fc end: %u passes, %u copies", fc.passes, fc.copies);
+      fc.armed = 0;
+      return;
+   }
+   if (fc.armed == 1) {
+      fc.armed = 2;
+      fc.passes = fc.copies = 0;
+      malikm_tlog("fc begin: fb %ux%u", dev->fb.width, dev->fb.height);
+      fc_open_pass(dev);
+      return;
+   }
+   if (++fc.presents % 30 == 0 && GetFileAttributesA("C:\\S10eTmp\\framecap.flg") != INVALID_FILE_ATTRIBUTES) {
+      DeleteFileA("C:\\S10eTmp\\framecap.flg");
+      fc.armed = 1;
+   }
+}
+
+void
+FrameCapRenderTargets(Device *dev)
+{
+   if (fc.armed != 2)
+      return;
+   fc_close_pass();
+   fc_open_pass(dev);
+}
+
+void
+FrameCapClear(Device *dev, const float color[4])
+{
+   if (fc.armed != 2)
+      return;
+   if (!fc.pass.open)
+      fc_open_pass(dev);
+   fc.pass.clears++;
+   memcpy(fc.pass.clear_color, color, sizeof(fc.pass.clear_color));
+}
+
+void
+FrameCapShaderPs(void *shader)
+{
+   fc.cur_ps = shader;
+}
+
+void
+FrameCapBlend(void *blend)
+{
+   fc.cur_blend = blend;
+}
+
+void
+FrameCapDraw(Device *dev, bool instanced)
+{
+   if (fc.armed != 2)
+      return;
+   if (!fc.pass.open)
+      fc_open_pass(dev);
+   fc.pass.draws++;
+   if (instanced)
+      fc.pass.instanced++;
+   fc_add(fc.pass.ps, &fc.pass.ps_n, fc.cur_ps);
+   fc_add(fc.pass.blend, &fc.pass.blend_n, fc.cur_blend);
+   for (unsigned s = 0; s < 4; s++) {
+      struct pipe_sampler_view *v = dev->sampler_views[MESA_SHADER_FRAGMENT][s];
+      if (v && v->texture)
+         fc_add((void **)fc.pass.tex, &fc.pass.tex_n, v->texture);
+   }
+}
+
+void
+FrameCapCopy(Resource *dst, Resource *src, const char *what)
+{
+   if (fc.armed != 2)
+      return;
+   fc.copies++;
+   struct pipe_resource *d = dst ? dst->resource : NULL, *s = src ? src->resource : NULL;
+   malikm_tlog("fc %s: dst %p %s %ux%u <- src %p %s %ux%u (in pass %u)", what, (void *)d,
+               d ? util_format_short_name(d->format) : "-", d ? d->width0 : 0, d ? d->height0 : 0, (void *)s,
+               s ? util_format_short_name(s->format) : "-", s ? s->width0 : 0, s ? s->height0 : 0, fc.pass.index);
+}
