+/* 0164: three pixels of a colour target, unpacked to float (or int) RGBA in the view's format */
+static void
+fc_readback(unsigned pass, unsigned i, struct pipe_resource *r, enum pipe_format fmt)
+{
+   Device *dev = fc.dev;
+   if (!dev || !r || r->target != PIPE_TEXTURE_2D || r->nr_samples > 1 || util_format_is_depth_or_stencil(fmt) ||
+       util_format_is_compressed(fmt))
+      return;
+   char line[400];
+   int o = snprintf(line, sizeof(line), "fc px %u rt%u %s:", pass, i, util_format_short_name(fmt));
+   for (unsigned k = 1; k <= 3; k++) {
+      unsigned x = r->width0 * k / 4, y = r->height0 * k / 4;
+      struct pipe_transfer *t = NULL;
+      const void *map = pipe_texture_map(dev->pipe, r, 0, 0, PIPE_MAP_READ, x, y, 1, 1, &t);
+      if (!map) {
+         o += snprintf(line + o, sizeof(line) - o, " (%u,%u) map failed", x, y);
+         continue;
+      }
+      union { float f[4]; int32_t i[4]; } v;
+      memset(&v, 0, sizeof(v));
+      util_format_unpack_rgba(fmt, &v, map, 1);
+      pipe_texture_unmap(dev->pipe, t);
+      if (util_format_is_pure_integer(fmt))
+         o += snprintf(line + o, sizeof(line) - o, " (%u,%u) %d %d %d %d", x, y, v.i[0], v.i[1], v.i[2], v.i[3]);
+      else
+         o += snprintf(line + o, sizeof(line) - o, " (%u,%u) %.3g %.3g %.3g %.3g", x, y, v.f[0], v.f[1], v.f[2],
+                       v.f[3]);
+   }
+   malikm_tlog("%s", line);
+}
