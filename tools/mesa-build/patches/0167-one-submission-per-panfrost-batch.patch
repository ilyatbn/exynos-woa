+/* exynos-woa G32 (0167): Panfrost's jm_submit_batch (Windows) hands a batch's vertex/tiler and fragment submits here
+ * as one submission. 0, or -1 with errno; ENOSYS = not on the WDDM path (Panfrost then submits them one by one). */
+int
+malikm_submit_pair(int fd, const struct drm_panfrost_submit *a, const struct drm_panfrost_submit *b)
+{
+   LARGE_INTEGER iq0, iq1;
+   QueryPerformanceCounter(&iq0);
+   wddm_lock_acquire();
+   if (wddm != 1) {
+      ReleaseSRWLockExclusive(&wddm_lock);
+      errno = ENOSYS;
+      return -1;
+   }
+   bind_switch(bind_for_fd(fd));
+   const struct drm_panfrost_submit *subs[2] = { a, b };
+   const uint32_t *bolists[2] = { (const uint32_t *)(uintptr_t)a->bo_handles,
+                                  (const uint32_t *)(uintptr_t)b->bo_handles };
+   int r = wddm_submit_jobs(subs, bolists, 2);
+   ReleaseSRWLockExclusive(&wddm_lock);
+   QueryPerformanceCounter(&iq1);
+   InterlockedAdd64(&wioctl_ticks[MALIKM_NR_PANFROST_SUBMIT & 0xFF], iq1.QuadPart - iq0.QuadPart);
+   InterlockedIncrement(&wioctl_calls[MALIKM_NR_PANFROST_SUBMIT & 0xFF]);
+   if (r < 0) {
+      errno = crt_errno(-r);
+      return -1;
+   }
+   return 0;
+}
