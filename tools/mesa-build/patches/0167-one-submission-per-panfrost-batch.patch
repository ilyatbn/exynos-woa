+/* exynos-woa G32 (0167, notes/games-unity.md): one Render for nsub Panfrost job chains (a batch's vertex/tiler and
+ * fragment chains: malikm_submit_pair), the KMD runs them in order (command.c Kick). The SUBMIT ioctl is nsub 1.
+ * Dave the Diver: 98 submissions/frame at ~105 us each (Render + the CPU-event signal). wddm_lock held. */
+static int
+wddm_submit_jobs(const struct drm_panfrost_submit *const *subs, const uint32_t *const *bolists, unsigned nsub)
+{
+   uint32_t batch_bos = 0;
+   for (unsigned k = 0; k < nsub; k++) {
+      if (!subs[k]->jc)
+         return -MK_EINVAL;
+      batch_bos += subs[k]->bo_handle_count;
+   }
+   if (nsub * sizeof(MW_COMMAND) > wcmd_size)
+      return -MK_E2BIG;
+   /* exynos-woa H2 (notes/gpu-hw-path.md): WDDM 1.x VidMm maps an allocation into the GPU's aperture only
+    * while a submission lists it, and an unlisted one may be unmapped (its pages can move). Panfrost assumes
+    * the Linux model - every BO stays mapped - and lists only the batch's own BOs, so a BO it reaches some
+    * other way (run h2a: an EXECUTE translation fault, fault status 0x240001c3) was never mapped. List the
+    * batch's BOs first (written), then every other live BO (read), each once. */
+   uint32_t gen = ++wsubmit_gen;
+   if (gen == 0)
+      gen = ++wsubmit_gen;
+   UINT n = 0;
+   for (unsigned k = 0; k < nsub; k++) {
+   const struct drm_panfrost_submit *a = subs[k];
+   const uint32_t *bos = bolists[k];
+   for (uint32_t i = 0; i < a->bo_handle_count; i++) {
+      struct wbo *bo = wddm_bo(bos[i]);
+      if (!bo)
+         return -MK_ENOENT;
+      /* exynos-woa G-game (0102): a sub-allocated BO is listed as its slab's allocation, once per submission */
+      uint32_t *mk = bo->sub ? &wslab[bo->sub - 1].mark : &bo->mark;
+      bo->idle = 0;   /* a batch that uses it is the authority (Panfrost sends WILLNEED first anyway) */
+      if (*mk == gen || bo->fixed || bo->gone)
+         continue;
+      if (n == walloc_size)
+         return -MK_E2BIG;
+      *mk = gen;
+      memset(&walloc[n], 0, sizeof(walloc[n]));
+      walloc[n].hAllocation = bo->h;
+      /* Panfrost does not say which BOs a batch writes. An opened buffer (another process's - a redirected
+       * swap chain buffer in DWM) is listed as read: the consumer only samples it (0075 test: listed as a write,
+       * DWM still lost each new device right after opening the app's buffers). */
+      walloc[n].WriteOperation = bo->runtime_owned != WBO_OPENED;
+      n++;
+   }
+   }
+   uint32_t skipped = 0;
+   /* exynos-woa G32 (0162, notes/games-unity.md): with WDDM 2.0 residency (0069: every BO MakeResident at creation)
+    * the other live BOs are not listed. MS Learn "Residency overview": "residency is moved to an explicit list on
+    * the device instead of the per-command buffer list. VidMm ensures that all allocations on a particular device
+    * residency requirement list are resident before any contexts belonging to that device are scheduled". Dave the
+    * Diver: ~1860 BOs listed in each of ~390 submissions/s, the runtime's Render 2.3 ms each = one core and ~6 fps.
+    * WDDM 1.x (resid -1) keeps H2's list. MALIKM_LIST_ALL=1 lists them again (diagnosis only). */
+   static int list_all = -1;
+   if (list_all < 0) {
+      const char *e = getenv("MALIKM_LIST_ALL");
+      list_all = e && *e == '1';
+   }
+   const int resident_model = (ddi.on ? ddi.resid : wresid) == 1 && !list_all && wresid_failed == 0;
+   for (uint32_t i = 0; !resident_model && i < wbo_cap; i++) {
+      if (!wbo[i].h)
+         continue;
+      uint32_t *mk = wbo[i].sub ? &wslab[wbo[i].sub - 1].mark : &wbo[i].mark;   /* G-game (0102) */
+      if (*mk == gen || wbo[i].fixed || wbo[i].gone || wbo[i].idle || wbo[i].runtime_owned == WBO_OPENED)
+         continue;
+      if (n == walloc_size) {
+         skipped++;
+         continue;
+      }
+      *mk = gen;
+      memset(&walloc[n], 0, sizeof(walloc[n]));
+      walloc[n].hAllocation = wbo[i].h;
+      n++;
+   }
+   if (skipped && (wlist_overflows++ == 0 || trace_on()))
+      fprintf(stderr, "malikm-wddm: allocation list full (%u slots): %u live BOs not listed\n", walloc_size,
+              skipped);
+   if (skipped && (wlist_overflows <= 4 || (wlist_overflows % 1000) == 0))   /* exynos-woa 0081: in the tlog too */
+      malikm_tlog("allocation list full (%u slots): %u live BOs not listed, %u batch BOs (overflow %u)", walloc_size,
+                  skipped, batch_bos, wlist_overflows);
+   MW_COMMAND *c = wcmd;
+   for (unsigned k = 0; k < nsub; k++) {   /* G32 (0167): the KMD runs a submission's chains in order */
+      c[k].Type = MW_CMD_JOB;
+      c[k].Slot = (subs[k]->requirements & PANFROST_JD_REQ_FS) ? 0 : 1;
+      c[k].Jc = subs[k]->jc;
+   }
+   wlist_want = n + skipped + 64;
+   LARGE_INTEGER rq0, rq1;
+   QueryPerformanceCounter(&rq0);
+   NTSTATUS st = w_render(nsub * sizeof(MW_COMMAND), n);
+   QueryPerformanceCounter(&rq1);
+   if (st < 0) {
+      static unsigned fails;
+      /* exynos-woa H5 (0058): run h3q - 174 "panfrost_batch_submit failed: 5" in Explorer with no reason */
+      if (fails++ < 8 || (fails % 100) == 0)
+         malikm_tlog("Render failed %u: 0x%08lx, %u allocations listed (list %u, skipped %u), %u BOs in the batch",
+                     fails, (unsigned long)st, n, walloc_size, skipped, batch_bos);
+      if (trace_on())
+         fprintf(stderr, "malikm-wddm: Render failed 0x%08lx\n", (unsigned long)st);
+      return -MK_EIO;
+   }
+   wseq++;
+   for (unsigned k = 0; k < nsub; k++)
+      for (uint32_t i = 0; i < subs[k]->bo_handle_count; i++) {   /* exynos-woa G21: what WAIT_BO waits for */
+         struct wbo *ubo = wddm_bo(bolists[k][i]);
+         if (ubo)
+            ubo->use_seq = wseq;
+      }
+   wdead_try_flush();   /* exynos-woa G17 VRAM (0101): earlier closes whose work has completed */
+   {
+      /* exynos-woa G17 (notes/g17-dxva-mfc.md): CPU time in the runtime's Render per submission (VidMm walks the
+       * allocation list on every call) - mean / max over the 500 submissions before each "submit" line */
+      static LARGE_INTEGER qf;
+      static double rsum, rmax;
+      if (!qf.QuadPart)
+         QueryPerformanceFrequency(&qf);
+      double us = (double)(rq1.QuadPart - rq0.QuadPart) * 1e6 / qf.QuadPart;
+      rsum += us;
+      if (us > rmax)
+         rmax = us;
+      if ((wseq % 500) == 0) {
+         malikm_tlog("submit %llu (%u allocations listed, %u live BOs): Render mean %.0f max %.0f us",
+                     (unsigned long long)wseq, n, n + skipped, rsum / 500, rmax);
+         /* exynos-woa G17 VRAM (0101, notes/g17-dxva-mfc.md): what this process's BOs are - own / idle (parked in
+          * Panfrost's BO cache) / opened (another process's) / runtime-owned shared - count and MB */
+         uint32_t cn[4] = {0}, big[4] = {0};
+         uint64_t cb[4] = {0};
+         for (uint32_t i = 0; i < wbo_cap; i++) {
+            if (!wbo[i].h || wbo[i].fixed || wbo[i].gone)
+               continue;
+            int k = wbo[i].runtime_owned == WBO_OPENED ? 2 : wbo[i].runtime_owned ? 3 : wbo[i].idle ? 1 : 0;
+            cn[k]++;
+            cb[k] += wbo[i].size;
+            if (wbo[i].size >= 4u << 20)
+               big[k]++;
+         }
+         malikm_tlog("BOs: own %u (%.1f MB, %u >= 4 MB) idle %u (%.1f MB, %u big) opened %u (%.1f MB) shared %u (%.1f MB) dead %u (%.1f MB)",
+                     cn[0], cb[0] / 1048576.0, big[0], cn[1], cb[1] / 1048576.0, big[1], cn[2], cb[2] / 1048576.0,
+                     cn[3], cb[3] / 1048576.0, wdead_n, wdead_bytes / 1048576.0);
+         rsum = rmax = 0;
+      }
+   }
+   return 0;
+}
