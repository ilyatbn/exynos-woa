index 2b416a0..6c32367 100644
--- a/include/win32-compat/malikm_drm.c
+++ b/include/win32-compat/malikm_drm.c
@@ -1906,6 +1906,33 @@ bind_for_device(HANDLE device)
    return -1;
 }
 
+/* exynos-woa G32 (0169, notes/games-unity.md): the KMD's MW_ESCAPE_CAPS (drivers/MaliG76Wddm include/maliwddm_abi.h;
+ * this tree's copy of the header predates it). MW_CAPS_DEFERRED_PRESENT: the KMD copies a present only after every
+ * earlier submission completed, so d3d10umd's Present need not wait for its frame. Asked once; an older KMD refuses the
+ * escape -> 0. */
+#ifndef MW_ESCAPE_CAPS
+#define MW_ESCAPE_CAPS 7
+#define MW_CAPS_DEFERRED_PRESENT 0x1u
+typedef struct { mw_u32 Code; mw_u32 Flags; } MW_ESCAPE_CAPS_DATA;
+#endif
+unsigned
+malikm_kmd_caps(void)
+{
+   static volatile LONG caps = -1;
+   if (caps >= 0)
+      return (unsigned)caps;
+   MW_ESCAPE_CAPS_DATA c = {0};
+   c.Code = MW_ESCAPE_CAPS;
+   wddm_lock_acquire();
+   bind_switch(tls_selected);   /* the device d3d10umd's Present selected */
+   NTSTATUS st = wddm == 1 ? w_escape(&c, sizeof(c)) : (NTSTATUS)0xC0000001;
+   ReleaseSRWLockExclusive(&wddm_lock);
+   LONG v = st >= 0 ? (LONG)(c.Flags & 0x7fffffff) : 0;
+   InterlockedExchange(&caps, v);
+   malikm_tlog("kmd caps: escape 0x%08lx flags 0x%lx", (unsigned long)st, (unsigned long)v);
+   return (unsigned)v;
+}
