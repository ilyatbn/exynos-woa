@@ -106,9 +106,50 @@ umd_section_ns(const char *name, long long ns)
 
 char umd_entry_calls_line[1500];   /* filled by umd_entry_report: the same interval, top by call count */
 
+/* exynos-woa G32 (0170, notes/games-unity.md): the frame-times spike report (FrameCap.cpp) diffs two snapshots of
+ * the counters around one slow frame without resetting them; umd_entry_report's reset bumps this generation so a diff
+ * across a reset is recognised (then the snapshot after the reset is the whole delta). */
+static volatile LONG umd_entry_gen;
+
+long
+umd_entry_snapshot(long long *ticks)
+{
+   long g = umd_entry_gen;
+   for (int i = 0; i < 256; i++)
+      ticks[i] = umd_entry_stats[i].ticks;
+   return g;
+}
+
+void
+umd_entry_diff_report(char *buf, size_t size, const long long *prev, const long long *cur, int reset, int n)
+{
+   LARGE_INTEGER f;
+   QueryPerformanceFrequency(&f);
+   long long d[256];
+   for (int i = 0; i < 256; i++)
+      d[i] = reset || cur[i] < prev[i] ? cur[i] : cur[i] - prev[i];
+   size_t len = 0;
+   buf[0] = 0;
+   for (int k = 0; k < n; k++) {
+      int best = -1;
+      for (int i = 0; i < 256; i++)
+         if (umd_entry_stats[i].func && d[i] > 0 && (best < 0 || d[i] > d[best]))
+            best = i;
+      if (best < 0 || len + 1 >= size)
+         break;
+      int w = snprintf(buf + len, size - len, "%s%s %.1f", k ? ", " : "", umd_entry_stats[best].func,
+                       (double)d[best] * 1e3 / f.QuadPart);
+      if (w < 0)
+         break;
+      len += (size_t)w < size - len ? (size_t)w : size - len - 1;
+      d[best] = 0;
+   }
+}
+
