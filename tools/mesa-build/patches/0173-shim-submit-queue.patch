+   const uint32_t *bl[WQ_MAX];
+   unsigned n = wq_n;
+   for (unsigned k = 0; k < n; k++) {
+      subs[k] = &wq[k].s;
+      bl[k] = wq[k].bos;
+   }
+   wq_n = 0;   /* before the submit: nothing below may flush again */
+   wq_bos = 0;
