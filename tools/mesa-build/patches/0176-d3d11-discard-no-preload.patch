 /* ---- the tables ---- */
 
+/* exynos-woa G32 (0176, notes/games-unity.md): ID3D11DeviceContext1::DiscardResource / DiscardView. MS Learn
+ * PFND3D11_1DDI_DISCARD: the contents become undefined - Unity uses it for "don't care" load actions. Panfrost reloads
+ * (preloads) a render target's old contents into the tile buffer whenever a batch draws to it and the level is
+ * valid; after a discard that load is wasted bandwidth on a GPU-bound frame. Whole-resource discards (no rects; a view
+ * only when it covers the whole single-level, single-layer texture) go to pipe->invalidate_resource (queued by the
+ * threaded context), which Panfrost now also uses to mark the levels invalid (no preload). Partial discards and
+ * buffers are ignored: keeping the contents is always correct. */
+static VOID APIENTRY
+Discard(D3D10DDI_HDEVICE hDevice, D3D11DDI_HANDLETYPE HandleType, VOID *hResourceOrView, const D3D10_DDI_RECT *pRects,
+        UINT NumRects)
+{
+   LOG_ENTRYPOINT();
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   struct pipe_resource *res = NULL;
+   const struct pipe_surface *surf = NULL;
+   if (!hResourceOrView || (pRects && NumRects) || !pipe->invalidate_resource)
+      return;
+   switch (HandleType) {
+   case D3D10DDI_HT_RESOURCE: {
+      D3D10DDI_HRESOURCE h = { hResourceOrView };
+      res = CastResource(h)->resource;
+      break;
+   }
+   case D3D10DDI_HT_RENDERTARGETVIEW: {
+      D3D10DDI_HRENDERTARGETVIEW h = { hResourceOrView };
+      surf = &CastRenderTargetView(h)->surface;
+      break;
+   }
+   case D3D10DDI_HT_DEPTHSTENCILVIEW: {
+      D3D10DDI_HDEPTHSTENCILVIEW h = { hResourceOrView };
+      surf = &CastDepthStencilView(h)->surface;
+      break;
+   }
+   default:
+      return;
+   }
+   if (surf) {
+      res = surf->texture;
+      if (!res || surf->level != 0 || surf->first_layer != 0 || surf->last_layer != 0 || res->last_level != 0 ||
+          res->array_size > 1)
+         return;
+   }
+   if (!res || res->target == PIPE_BUFFER)
+      return;
+   pipe->invalidate_resource(pipe, res);
+}
