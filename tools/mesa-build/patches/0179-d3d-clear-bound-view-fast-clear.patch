  * ----------------------------------------------------------------------
  */
 
+/* exynos-woa G32 (0179, notes/games-unity.md): Panfrost's clear_render_target / clear_depth_stencil draw a quad with
+ * u_blitter - that batch first PRELOADS the old contents from memory, then overwrites them. Dave the Diver (Unity, GPU
+ * at 92 %) cleared every target that way: 0 MP of batch clears, ~19 MP colour + ~15 MP depth preloaded per frame. A
+ * D3D clear of a view that is bound right now, covering the whole framebuffer, is the same as pipe->clear, which
+ * Panfrost folds into the batch for free (tile buffer starts at the clear value, nothing loaded) while the batch has
+ * no draws yet. Same texture, level, layers and format as the bound attachment; the framebuffer exactly the view's
+ * size (pipe->clear covers the framebuffer). Anything else keeps the old path. */
+static bool
+SameSurface(const struct pipe_surface *a, const struct pipe_surface *b)
+{
+   return a->texture && a->texture == b->texture && a->format == b->format && a->level == b->level &&
+          a->first_layer == b->first_layer && a->last_layer == b->last_layer;
+}
