+static void
+ClearStat(const char *name, long long)
+{
+   static const char *names[12];
+   static unsigned counts[12], total;
+   unsigned i;
+   for (i = 0; i < 12 && names[i] && names[i] != name; i++)
+      ;
+   if (i == 12)
+      return;
+   names[i] = name;
+   counts[i]++;
+   if (++total == 500) {
+      char line[600];
+      int o = 0;
+      for (unsigned k = 0; k < 12 && names[k] && o < (int)sizeof line - 60; k++) {
+         o += snprintf(line + o, sizeof line - o, "%s%s %u", k ? ", " : "", names[k], counts[k]);
+         counts[k] = 0;
+      }
+      malikm_tlog("clears 500: %s", line);
+      total = 0;
+   }
+}
