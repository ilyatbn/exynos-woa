       double a = (double)fb.width * fb.height / 1e6;
       n++;
@@ -740,6 +740,14 @@ panfrost_batch_submit(struct panfrost_context *ctx,
       for (unsigned i = 0; i < fb.rt_count; i++) {
          if (!fb.rts[i].view)
             continue;
