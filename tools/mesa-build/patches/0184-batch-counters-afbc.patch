@@ -727,7 +727,7 @@ panfrost_batch_submit(struct panfrost_context *ctx,
        * framebuffers, colour / depth-stencil pixels preloaded (read from memory into the tile buffer), cleared, and
        * written back, and multisampled batches. Megapixels per batch; a full 1520x720 target is 1.09 MP. */
       extern void malikm_tlog(const char *fmt, ...);
