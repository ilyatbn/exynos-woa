 /* 0183 (diagnosis): which path the clears take - every 500 clears a tlog line "clears 500: name n, ..." */
 extern "C" void malikm_tlog(const char *fmt, ...);
+
+/* 0187: a D3D clear of a view that is NOT bound (or not the framebuffer's size): bind a framebuffer holding only that
+ * view, pipe->clear it (Panfrost: a batch that starts at the clear value and only writes the target - no preload, no
+ * quad), then put the device's framebuffer back. Instead of u_blitter's quad batch that preloads, draws and stores. */
+static void
+ClearViaTempFb(struct pipe_context *pipe, Device *pDevice, struct pipe_surface *surface, bool zs, unsigned buffers,
+               const union pipe_color_union *color, double depth, unsigned stencil)
+{
+   struct pipe_framebuffer_state fb;
+   memset(&fb, 0, sizeof fb);
+   fb.width = pipe_surface_width(surface);
+   fb.height = pipe_surface_height(surface);
+   if (zs) {
+      fb.zsbuf = *surface;
+   } else {
+      fb.nr_cbufs = 1;
+      fb.cbufs[0] = *surface;
+   }
+   pipe->set_framebuffer_state(pipe, &fb);
+   pipe->clear(pipe, buffers, 0xffffffffu, 0xff, NULL, color, depth, stencil);
+   pipe->set_framebuffer_state(pipe, &pDevice->fb);
+}
