+/* Create every missing component of path ('/' and '\' both separate); true if it is a directory at the end. */
+static bool
+win_mkdir_p(const char *path)
+{
+   char *p = strdup(path);
+   if (!p)
+      return false;
+   bool ok = true;
+   size_t len = strlen(p);
+   for (size_t i = 1; i <= len && ok; i++) {
+      if (p[i] != '/' && p[i] != '\\' && p[i] != '\0')
+         continue;
+      if (i == 2 && p[1] == ':')
+         continue;   /* "C:" */
+      char c = p[i];
+      p[i] = '\0';
+      wchar_t *w = win_wpath(p);
+      if (!w)
+         ok = false;
+      else if (!CreateDirectoryW(w, NULL) && !win_is_dir(w))
+         ok = false;
+      free(w);
+      p[i] = c;
+   }
+   free(p);
+   return ok;
