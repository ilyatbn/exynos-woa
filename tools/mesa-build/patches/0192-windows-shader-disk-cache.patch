+/* Delete the least recently used tenth (at least one) of the regular non-.tmp files in dir; returns the bytes freed. */
+static uint64_t
+win_unlink_lru_files(const char *dir)
+{
+   char *pattern;
+   if (asprintf(&pattern, "%s/*", dir) == -1)
+      return 0;
+   wchar_t *wpat = win_wpath(pattern);
+   free(pattern);
+   if (!wpat)
+      return 0;
