+   struct win_lru_file *files = NULL;
+   unsigned count = 0, cap = 0;
+   WIN32_FIND_DATAW fd;
+   HANDLE f = FindFirstFileW(wpat, &fd);
+   free(wpat);
+   if (f == INVALID_HANDLE_VALUE)
+      return 0;
+   do {
+      if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+         continue;
+      size_t len = wcslen(fd.cFileName);
+      if (len >= 4 && wcscmp(fd.cFileName + len - 4, L".tmp") == 0)
