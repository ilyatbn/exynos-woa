+      if (count == cap) {
+         cap = cap ? cap * 2 : 64;
+         struct win_lru_file *n = realloc(files, cap * sizeof(*files));
+         if (!n)
+            break;
+         files = n;
+      }
+      uint64_t at = ((uint64_t)fd.ftLastAccessTime.dwHighDateTime << 32) | fd.ftLastAccessTime.dwLowDateTime;
+      uint64_t wt = ((uint64_t)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+      wcsncpy(files[count].name, fd.cFileName, MAX_PATH - 1);
+      files[count].name[MAX_PATH - 1] = 0;
+      files[count].time = at > wt ? at : wt;
+      files[count].size = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+      count++;
