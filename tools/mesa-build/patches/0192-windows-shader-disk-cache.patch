+   char *filename_tmp = NULL;
+   wchar_t *wtmp = NULL, *wfinal = NULL;
+   HANDLE h = INVALID_HANDLE_VALUE;
+
+   if (asprintf(&filename_tmp, "%s.tmp", filename) == -1)
+      goto done;
+   wtmp = win_wpath(filename_tmp);
+   wfinal = win_wpath(filename);
+   if (!wtmp || !wfinal)
+      goto done;
+
+   /* Share mode 0 makes the open temporary file exclusive - it stands in for the POSIX flock: a second writer of
+    * the same entry (another thread or process) fails here and leaves the entry to the first one. DELETE access
+    * lets the same handle rename or delete the file. */
+   h = CreateFileW(wtmp, GENERIC_WRITE | DELETE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+   if (h == INVALID_HANDLE_VALUE && GetLastError() == ERROR_PATH_NOT_FOUND) {
+      make_cache_file_directory(dc_job->cache, dc_job->key);
+      h = CreateFileW(wtmp, GENERIC_WRITE | DELETE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+   }
+   if (h == INVALID_HANDLE_VALUE)
+      goto done;
+
+   /* Another writer stored it between our miss and now: keep the size accounting right by not writing it again. */
+   bool ok = GetFileAttributesW(wfinal) == INVALID_FILE_ATTRIBUTES &&
+             create_cache_item_header_and_blob(dc_job, &cache_blob);
+   DWORD wrote = 0;
+   ok = ok && WriteFile(h, cache_blob.data, (DWORD)cache_blob.size, &wrote, NULL) && wrote == cache_blob.size;
+
+   if (ok) {
+      /* Rename through the open handle (still exclusive), not replacing an existing file:
+       * SetFileInformationByHandle(FileRenameInfo), FILE_RENAME_INFO.ReplaceIfExists = FALSE. */
+      size_t name_bytes = wcslen(wfinal) * sizeof(wchar_t);
+      FILE_RENAME_INFO *ri = calloc(1, sizeof(FILE_RENAME_INFO) + name_bytes);
+      ok = ri != NULL;
+      if (ok) {
+         ri->ReplaceIfExists = FALSE;
+         ri->RootDirectory = NULL;
+         ri->FileNameLength = (DWORD)name_bytes;
+         memcpy(ri->FileName, wfinal, name_bytes);
+         ok = SetFileInformationByHandle(h, FileRenameInfo, ri, (DWORD)(sizeof(FILE_RENAME_INFO) + name_bytes));
+         free(ri);
+      }
+   }
+
+   if (ok) {
+      p_atomic_add(&dc_job->cache->size->value, win_disk_size(cache_blob.size));
+   } else {
+      FILE_DISPOSITION_INFO di = { .DeleteFile = TRUE };
+      SetFileInformationByHandle(h, FileDispositionInfo, &di, sizeof(di));
+   }
+
+done:
+   if (h != INVALID_HANDLE_VALUE)
+      CloseHandle(h);
+   free(wtmp);
+   free(wfinal);
+   free(filename_tmp);
+   blob_finish(&cache_blob);
+}
