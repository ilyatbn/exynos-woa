+const char *
+disk_cache_generate_cache_dir(void *mem_ctx, const char *gpu_name,
+                              const char *driver_id,
+                              const char *cache_dir_name_custom,
+                              enum disk_cache_type cache_type,
+                              bool mkdir)
+{
+   if (cache_type != DISK_CACHE_MULTI_FILE || cache_dir_name_custom)
+      return NULL;
+
+   wchar_t lad[MAX_PATH];
+   DWORD lad_len = GetEnvironmentVariableW(L"LOCALAPPDATA", lad, ARRAY_SIZE(lad));
+   if (lad_len == 0 || lad_len >= ARRAY_SIZE(lad)) {
+      WIN_FAIL("LOCALAPPDATA");
+      return NULL;
+   }
+   char *lad8 = win_u8(mem_ctx, lad);
+   char *base = lad8 ? ralloc_asprintf(mem_ctx, "%s/" WIN_CACHE_ROOT, lad8) : NULL;
+   if (!base)
+      return NULL;
+
+   /* One directory per executable: <exe name>-<crc32 of the lower-case full path>. */
+   wchar_t exe[2 * MAX_PATH], lower[2 * MAX_PATH];
+   DWORD n = GetModuleFileNameW(NULL, exe, ARRAY_SIZE(exe));
+   if (n == 0 || n >= ARRAY_SIZE(exe)) {
+      WIN_FAIL("GetModuleFileName");
+      return NULL;
+   }
+   for (DWORD i = 0; i <= n; i++)
+      lower[i] = towlower(exe[i]);
+   const wchar_t *name = wcsrchr(exe, L'\\');
+   name = name ? name + 1 : exe;
+   char *exe8 = win_u8(mem_ctx, exe), *lower8 = win_u8(mem_ctx, lower), *name8 = win_u8(mem_ctx, name);
+   if (!exe8 || !lower8 || !name8)
+      return NULL;
+
+   char *path = ralloc_asprintf(mem_ctx, "%s/%s-%08x", base, name8, util_hash_crc32(lower8, strlen(lower8)));
+   if (!path)
+      return NULL;
+   wchar_t *wpath = win_wpath(path);
+   if (!wpath)
+      return NULL;
+   bool exists = win_is_dir(wpath);
+   free(wpath);
+   if (!exists && (!mkdir || !win_mkdir_p(path))) {
+      WIN_FAIL("mkdir");
+      return NULL;
+   }
+
+   /* app.txt: the full exe path, for the cache manager; written once. */
+   char *app;
+   if (asprintf(&app, "%s/app.txt", path) != -1) {
+      wchar_t *wapp = win_wpath(app);
+      free(app);
+      if (wapp) {
+         HANDLE h = CreateFileW(wapp, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+         if (h != INVALID_HANDLE_VALUE) {
+            DWORD wrote;
+            WriteFile(h, exe8, (DWORD)strlen(exe8), &wrote, NULL);
+            CloseHandle(h);
+         }
+         free(wapp);
+      }
+   }
+
+   return path;
+}
