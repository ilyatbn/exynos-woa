+bool
+disk_cache_enabled()
+{
+   /* Same switches as POSIX, without the real-user check (Windows has no setuid). */
+#if defined(SHADER_CACHE_DISABLE_BY_DEFAULT)
+   bool disable_by_default = true;
+#else
+   bool disable_by_default = false;
+#endif
+   const char *envvar_name = "MESA_SHADER_CACHE_DISABLE";
+   if (!os_get_option(envvar_name) && os_get_option("MESA_GLSL_CACHE_DISABLE"))
+      envvar_name = "MESA_GLSL_CACHE_DISABLE";
+
+   bool enabled = !debug_get_bool_option(envvar_name, disable_by_default);
+   if (!enabled)
+      disk_cache_win_fail = "disabled";
+   return enabled;
+}
