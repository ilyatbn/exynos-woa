+   uint64_t freed = 0;
+   if (count) {
+      qsort(files, count, sizeof(*files), win_lru_cmp);
+      unsigned n = count > 10 ? count / 10 : 1;
+      wchar_t *wdir = win_wpath(dir);
+      for (unsigned i = 0; wdir && i < n; i++) {
