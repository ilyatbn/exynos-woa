+       * FSCTL_SET_SPARSE: "In a sparse file, large ranges of zeros may not require disk allocation. Space for nonzero
+       * data will be allocated as needed as the file is written"; NULL input = set sparse. Best effort. */
+      DWORD ret;
+      DeviceIoControl(f, FSCTL_SET_SPARSE, NULL, 0, NULL, 0, &ret, NULL);
+   }
 
    /* CreateFileMapping with a maximum size larger than the file extends the file to that size. */
    size_t size = sizeof(*cache->size) + CACHE_INDEX_MAX_KEYS * CACHE_KEY_SIZE;
