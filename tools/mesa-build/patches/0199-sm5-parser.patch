+extern void malikm_tlog(const char *fmt, ...);
+
+/* exynos-woa G34: one tlog line per opcode - name, operand counts, each operand's type / index dimension / first index
+ * and the opcode-specific value - for checking the SM5 decoding against fxc's disassembly (notes/g34-fl11.md). */
+void
+Shader_opcode_trace(const struct Shader_opcode *opcode)
+{
+   static int on = -1;
+   char ops[192];
+   int n = 0;
+   unsigned i;
+
+   if (on < 0) {
+      const char *v = getenv("D3D10UMD_PARSE_TRACE");
+      on = v && *v == '1';
+   }
+   if (!on)
+      return;
+   if (opcode->type == D3D10_SB_OPCODE_CUSTOMDATA) {
+      malikm_tlog("parse: customdata class %u", (unsigned)opcode->customdata._class);
+      return;
+   }
+   ops[0] = 0;
+   for (i = 0; i < opcode->num_dst && n < (int)sizeof ops - 24; i++)
+      n += snprintf(ops + n, sizeof ops - n, " d%u:%u[%u]%u.m%x", i, (unsigned)opcode->dst[i].base.type,
+                    opcode->dst[i].base.index_dim, opcode->dst[i].base.index[0].imm, opcode->dst[i].mask);
+   for (i = 0; i < opcode->num_src && n < (int)sizeof ops - 24; i++)
+      n += snprintf(ops + n, sizeof ops - n, " s%u:%u[%u]%u", i, (unsigned)opcode->src[i].base.type,
+                    opcode->src[i].base.index_dim, opcode->src[i].base.index[0].imm);
+   malikm_tlog("parse: %s (%u) %u/%u%s spec %u/%u/%u", opcode_info[opcode->type].name ? opcode_info[opcode->type].name : "?",
+               (unsigned)opcode->type, opcode->num_dst, opcode->num_src, ops,
+               opcode->specific.thread_group.x, opcode->specific.thread_group.y, opcode->specific.thread_group.z);
+}
