       dst = ttn_mem(c, src);
       break;
 
+   case TGSI_OPCODE_RESQ:   /* exynos-woa G34 (SM5 bufinfo): the byte size of a buffer, replicated */
+      if (tgsi_inst->Src[0].Register.File == TGSI_FILE_BUFFER) {
+         add_ssbo_var(c, tgsi_inst->Src[0].Register.Index);
+         dst = nir_replicate(b, nir_get_ssbo_size(b, 32, nir_imm_int(b, tgsi_inst->Src[0].Register.Index)), 4);
+      } else {
+         fprintf(stderr, "RESQ: only buffers are handled\n");
+         dst = nir_imm_ivec4(b, 0, 0, 0, 0);
+      }
+      break;
+
    case TGSI_OPCODE_NOP:
       break;
 
@@ -2390,6 +2400,21 @@ ttn_emit_instruction(struct ttn_compile *c)
       dst = nir_ddx(b, src[0]);
       break;
 
+   /* exynos-woa G34 (SM5 f32tof16 / f16tof32, ShaderTGSI.c): TGSI PK2H packs src.x / src.y as halfs into one dword
+    * (x low), UP2H unpacks src.x into (lo, hi, lo, hi) - tgsi.rst. PK2H was unimplemented here and d3d10umd is its
+    * only producer, so it follows D3D: "Round-to-zero must be used during conversion to another float format" (D3D11.3
+    * functional spec 3.2.2; d3dsm5 f16 vs WARP). */
+   case TGSI_OPCODE_PK2H:
+      dst = nir_replicate(b, nir_pack_32_2x16_split(b, nir_f2f16_rtz(b, nir_channel(b, src[0], 0)),
+                                                    nir_f2f16_rtz(b, nir_channel(b, src[0], 1))), 4);
+      break;
+
+   case TGSI_OPCODE_UP2H: {
+      nir_def *h = nir_unpack_half_2x16(b, nir_channel(b, src[0], 0));
+      dst = nir_vec4(b, nir_channel(b, h, 0), nir_channel(b, h, 1), nir_channel(b, h, 0), nir_channel(b, h, 1));
+      break;
+   }
+
    case TGSI_OPCODE_DDX_FINE:
       dst = nir_ddx_fine(b, src[0]);
       break;
