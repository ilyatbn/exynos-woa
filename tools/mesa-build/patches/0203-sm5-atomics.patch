+/* exynos-woa G34 F11.4a: SM5 atomic on a raw / structured UAV or groupshared memory. The address operand is the byte
+ * offset (raw) or (structure index, byte offset) (structured), sm5 asm atomic_* / imm_atomic_*. result (optional)
+ * receives the previous value, replicated to its mask. cmp = the compare value of atomic_cmp_store / imm_atomic_cmp_exch.
+ * Returns false when the resource is not a buffer this translator declared (typed UAVs: F11.4b). */
+static bool
+emit_buffer_atomic(struct Shader_xlate *sx, unsigned tgsi_op, const struct Shader_operand *res,
+                   const struct Shader_src_operand *addr, const struct Shader_src_operand *cmp,
+                   const struct Shader_src_operand *value, const struct Shader_dst_operand *result)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct buf_ref r = resolve_buffer(sx, res);
+   if (!r.ok)
+      return false;
+   struct ureg_src a = translate_src_operand(sx, addr, OF_UINT);
+   struct ureg_dst ad = ureg_writemask(ureg_DECL_temporary(ureg), TGSI_WRITEMASK_X);
+   if (r.stride)
+      ureg_UMAD(ureg, ad, ureg_scalar(a, TGSI_SWIZZLE_X), ureg_imm1u(ureg, r.stride), ureg_scalar(a, TGSI_SWIZZLE_Y));
+   else
+      ureg_MOV(ureg, ad, ureg_scalar(a, TGSI_SWIZZLE_X));
+   if (r.base)
+      ureg_UADD(ureg, ad, ureg_scalar(ureg_src(ad), TGSI_SWIZZLE_X), ureg_imm1u(ureg, r.base));
+   struct ureg_src src[4];
+   unsigned n = 0;
+   src[n++] = r.reg;
+   src[n++] = ureg_scalar(ureg_src(ad), TGSI_SWIZZLE_X);
+   if (cmp)
+      src[n++] = ureg_scalar(translate_src_operand(sx, cmp, OF_UINT), TGSI_SWIZZLE_X);
+   src[n++] = ureg_scalar(translate_src_operand(sx, value, OF_UINT), TGSI_SWIZZLE_X);
+   struct ureg_dst t = ureg_DECL_temporary(ureg);
+   ureg_memory_insn(ureg, tgsi_op, &t, 1, src, n, 0, TGSI_TEXTURE_BUFFER, PIPE_FORMAT_NONE);
+   if (result && result->base.type != D3D10_SB_OPERAND_TYPE_NULL)
+      ureg_MOV(ureg, translate_dst_operand(sx, result, false), ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X));
+   ureg_release_temporary(ureg, t);
+   ureg_release_temporary(ureg, ad);
+   return true;
+}
+
+static unsigned
+sm5_atomic_tgsi_op(unsigned type)
+{
+   switch (type) {
+   case D3D11_SB_OPCODE_ATOMIC_AND: case D3D11_SB_OPCODE_IMM_ATOMIC_AND: return TGSI_OPCODE_ATOMAND;
+   case D3D11_SB_OPCODE_ATOMIC_OR: case D3D11_SB_OPCODE_IMM_ATOMIC_OR: return TGSI_OPCODE_ATOMOR;
+   case D3D11_SB_OPCODE_ATOMIC_XOR: case D3D11_SB_OPCODE_IMM_ATOMIC_XOR: return TGSI_OPCODE_ATOMXOR;
+   case D3D11_SB_OPCODE_ATOMIC_CMP_STORE: case D3D11_SB_OPCODE_IMM_ATOMIC_CMP_EXCH: return TGSI_OPCODE_ATOMCAS;
+   case D3D11_SB_OPCODE_ATOMIC_IADD: case D3D11_SB_OPCODE_IMM_ATOMIC_IADD: return TGSI_OPCODE_ATOMUADD;
+   case D3D11_SB_OPCODE_ATOMIC_IMAX: case D3D11_SB_OPCODE_IMM_ATOMIC_IMAX: return TGSI_OPCODE_ATOMIMAX;
+   case D3D11_SB_OPCODE_ATOMIC_IMIN: case D3D11_SB_OPCODE_IMM_ATOMIC_IMIN: return TGSI_OPCODE_ATOMIMIN;
+   case D3D11_SB_OPCODE_ATOMIC_UMAX: case D3D11_SB_OPCODE_IMM_ATOMIC_UMAX: return TGSI_OPCODE_ATOMUMAX;
+   case D3D11_SB_OPCODE_ATOMIC_UMIN: case D3D11_SB_OPCODE_IMM_ATOMIC_UMIN: return TGSI_OPCODE_ATOMUMIN;
+   case D3D11_SB_OPCODE_IMM_ATOMIC_EXCH: return TGSI_OPCODE_ATOMXCHG;
+   default: return TGSI_OPCODE_LAST;
+   }
+}
