+/* exynos-woa G34 (SM5 atomics, d3d10umd ShaderTGSI.c): TGSI ATOM* on BUFFER (SSBO) and MEMORY (byte-addressed shared
+ * memory, base 0 like ttn_mem) -> nir ssbo/shared atomics; dst.x = the previous value. ATOMCAS dst, res, offset, cmp,
+ * src (tgsi.rst). Images: not handled here yet (typed UAV atomics). */
+static nir_def *
+ttn_atomic(struct ttn_compile *c, nir_def **src)
+{
+   nir_builder *b = &c->build;
+   struct tgsi_full_instruction *tgsi_inst = &c->token->FullInstruction;
+   unsigned file = tgsi_inst->Src[0].Register.File;
+   unsigned index = tgsi_inst->Src[0].Register.Index;
+   nir_atomic_op op;
+
+   switch (tgsi_inst->Instruction.Opcode) {
+   case TGSI_OPCODE_ATOMUADD: op = nir_atomic_op_iadd; break;
+   case TGSI_OPCODE_ATOMXCHG: op = nir_atomic_op_xchg; break;
+   case TGSI_OPCODE_ATOMCAS:  op = nir_atomic_op_cmpxchg; break;
+   case TGSI_OPCODE_ATOMAND:  op = nir_atomic_op_iand; break;
+   case TGSI_OPCODE_ATOMOR:   op = nir_atomic_op_ior; break;
+   case TGSI_OPCODE_ATOMXOR:  op = nir_atomic_op_ixor; break;
+   case TGSI_OPCODE_ATOMUMIN: op = nir_atomic_op_umin; break;
+   case TGSI_OPCODE_ATOMUMAX: op = nir_atomic_op_umax; break;
+   case TGSI_OPCODE_ATOMIMIN: op = nir_atomic_op_imin; break;
+   case TGSI_OPCODE_ATOMIMAX: op = nir_atomic_op_imax; break;
+   default: UNREACHABLE("not an atomic");
+   }
+
+   nir_def *offset = ttn_channel(b, src[1], X);
+   nir_def *data = ttn_channel(b, src[2], X);
+   nir_def *res;
+   if (file == TGSI_FILE_BUFFER) {
+      add_ssbo_var(c, index);
+      nir_def *idx = nir_imm_int(b, index);
+      if (op == nir_atomic_op_cmpxchg)
+         res = nir_ssbo_atomic_swap(b, 32, idx, offset, data, ttn_channel(b, src[3], X), .atomic_op = op);
+      else
+         res = nir_ssbo_atomic(b, 32, idx, offset, data, .atomic_op = op);
+   } else if (file == TGSI_FILE_MEMORY) {
+      if (op == nir_atomic_op_cmpxchg)
+         res = nir_shared_atomic_swap(b, 32, offset, data, ttn_channel(b, src[3], X), .base = 0, .atomic_op = op);
+      else
+         res = nir_shared_atomic(b, 32, offset, data, .base = 0, .atomic_op = op);
+   } else {
+      fprintf(stderr, "ttn_atomic: file %u not handled\n", file);
+      res = nir_imm_int(b, 0);
+   }
+   return nir_replicate(b, res, 4);
+}
