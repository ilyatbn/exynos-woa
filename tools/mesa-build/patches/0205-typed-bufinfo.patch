diff --git a/src/gallium/auxiliary/nir/tgsi_to_nir.c b/src/gallium/auxiliary/nir/tgsi_to_nir.c
index 6a67dd9..39f6146 100644
--- a/src/gallium/auxiliary/nir/tgsi_to_nir.c
+++ b/src/gallium/auxiliary/nir/tgsi_to_nir.c
@@ -2463,8 +2463,21 @@ ttn_emit_instruction(struct ttn_compile *c)
       if (tgsi_inst->Src[0].Register.File == TGSI_FILE_BUFFER) {
          add_ssbo_var(c, tgsi_inst->Src[0].Register.Index);
          dst = nir_replicate(b, nir_get_ssbo_size(b, 32, nir_imm_int(b, tgsi_inst->Src[0].Register.Index)), 4);
+      } else if (tgsi_inst->Src[0].Register.File == TGSI_FILE_IMAGE) {
+         /* review R6 of 0204: typed UAV dimensions (bufinfo on RWBuffer = element count) */
+         enum glsl_sampler_dim dim;
+         bool is_array;
+         get_texture_info(tgsi_inst->Memory.Texture, &dim, NULL, &is_array);
+         nir_variable *image = get_image_var(c, tgsi_inst->Src[0].Register.Index, dim, is_array,
+                                             get_image_base_type(tgsi_inst), get_mem_qualifier(tgsi_inst),
+                                             tgsi_inst->Memory.Format);
+         nir_deref_instr *deref = nir_build_deref_var(b, image);
+         unsigned n = glsl_get_sampler_coordinate_components(image->type);
+         nir_def *sz = nir_image_deref_size(b, n, 32, &deref->def, nir_imm_int(b, 0), .image_dim = dim,
+                                            .image_array = is_array);
+         dst = nir_pad_vector_imm_int(b, sz, 0, 4);
       } else {
-         fprintf(stderr, "RESQ: only buffers are handled\n");
+         fprintf(stderr, "RESQ: file not handled\n");
          dst = nir_imm_ivec4(b, 0, 0, 0, 0);
       }
       break;
