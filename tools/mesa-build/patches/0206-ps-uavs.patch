+/* exynos-woa G34 F11.5: the bound pixel shader's UAVs (typed -> images, raw / structured -> SSBOs) and raw /
+ * structured SRVs, from SetRenderTargets(D3D11)'s UAV slots and PsSetShaderResources - as Compute.cpp LaunchCompute
+ * does for the compute stage. Nothing to do for a PS without such declarations. */
+static void
+BindPsUavs(Device *pDevice)
+{
+   Shader *ps = pDevice->bound_ps;
+   if (!ps || !ps->extra || (!ps->extra->num_buffers && !ps->extra->num_images))
+      return;
+   struct pipe_context *pipe = pDevice->pipe;
+   const struct Shader_extra *ex = ps->extra;
+   if (ex->num_buffers) {
+      struct pipe_shader_buffer bufs[SHADER_MAX_BUFFERS];
+      unsigned writable = 0;
+      memset(bufs, 0, sizeof bufs);
+      for (unsigned i = 0; i < ex->num_buffers; i++) {
+         if (ex->buffers[i].uav) {
+            UnorderedAccessView *u = ex->buffers[i].slot < 8 ? pDevice->om_uavs[ex->buffers[i].slot] : NULL;
+            if (u && !u->typed) {
+               bufs[i].buffer = u->resource;
+               bufs[i].buffer_offset = u->offset;
+               bufs[i].buffer_size = u->size;
+            }
+            writable |= 1u << i;
+         } else {
+            ShaderResourceView *v = pDevice->ps_srvs[ex->buffers[i].slot];
+            if (v) {
+               bufs[i].buffer = v->buffer;
+               bufs[i].buffer_offset = v->buffer_offset;
+               bufs[i].buffer_size = v->buffer_size;
+            }
+         }
+      }
+      pipe->set_shader_buffers(pipe, MESA_SHADER_FRAGMENT, 0, ex->num_buffers, bufs, writable);
+   }
+   if (ex->num_images) {
+      struct pipe_image_view imgs[8];
+      memset(imgs, 0, sizeof imgs);
+      for (unsigned k = 0; k < ex->num_images; k++) {
+         UnorderedAccessView *u = pDevice->om_uavs[ex->image_slot[k]];
+         if (u && u->typed)
+            imgs[k] = u->image;
+      }
+      pipe->set_shader_images(pipe, MESA_SHADER_FRAGMENT, 0, ex->num_images, 0, imgs);
+   }
+}
