@@ -40,6 +40,7 @@
 
 #include "util/u_draw.h"
 #include "util/u_memory.h"
+#include "util/u_inlines.h"   /* G34 F11.8: pipe_buffer_read */
 #include "GsEmu.h"   /* exynos-woa G25 */
 
 static unsigned
@@ -448,6 +449,39 @@ DrawIndexedInstanced(D3D10DDI_HDEVICE hDevice,   // IN
 }
 
 
+/* exynos-woa G34 F11.8: DrawInstancedIndirect / DrawIndexedInstancedIndirect. The argument structs are
+ * D3D11_DRAW_INSTANCED_INDIRECT_ARGS {VertexCountPerInstance, InstanceCount, StartVertexLocation,
+ * StartInstanceLocation} and D3D11_DRAW_INDEXED_INSTANCED_INDIRECT_ARGS {IndexCountPerInstance, InstanceCount,
+ * StartIndexLocation, BaseVertexLocation, StartInstanceLocation} (d3d11.h). panfrost on Bifrost (v7) has no GPU-side
+ * indirect draw and reads the arguments back on the CPU itself (pan_cmdstream.c PAN_GPU_SUPPORTS_DRAW_INDIRECT is
+ * arch >= 10); reading them here instead keeps the draw paths that need the counts on the CPU (GsEmu) working. */
+void APIENTRY
+DrawInstancedIndirect(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hBufferForArgs, UINT AlignedByteOffset)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_resource *args = CastPipeResource(hBufferForArgs);
+   UINT a[4] = {};
+   if (!args)
+      return;
+   pipe_buffer_read(pDevice->pipe, args, AlignedByteOffset, sizeof a, a);
+   DrawInstanced(hDevice, a[0], a[1], a[2], a[3]);
+}
+
+void APIENTRY
+DrawIndexedInstancedIndirect(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hBufferForArgs, UINT AlignedByteOffset)
+{
+   LOG_ENTRYPOINT();
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_resource *args = CastPipeResource(hBufferForArgs);
+   UINT a[5] = {};
+   if (!args)
+      return;
+   pipe_buffer_read(pDevice->pipe, args, AlignedByteOffset, sizeof a, a);
+   DrawIndexedInstanced(hDevice, a[0], a[1], a[2], (INT)a[3], a[4]);
+}
+
+
