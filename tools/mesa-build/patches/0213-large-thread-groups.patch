+/* ---- exynos-woa G34 F11.7: thread groups above the hardware limit ---- */
+#define TL_HW_MAX 384u   /* THREAD_MAX_WORKGROUP_SZ (device read 0x180); numthreads(384) runs natively (d3dsm5 group384) */
+
+static void
+tl_prescan(struct Shader_xlate *sx, const unsigned *code)
+{
+   struct Shader_parser p;
+   struct Shader_opcode op;
+   unsigned stack[64], kind[64], depth, n, T = 0, lb[3] = { 1, 1, 1 };
+   bool calls = false, overflow = false;
+
+   Shader_parse_init(&p, code);
+   depth = n = 0;
+   while (Shader_parse_opcode(&p, &op)) {
+      switch (op.type) {
+      case D3D11_SB_OPCODE_DCL_THREAD_GROUP:
+         lb[0] = op.specific.thread_group.x;
+         lb[1] = op.specific.thread_group.y;
+         lb[2] = op.specific.thread_group.z;
+         T = lb[0] * lb[1] * lb[2];
+         break;
+      case D3D10_SB_OPCODE_IF: case D3D10_SB_OPCODE_LOOP: case D3D10_SB_OPCODE_SWITCH:
+         if (depth < 64 && n < ARRAY_SIZE(sx->tl.shared)) {
+            stack[depth] = n;
+            kind[depth++] = op.type;
+            sx->tl.shared[n++] = false;
+         } else {
+            overflow = true;
+         }
+         break;
+      case D3D10_SB_OPCODE_ENDIF: case D3D10_SB_OPCODE_ENDLOOP: case D3D10_SB_OPCODE_ENDSWITCH:
+         if (depth)
+            depth--;
+         break;
+      case D3D11_SB_OPCODE_SYNC:
+         if (op.specific.sync_flags & D3D11_SB_SYNC_THREADS_IN_GROUP)
+            for (unsigned d = 0; d < depth; d++)
+               sx->tl.shared[stack[d]] = true;
+         break;
+      case D3D10_SB_OPCODE_RET: case D3D10_SB_OPCODE_RETC:
+         if (depth || op.type == D3D10_SB_OPCODE_RETC)
+            sx->tl.body_ret = true;
+         break;
+      case D3D10_SB_OPCODE_CALL: case D3D10_SB_OPCODE_CALLC: case D3D10_SB_OPCODE_LABEL:
+         calls = true;
+         break;
+      default:
+         break;
+      }
+      Shader_opcode_free(&op);
+   }
+   /* a break / continue whose loop (switch) runs shared makes every block between them shared; repeat until stable */
+   for (bool changed = true; changed;) {
+      changed = false;
+      Shader_parse_init(&p, code);
+      depth = n = 0;
+      while (Shader_parse_opcode(&p, &op)) {
+         switch (op.type) {
+         case D3D10_SB_OPCODE_IF: case D3D10_SB_OPCODE_LOOP: case D3D10_SB_OPCODE_SWITCH:
+            if (depth < 64 && n < ARRAY_SIZE(sx->tl.shared)) {
+               stack[depth] = n++;
+               kind[depth++] = op.type;
+            }
+            break;
+         case D3D10_SB_OPCODE_ENDIF: case D3D10_SB_OPCODE_ENDLOOP: case D3D10_SB_OPCODE_ENDSWITCH:
+            if (depth)
+               depth--;
+            break;
+         case D3D10_SB_OPCODE_BREAK: case D3D10_SB_OPCODE_BREAKC:
+         case D3D10_SB_OPCODE_CONTINUE: case D3D10_SB_OPCODE_CONTINUEC: {
+            bool brk = op.type == D3D10_SB_OPCODE_BREAK || op.type == D3D10_SB_OPCODE_BREAKC;
+            for (int d = (int)depth - 1; d >= 0; d--) {
+               if (kind[d] == D3D10_SB_OPCODE_LOOP || (brk && kind[d] == D3D10_SB_OPCODE_SWITCH)) {
+                  if (sx->tl.shared[stack[d]])
+                     for (unsigned e = d + 1; e < depth; e++)
+                        if (!sx->tl.shared[stack[e]]) {
+                           sx->tl.shared[stack[e]] = true;
+                           changed = true;
+                        }
+                  break;
+               }
+            }
+            break;
+         }
+         default:
+            break;
+         }
+         Shader_opcode_free(&op);
+      }
+   }
+   sx->tl.nblocks = n;
+   if (T <= TL_HW_MAX)
+      return;
+   if (calls || overflow) {
+      malikm_tlog("ShaderTGSI: %u-thread group with %s - not emulated", T, calls ? "subroutines" : "too many blocks");
+      LOG_UNSUPPORTED(true);
+      return;
+   }
+   unsigned H = TL_HW_MAX;
+   for (unsigned d = TL_HW_MAX; d >= 64; d--)
+      if (T % d == 0) {
+         H = d;
+         break;
+      }
+   sx->tl.active = true;
+   sx->tl.T = T;
+   sx->tl.H = H;
+   sx->tl.K = (T + H - 1) / H;
+   memcpy(sx->tl.lb, lb, sizeof lb);
+   sx->tl.first_segment = true;
+   malikm_tlog("ShaderTGSI: %u-thread group (%ux%ux%u) emulated as %u x %u", T, lb[0], lb[1], lb[2], H, sx->tl.K);
+}
+
+static void
+tl_init(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   sx->tl.j = ureg_DECL_temporary(u);
+   sx->tl.l = ureg_DECL_temporary(u);
+   sx->tl.t = ureg_DECL_temporary(u);
+   sx->tl.act = ureg_DECL_temporary(u);
+   sx->tl.retf = ureg_DECL_temporary(u);
+   sx->tl.tid = ureg_DECL_temporary(u);
+   sx->tl.addr = ureg_DECL_address(u);
+   sx->tl.hw_tid = ureg_DECL_system_value(u, TGSI_SEMANTIC_THREAD_ID, 0);
+   sx->cs_gid = ureg_DECL_system_value(u, TGSI_SEMANTIC_BLOCK_ID, 0);
+   sx->cs_tid = ureg_src(sx->tl.tid);   /* cs_system_value reads the logical thread id from here */
+   sx->cs_sv_declared = true;
+}
+
+static struct ureg_dst
+tl_save_elem(struct Shader_xlate *sx, unsigned i)
+{
+   return ureg_dst_indirect(ureg_dst_array_offset(sx->tl.save, (int)i), ureg_src(sx->tl.addr));
+}
+
+static void
+tl_set_addr(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   struct ureg_dst tx = ureg_writemask(sx->tl.t, TGSI_WRITEMASK_X);
+   ureg_UMUL(u, tx, ureg_scalar(ureg_src(sx->tl.j), TGSI_SWIZZLE_X), ureg_imm1u(u, sx->tl.nsave + 1));
+   ureg_UARL(u, ureg_writemask(sx->tl.addr, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(sx->tl.t), TGSI_SWIZZLE_X));
+}
+
+static void
+tl_open(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   unsigned label = 0;
+   struct ureg_src jx = ureg_scalar(ureg_src(sx->tl.j), TGSI_SWIZZLE_X);
+   struct ureg_src lx = ureg_scalar(ureg_src(sx->tl.l), TGSI_SWIZZLE_X);
+   struct ureg_src tx = ureg_scalar(ureg_src(sx->tl.t), TGSI_SWIZZLE_X);
+   const unsigned *lb = sx->tl.lb;
+
+   if (!sx->tl.save.File) {   /* first segment: every DXBC temporary is declared by now */
+      sx->tl.nsave = sx->declared_temps;
+      sx->tl.save = ureg_DECL_array_temporary(u, (sx->tl.nsave + 1) * sx->tl.K, true);
+   }
+   ureg_MOV(u, ureg_writemask(sx->tl.j, TGSI_WRITEMASK_X), ureg_imm1u(u, 0));
+   ureg_BGNLOOP(u, &label);
+   ureg_USGE(u, ureg_writemask(sx->tl.t, TGSI_WRITEMASK_X), jx, ureg_imm1u(u, sx->tl.K));
+   ureg_UIF(u, tx, &label);
+   ureg_BRK(u);
+   ureg_ENDIF(u);
+   ureg_UMAD(u, ureg_writemask(sx->tl.l, TGSI_WRITEMASK_X), jx, ureg_imm1u(u, sx->tl.H),
+             ureg_scalar(sx->tl.hw_tid, TGSI_SWIZZLE_X));
+   ureg_USLT(u, ureg_writemask(sx->tl.act, TGSI_WRITEMASK_X), lx, ureg_imm1u(u, sx->tl.T));
+   ureg_UIF(u, ureg_scalar(ureg_src(sx->tl.act), TGSI_SWIZZLE_X), &label);
+   if (sx->tl.first_segment) {
+      ureg_MOV(u, sx->tl.retf, ureg_imm1u(u, 0));
+   } else {
+      tl_set_addr(sx);
+      for (unsigned i = 0; i < sx->tl.nsave; i++)
+         ureg_MOV(u, sx->temps[i], ureg_src(tl_save_elem(sx, i)));
+      ureg_MOV(u, sx->tl.retf, ureg_src(tl_save_elem(sx, sx->tl.nsave)));
+   }
+   ureg_USEQ(u, ureg_writemask(sx->tl.t, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(sx->tl.retf), TGSI_SWIZZLE_X),
+             ureg_imm1u(u, 0));
+   ureg_UIF(u, tx, &label);
+   /* the logical thread id: l -> (l % bx, (l / bx) % by, l / (bx * by)) */
+   ureg_UMOD(u, ureg_writemask(sx->tl.tid, TGSI_WRITEMASK_X), lx, ureg_imm1u(u, lb[0]));
+   ureg_UDIV(u, ureg_writemask(sx->tl.t, TGSI_WRITEMASK_Y), lx, ureg_imm1u(u, lb[0]));
+   ureg_UMOD(u, ureg_writemask(sx->tl.tid, TGSI_WRITEMASK_Y), ureg_scalar(ureg_src(sx->tl.t), TGSI_SWIZZLE_Y),
+             ureg_imm1u(u, lb[1]));
+   ureg_UDIV(u, ureg_writemask(sx->tl.tid, TGSI_WRITEMASK_Z), lx, ureg_imm1u(u, lb[0] * lb[1]));
+   ureg_MOV(u, ureg_writemask(sx->tl.tid, TGSI_WRITEMASK_W), ureg_imm1u(u, 0));
+   ureg_BGNLOOP(u, &label);   /* do-once: a per-thread RET is a BRK out of it */
+   sx->tl.in_segment = true;
+}
+
+static void
+tl_close(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   unsigned label = 0;
+   if (!sx->tl.in_segment)
+      return;
+   ureg_BRK(u);
+   ureg_ENDLOOP(u, &label);   /* do-once */
+   ureg_ENDIF(u);             /* retf == 0 */
+   tl_set_addr(sx);           /* the body may have used address registers */
+   for (unsigned i = 0; i < sx->tl.nsave; i++)
+      ureg_MOV(u, tl_save_elem(sx, i), ureg_src(sx->temps[i]));
+   ureg_MOV(u, tl_save_elem(sx, sx->tl.nsave), ureg_src(sx->tl.retf));
+   ureg_ENDIF(u);             /* active */
+   ureg_UADD(u, ureg_writemask(sx->tl.j, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(sx->tl.j), TGSI_SWIZZLE_X),
+             ureg_imm1u(u, 1));
+   ureg_ENDLOOP(u, &label);
+   sx->tl.in_segment = false;
+   sx->tl.first_segment = false;
+}
+
+/* The segment a shared control-flow op or barrier left pending: opened unless this opcode ends or splits a shared
+ * block (it would only close it again). */
+static void
+tl_open_pending(struct Shader_xlate *sx, const struct Shader_opcode *op)
+{
+   if (!sx->tl.need_open)
+      return;
+   sx->tl.need_open = false;
+   switch (op->type) {
+   case D3D10_SB_OPCODE_ELSE: case D3D10_SB_OPCODE_CASE: case D3D10_SB_OPCODE_DEFAULT:
+   case D3D10_SB_OPCODE_ENDIF: case D3D10_SB_OPCODE_ENDLOOP: case D3D10_SB_OPCODE_ENDSWITCH:
+      if (sx->tl.depth && sx->tl.st_shared[sx->tl.depth - 1])
+         return;
+      break;
+   default:
+      break;
+   }
+   tl_open(sx);
+}
+
+/* Before the opcode's normal translation. TRUE = fully handled here. Sets post_open when a segment must open after
+ * the normal translation (shared control flow, barriers). */
+static bool
+tl_pre(struct Shader_xlate *sx, const struct Shader_opcode *op)
+{
+   struct ureg_program *u = sx->ureg;
+   unsigned label = 0;
+   sx->tl.post_open = false;
+   switch (op->type) {
+   case D3D11_SB_OPCODE_SYNC:
+      if (!(op->specific.sync_flags & D3D11_SB_SYNC_THREADS_IN_GROUP))
+         return false;
+      tl_close(sx);
+      ureg_BARRIER(u);
+      tl_open(sx);
+      return true;
+   case D3D10_SB_OPCODE_IF: case D3D10_SB_OPCODE_LOOP: case D3D10_SB_OPCODE_SWITCH: {
+      unsigned seq = sx->tl.seq++;
+      bool sh = seq < sx->tl.nblocks && sx->tl.shared[seq];
+      if (sx->tl.depth < 64) {
+         sx->tl.st_shared[sx->tl.depth] = sh;
+         sx->tl.st_loop[sx->tl.depth] = op->type == D3D10_SB_OPCODE_LOOP;
+         sx->tl.st_switch[sx->tl.depth] = op->type == D3D10_SB_OPCODE_SWITCH;
+         sx->tl.depth++;
+      }
+      if (sh) {
+         tl_close(sx);
+         sx->tl.post_open = true;
+      }
+      return false;
+   }
+   case D3D10_SB_OPCODE_ELSE: case D3D10_SB_OPCODE_CASE: case D3D10_SB_OPCODE_DEFAULT:
+      if (sx->tl.depth && sx->tl.st_shared[sx->tl.depth - 1]) {
+         tl_close(sx);
+         sx->tl.post_open = true;
+      }
+      return false;
+   case D3D10_SB_OPCODE_ENDIF: case D3D10_SB_OPCODE_ENDLOOP: case D3D10_SB_OPCODE_ENDSWITCH: {
+      bool sh = sx->tl.depth && sx->tl.st_shared[sx->tl.depth - 1];
+      if (sx->tl.depth)
+         sx->tl.depth--;
+      if (sh) {
+         tl_close(sx);
+         sx->tl.post_open = true;
+      }
+      return false;
+   }
+   case D3D10_SB_OPCODE_BREAK: case D3D10_SB_OPCODE_BREAKC:
+   case D3D10_SB_OPCODE_CONTINUE: case D3D10_SB_OPCODE_CONTINUEC: {
+      bool brk = op->type == D3D10_SB_OPCODE_BREAK || op->type == D3D10_SB_OPCODE_BREAKC;
+      for (int d = (int)sx->tl.depth - 1; d >= 0; d--)
+         if (sx->tl.st_loop[d] || (brk && sx->tl.st_switch[d])) {
+            if (sx->tl.st_shared[d]) {
+               tl_close(sx);
+               sx->tl.post_open = true;
+            }
+            break;
+         }
+      return false;
+   }
+   case D3D10_SB_OPCODE_RET: case D3D10_SB_OPCODE_RETC:
+      if (!sx->tl.in_segment)
+         return false;   /* at shared level: uniform, a real return */
+      if (op->type == D3D10_SB_OPCODE_RETC) {
+         struct ureg_src c = translate_src_operand(sx, &op->src[0], OF_INT);
+         if (op->specific.test_boolean == D3D10_SB_INSTRUCTION_TEST_ZERO) {
+            ureg_USEQ(u, ureg_writemask(sx->tl.t, TGSI_WRITEMASK_X), c, ureg_imm1u(u, 0));
+            c = ureg_scalar(ureg_src(sx->tl.t), TGSI_SWIZZLE_X);
+         }
+         ureg_UIF(u, c, &label);
+         ureg_MOV(u, sx->tl.retf, ureg_imm1u(u, ~0u));
+         ureg_BRK(u);
+         ureg_ENDIF(u);
+      } else {
+         /* inside an IF: an unconditional BRK followed by more code in the same block (tl_close's own BRK) is a
+          * jump in the middle of a NIR block (nir.c "cursor.instr->type != nir_instr_type_jump") */
+         ureg_UIF(u, ureg_imm1u(u, ~0u), &label);
+         ureg_MOV(u, sx->tl.retf, ureg_imm1u(u, ~0u));
+         ureg_BRK(u);
+         ureg_ENDIF(u);
+      }
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* After the normal translation. */
+static void
+tl_post(struct Shader_xlate *sx, const struct Shader_opcode *op)
+{
+   struct ureg_program *u = sx->ureg;
+   unsigned label = 0;
+   if (sx->tl.post_open) {
+      /* opened lazily before the next instruction (tl_open_pending): after an unconditional break the next opcode
+       * is usually the end of the shared block, and code after a jump in the same NIR block is invalid */
+      sx->tl.post_open = false;
+      sx->tl.need_open = true;
+      return;
+   }
+   /* a per-thread RET leaves inner loops / switches one level at a time */
+   if (sx->tl.body_ret && sx->tl.in_segment &&
+       (op->type == D3D10_SB_OPCODE_ENDLOOP || op->type == D3D10_SB_OPCODE_ENDSWITCH)) {
+      ureg_UIF(u, ureg_scalar(ureg_src(sx->tl.retf), TGSI_SWIZZLE_X), &label);
+      ureg_BRK(u);
+      ureg_ENDIF(u);
+   }
+}
