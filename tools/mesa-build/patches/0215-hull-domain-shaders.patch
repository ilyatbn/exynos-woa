+   sx->hs.cpo = ureg_DECL_array_temporary(u, MAX2(ex->hs_cp_regs, 1u), true);
+   sx->hs.pco = ureg_DECL_array_temporary(u, MAX2(ex->hs_pc_regs, 1u), true);
+   ureg_UMUL(u, ureg_writemask(sx->hs.base, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(sx->gs_state), TGSI_SWIZZLE_X),
+             ureg_imm1u(u, hs_rec_regs(ex) * 16));
+   ureg_UIF(u, ureg_scalar(ureg_src(sx->gs_state), TGSI_SWIZZLE_Y), &label);
+   sx->hs.wrapped = true;
+}
+
+/* no control-point phase: the output control points are the input ones */
+static void
+hs_passthrough(struct Shader_xlate *sx)
+{
+   const struct Shader_extra *ex = sx->extra;
+   struct ureg_program *u = sx->ureg;
+   for (unsigned k = 0; k < ex->hs_cp_out; k++)
+      for (unsigned r = 0; r < ex->hs_cp_regs && r < SHADER_MAX_INPUTS; r++)
+         if (sx->gs_in_declared[r])
+            hs_store_reg(sx, ureg_imm1u(u, ex->hs_pc_regs + k * ex->hs_cp_regs + r),
+                         ureg_src(ureg_dst_array_offset(sx->gs_in[r], (int)MIN2(k, MAX2(ex->gs_vpp, 1u) - 1))),
+                         TGSI_WRITEMASK_XYZW);
+}
+
+static void
+hs_open_loop(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   unsigned label = 0;
+   sx->hs.pending = false;
+   ureg_MOV(u, ureg_writemask(sx->hs.ctr, TGSI_WRITEMASK_X), ureg_imm1u(u, 0));
+   ureg_BGNLOOP(u, &label);
+   ureg_USGE(u, ureg_writemask(sx->hs.t, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(sx->hs.ctr), TGSI_SWIZZLE_X),
+             ureg_imm1u(u, sx->hs.count));
+   ureg_UIF(u, ureg_scalar(ureg_src(sx->hs.t), TGSI_SWIZZLE_X), &label);
+   ureg_BRK(u);
+   ureg_ENDIF(u);
+   ureg_MOV(u, sx->hs.retf, ureg_imm1u(u, 0));
+   ureg_BGNLOOP(u, &label);   /* do-once: the phase's ret is a BRK out of it */
+   sx->hs.loop_open = true;
+}
+
+static void
+hs_end_phase(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   const struct Shader_extra *ex = sx->extra;
+   unsigned label = 0;
+   if (sx->hs.pending)
+      hs_open_loop(sx);   /* a phase with no instruction still runs (and stores nothing) */
+   if (!sx->hs.loop_open)
+      return;
+   ureg_BRK(u);
+   ureg_ENDLOOP(u, &label);
+   /* this iteration's outputs into the record: control points at pc + ctr * cp + r, patch constants at r */
+   struct ureg_src ctr = ureg_scalar(ureg_src(sx->hs.ctr), TGSI_SWIZZLE_X);
+   for (unsigned r = 0; r < 32; r++) {
+      if (!sx->hs.mask[r])
+         continue;
+      if (sx->hs.phase == 1 && r < ex->hs_cp_regs) {
+         struct ureg_dst a = ureg_writemask(ureg_DECL_temporary(u), TGSI_WRITEMASK_X);
+         ureg_UMAD(u, a, ctr, ureg_imm1u(u, ex->hs_cp_regs), ureg_imm1u(u, ex->hs_pc_regs + r));
+         hs_store_reg(sx, ureg_scalar(ureg_src(a), TGSI_SWIZZLE_X), ureg_src(ureg_dst_array_offset(sx->hs.cpo, (int)r)),
+                      sx->hs.mask[r]);
+         ureg_release_temporary(u, a);
+      } else if (sx->hs.phase != 1 && r < ex->hs_pc_regs) {
+         hs_store_reg(sx, ureg_imm1u(u, r), ureg_src(ureg_dst_array_offset(sx->hs.pco, (int)r)), sx->hs.mask[r]);
+      }
+   }
+   ureg_UADD(u, ureg_writemask(sx->hs.ctr, TGSI_WRITEMASK_X), ctr, ureg_imm1u(u, 1));
+   ureg_ENDLOOP(u, &label);
+   sx->hs.loop_open = false;
+}
+
+/* the tessellator slot of a final tess-factor system value (Microsoft tessellator argument order) */
+static int
+hs_tf_slot(unsigned name)
+{
+   switch (name) {
+   case D3D11_SB_NAME_FINAL_QUAD_U_EQ_0_EDGE_TESSFACTOR: case D3D11_SB_NAME_FINAL_TRI_U_EQ_0_EDGE_TESSFACTOR: return 0;
+   case D3D11_SB_NAME_FINAL_QUAD_V_EQ_0_EDGE_TESSFACTOR: case D3D11_SB_NAME_FINAL_TRI_V_EQ_0_EDGE_TESSFACTOR: return 1;
+   case D3D11_SB_NAME_FINAL_QUAD_U_EQ_1_EDGE_TESSFACTOR: case D3D11_SB_NAME_FINAL_TRI_W_EQ_0_EDGE_TESSFACTOR: return 2;
+   case D3D11_SB_NAME_FINAL_QUAD_V_EQ_1_EDGE_TESSFACTOR: return 3;
+   case D3D11_SB_NAME_FINAL_QUAD_U_INSIDE_TESSFACTOR: case D3D11_SB_NAME_FINAL_TRI_INSIDE_TESSFACTOR: return 4;
+   case D3D11_SB_NAME_FINAL_QUAD_V_INSIDE_TESSFACTOR: return 5;
+   case D3D11_SB_NAME_FINAL_LINE_DENSITY_TESSFACTOR: return 0;   /* isoline: (density, detail) */
+   case D3D11_SB_NAME_FINAL_LINE_DETAIL_TESSFACTOR: return 1;
+   default: return -1;
+   }
+}
+
+/* Before the normal translation in hull-shader mode. TRUE = handled here. */
+static bool
+hs_pre(struct Shader_xlate *sx, const struct Shader_opcode *op)
+{
+   struct ureg_program *u = sx->ureg;
+   struct Shader_extra *ex = sx->extra;
+   unsigned label = 0;
+   switch (op->type) {
+   case D3D11_SB_OPCODE_HS_DECLS:
+      return true;
+   case D3D11_SB_OPCODE_DCL_INPUT_CONTROL_POINT_COUNT:
+      ex->hs_cp_in = op->specific.control_point_count;
+      ex->gs_vpp = op->specific.control_point_count;   /* the prologue loads this many vertices per patch */
+      return true;
+   case D3D11_SB_OPCODE_DCL_OUTPUT_CONTROL_POINT_COUNT:
+      ex->hs_cp_out = op->specific.control_point_count;
+      return true;
+   case D3D11_SB_OPCODE_DCL_TESS_DOMAIN:
+      ex->hs_domain = op->specific.tess_domain;
+      return true;
+   case D3D11_SB_OPCODE_DCL_TESS_PARTITIONING:
+      ex->hs_partitioning = op->specific.tess_partitioning;
+      return true;
+   case D3D11_SB_OPCODE_DCL_TESS_OUTPUT_PRIMITIVE:
+      ex->hs_out_prim = op->specific.tess_output_primitive;
+      return true;
+   case D3D11_SB_OPCODE_DCL_HS_MAX_TESSFACTOR:   /* enforced by the HLSL-generated code (D3D11.3 spec 10.13) */
+      return true;
+   case D3D11_SB_OPCODE_DCL_HS_FORK_PHASE_INSTANCE_COUNT:
+   case D3D11_SB_OPCODE_DCL_HS_JOIN_PHASE_INSTANCE_COUNT:
+      sx->hs.count = MAX2(op->specific.instance_count, 1u);
+      return true;
+   case D3D11_SB_OPCODE_HS_CONTROL_POINT_PHASE:
+   case D3D11_SB_OPCODE_HS_FORK_PHASE:
+   case D3D11_SB_OPCODE_HS_JOIN_PHASE:
+      hs_end_phase(sx);
+      if (op->type != D3D11_SB_OPCODE_HS_CONTROL_POINT_PHASE && !sx->hs.had_cp) {
+         hs_passthrough(sx);
+         sx->hs.had_cp = true;
+      }
+      sx->hs.phase = op->type == D3D11_SB_OPCODE_HS_CONTROL_POINT_PHASE ? 1 :
+                     op->type == D3D11_SB_OPCODE_HS_FORK_PHASE ? 2 : 3;
+      if (sx->hs.phase == 1)
+         sx->hs.had_cp = true;
+      sx->hs.count = sx->hs.phase == 1 ? MAX2(ex->hs_cp_out, 1u) : 1;
+      sx->hs.pending = true;
+      memset(sx->hs.mask, 0, sizeof sx->hs.mask);
+      return true;
+   case D3D10_SB_OPCODE_DCL_INPUT: case D3D10_SB_OPCODE_DCL_INPUT_SGV: case D3D10_SB_OPCODE_DCL_INPUT_SIV:
+      return true;   /* control points come from the prologue, the ids from the phase counter */
+   case D3D10_SB_OPCODE_DCL_OUTPUT: case D3D10_SB_OPCODE_DCL_OUTPUT_SGV: case D3D10_SB_OPCODE_DCL_OUTPUT_SIV: {
+      unsigned r = op->dst[0].base.index[0].imm;
+      unsigned m = op->dst[0].mask >> D3D10_SB_OPERAND_4_COMPONENT_MASK_SHIFT;
+      if (r < 32)
+         sx->hs.mask[r] |= (unsigned char)m;
+      int slot = op->type == D3D10_SB_OPCODE_DCL_OUTPUT_SIV ? hs_tf_slot(op->dcl_siv_name) : -1;
+      if (slot >= 0 && r < 32) {
+         ex->hs_tf_reg[slot] = (unsigned char)r;
+         ex->hs_tf_comp[slot] = (unsigned char)(m ? ffs(m) - 1 : 0);
+         ex->hs_tf_count = (unsigned char)MAX2(ex->hs_tf_count, (unsigned)slot + 1);
+      }
+      return true;
+   }
+   case D3D10_SB_OPCODE_RET: case D3D10_SB_OPCODE_RETC:
+      if (!sx->hs.loop_open)
+         return true;
+      if (op->type == D3D10_SB_OPCODE_RETC) {
+         struct ureg_src c = translate_src_operand(sx, &op->src[0], OF_INT);
+         if (op->specific.test_boolean == D3D10_SB_INSTRUCTION_TEST_ZERO) {
+            ureg_USEQ(u, ureg_writemask(sx->hs.t, TGSI_WRITEMASK_X), c, ureg_imm1u(u, 0));
+            c = ureg_scalar(ureg_src(sx->hs.t), TGSI_SWIZZLE_X);
+         }
+         ureg_UIF(u, c, &label);
+      } else {
+         ureg_UIF(u, ureg_imm1u(u, ~0u), &label);   /* a jump must end its NIR block */
+      }
+      ureg_MOV(u, sx->hs.retf, ureg_imm1u(u, ~0u));
+      ureg_BRK(u);
+      ureg_ENDIF(u);
+      return true;
+   default:
+      if (sx->hs.pending && !Shader_opcode_is_declaration(op->type))
+         hs_open_loop(sx);
+      return false;
+   }
+}
+
+static void
+hs_post(struct Shader_xlate *sx, const struct Shader_opcode *op)
+{
+   struct ureg_program *u = sx->ureg;
+   unsigned label = 0;
+   if (sx->hs.loop_open && (op->type == D3D10_SB_OPCODE_ENDLOOP || op->type == D3D10_SB_OPCODE_ENDSWITCH)) {
+      ureg_UIF(u, ureg_scalar(ureg_src(sx->hs.retf), TGSI_SWIZZLE_X), &label);   /* a ret inside a loop */
+      ureg_BRK(u);
+      ureg_ENDIF(u);
+   }
+}
+
+static void
+hs_finish(struct Shader_xlate *sx)
+{
+   hs_end_phase(sx);
+   if (!sx->hs.had_cp) {
+      hs_passthrough(sx);
+      sx->hs.had_cp = true;
+   }
+   if (sx->hs.wrapped)
+      ureg_ENDIF(sx->ureg);
+}
+
+/* a hull-shader source operand: control points, output control points, patch constants, phase ids */
+static bool
+hs_src(struct Shader_xlate *sx, const struct Shader_operand *op, struct ureg_src *reg)
+{
+   struct ureg_program *u = sx->ureg;
+   const struct Shader_extra *ex = sx->extra;
+   switch (op->type) {
+   case D3D11_SB_OPERAND_TYPE_OUTPUT_CONTROL_POINT_ID:
+   case D3D11_SB_OPERAND_TYPE_INPUT_FORK_INSTANCE_ID:
+   case D3D11_SB_OPERAND_TYPE_INPUT_JOIN_INSTANCE_ID:
+      *reg = ureg_scalar(ureg_src(sx->hs.ctr), TGSI_SWIZZLE_X);
+      return true;
+   case D3D11_SB_OPERAND_TYPE_OUTPUT_CONTROL_POINT: {   /* vocp[k][r] from this patch's record */
+      struct ureg_dst a = ureg_writemask(ureg_DECL_temporary(u), TGSI_WRITEMASK_X);
+      struct ureg_src k = op->index[0].index_rep == D3D10_SB_OPERAND_INDEX_IMMEDIATE32
+                             ? ureg_imm1u(u, op->index[0].imm)
+                             : translate_relative_value(sx, &op->index[0].rel);
+      if (op->index[0].index_rep == D3D10_SB_OPERAND_INDEX_IMMEDIATE32_PLUS_RELATIVE)
+         ureg_UADD(u, a, k, ureg_imm1u(u, op->index[0].imm));
+      else
+         ureg_MOV(u, a, k);
+      ureg_UMAD(u, a, ureg_scalar(ureg_src(a), TGSI_SWIZZLE_X), ureg_imm1u(u, ex->hs_cp_regs),
+                ureg_imm1u(u, ex->hs_pc_regs + op->index[1].imm));
+      *reg = hs_load_reg(sx, ureg_scalar(ureg_src(a), TGSI_SWIZZLE_X));
+      return true;
+   }
+   case D3D11_SB_OPERAND_TYPE_INPUT_PATCH_CONSTANT: {   /* vpc[r] (join phases): what the fork phases stored */
+      struct ureg_src idx = ureg_imm1u(u, op->index[0].imm);
+      if (op->index[0].index_rep != D3D10_SB_OPERAND_INDEX_IMMEDIATE32) {
+         struct ureg_dst a = ureg_writemask(ureg_DECL_temporary(u), TGSI_WRITEMASK_X);
+         ureg_UADD(u, a, translate_relative_value(sx, &op->index[0].rel), idx);
+         idx = ureg_scalar(ureg_src(a), TGSI_SWIZZLE_X);
+      }
+      *reg = hs_load_reg(sx, idx);
+      return true;
+   }
+   default:
+      return false;
+   }
+}
+
+/* a hull-shader output register: the current phase's array (control point or patch constant) */
+static struct ureg_dst
+hs_output_dst(struct Shader_xlate *sx, const struct Shader_operand *op)
+{
+   struct ureg_dst arr = sx->hs.phase == 1 ? sx->hs.cpo : sx->hs.pco;
+   struct ureg_dst e = ureg_dst_array_offset(arr, (int)op->index[0].imm);
+   if (op->index[0].index_rep != D3D10_SB_OPERAND_INDEX_IMMEDIATE32)
+      e = ureg_dst_indirect(e, translate_relative_operand(sx, &op->index[0].rel));
+   return e;
+}
+
+static void
+ds_begin(struct Shader_xlate *sx)
+{
+   struct ureg_program *u = sx->ureg;
+   sx->ds.domain = ureg_DECL_vs_input(u, 0);
+   sx->ds.patch = ureg_scalar(ureg_DECL_vs_input(u, 1), TGSI_SWIZZLE_X);
+   sx->ds.sview = ureg_DECL_sampler_view(u, TESS_REC_SVIEW, TGSI_TEXTURE_BUFFER, TGSI_RETURN_TYPE_UINT,
+                                         TGSI_RETURN_TYPE_UINT, TGSI_RETURN_TYPE_UINT, TGSI_RETURN_TYPE_UINT);
+   ureg_DECL_constant2D(u, 0, 0, 15);
+   sx->ds.layout = ureg_src_dimension(ureg_src_register(TGSI_FILE_CONSTANT, 0), 15);
+}
+
+/* a domain-shader source operand: domain point, control points / patch constants from the records, the patch */
+static bool
+ds_src(struct Shader_xlate *sx, const struct Shader_operand *op, struct ureg_src *reg)
+{
+   struct ureg_program *u = sx->ureg;
+   switch (op->type) {
+   case D3D11_SB_OPERAND_TYPE_INPUT_DOMAIN_POINT:
+      *reg = sx->ds.domain;
+      return true;
+   case D3D10_SB_OPERAND_TYPE_INPUT_PRIMITIVEID:
+      *reg = sx->ds.patch;
+      return true;
+   case D3D11_SB_OPERAND_TYPE_INPUT_CONTROL_POINT:
+   case D3D11_SB_OPERAND_TYPE_INPUT_PATCH_CONSTANT: {
+      bool cp = op->type == D3D11_SB_OPERAND_TYPE_INPUT_CONTROL_POINT;
+      const struct Shader_index *ix = &op->index[0];
+      struct ureg_dst e = ureg_writemask(ureg_DECL_temporary(u), TGSI_WRITEMASK_X);
+      struct ureg_dst t = ureg_writemask(ureg_DECL_temporary(u), TGSI_WRITEMASK_X);
+      /* element = patch * record + (cp ? pc + k * cp_regs + r : r) */
+      if (ix->index_rep == D3D10_SB_OPERAND_INDEX_IMMEDIATE32)
+         ureg_MOV(u, t, ureg_imm1u(u, ix->imm));
+      else
+         ureg_UADD(u, t, translate_relative_value(sx, &ix->rel), ureg_imm1u(u, ix->imm));
+      if (cp) {
+         ureg_UMAD(u, t, ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X), ureg_scalar(sx->ds.layout, TGSI_SWIZZLE_Z),
+                   ureg_scalar(sx->ds.layout, TGSI_SWIZZLE_Y));
+         ureg_UADD(u, t, ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X), ureg_imm1u(u, op->index[1].imm));
+      }
+      ureg_UMAD(u, e, sx->ds.patch, ureg_scalar(sx->ds.layout, TGSI_SWIZZLE_X), ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X));
+      struct ureg_dst d = ureg_DECL_temporary(u);
+      ureg_MOV(u, ureg_writemask(e, TGSI_WRITEMASK_YZW), ureg_imm1u(u, 0));
+      struct ureg_src s[2] = { ureg_src(e), sx->ds.sview };   /* the translator's ld form: SAMPLE_I coord, t# */
+      ureg_tex_insn(u, TGSI_OPCODE_SAMPLE_I, &d, 1, TGSI_TEXTURE_UNKNOWN, NULL, 0, s, 2);
+      *reg = ureg_src(d);
+      return true;
+   }
+   default:
+      return false;
+   }
+}
