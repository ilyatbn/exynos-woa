diff --git a/src/gallium/frontends/d3d10umd/TessEmu.cpp b/src/gallium/frontends/d3d10umd/TessEmu.cpp
new file mode 100644
index 0000000..de08f9f
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/TessEmu.cpp
@@ -0,0 +1,574 @@
+/*
+ * TessEmu.cpp - exynos-woa G34 F11.10 (notes/g34-fl11.md): hull and domain shaders on a GPU without a tessellation
+ * stage (Panfrost / Mali-G76).
+ *
+ * Per draw with a patch-list topology and both shaders bound:
+ *   1. the bound VS with stream output of every output register captures the referenced vertices into A
+ *      (GsEmu's VS variant and layout);
+ *   2. the hull shader, translated into a compute shader (ShaderTGSI.c hs_*: one invocation per patch, the
+ *      GS-as-compute prologue loads the control points from A), writes one record per patch into B:
+ *      [hs_pc_regs patch-constant vec4s][hs_cp_out x hs_cp_regs control-point vec4s];
+ *   3. the tess factors are read back and tessellated on the CPU with the Microsoft reference tessellator in
+ *      gallium/auxiliary/tessellator (MIT; pow2 partitioning is integer at this level - D3D11.3 spec 10.13 and the
+ *      reference's comments); identical factor sets share one pattern;
+ *   4. the domain shader, translated into a vertex shader (ShaderTGSI.c ds_*), draws every pattern instanced over
+ *      its patches: vertex input 0 = the domain point, input 1 = the patch (per instance), records from B through
+ *      sampler view TESS_REC_SVIEW, CONST[15][0] = {record vec4s, patch-constant vec4s, control-point vec4s}.
+ * Limits of this first version: no hull-shader SRVs / samplers, no geometry shader after the domain shader, a GPU
+ * sync per tessellated draw (the factor read-back).
+ */
+
+#include "TessEmu.h"
+#include "GsEmu.h"
+#include "State.h"
+#include "Shader.h"
+#include "ShaderParse.h"
+#include "Debug.h"
+
+#include "nir/tgsi_to_nir.h"
+#include "tessellator/p_tessellator.h"
+#include "tgsi/tgsi_ureg.h"
+#include "util/u_draw.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+#include "util/u_upload_mgr.h"
+#include "cso_cache/cso_context.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include <string.h>
+
+extern "C" void malikm_tlog(const char *fmt, ...);
+
+struct TessPattern {
+   unsigned first_vtx, nvtx, first_idx, nidx;
+   std::vector<uint32_t> patches;
+};
+
+struct TessEmu {
+   struct pipe_resource *a, *b, *vtx, *idx, *pat;
+   unsigned a_size, b_size, vtx_size, idx_size, pat_size;
+   struct pipe_stream_output_target *so;
+   void *rs_discard;
+   struct pipe_tessellator *ts;
+   unsigned ts_key;
+};
+
+static bool
+ensure(struct pipe_screen *screen, struct pipe_resource **res, unsigned *cur, unsigned size, unsigned bind)
+{
+   if (*res && *cur >= size)
+      return true;
+   unsigned s = 4096;
+   while (s < size)
+      s *= 2;
+   pipe_resource_reference(res, NULL);
+   *res = pipe_buffer_create(screen, bind, PIPE_USAGE_DEFAULT, s);
+   *cur = *res ? s : 0;
+   return *res != NULL;
+}
+
+static struct TessEmu *
+tess_get(Device *dev)
+{
+   if (!dev->tess_emu) {
+      dev->tess_emu = CALLOC_STRUCT(TessEmu);
+      if (dev->tess_emu) {
+         struct pipe_rasterizer_state rs;
+         memset(&rs, 0, sizeof rs);
+         rs.rasterizer_discard = 1;
+         rs.half_pixel_center = 1;
+         rs.depth_clip_near = rs.depth_clip_far = 1;
+         dev->tess_emu->rs_discard = dev->pipe->create_rasterizer_state(dev->pipe, &rs);
+      }
+   }
+   return dev->tess_emu;
+}
+
+/* ---- shaders ---- */
+
+static unsigned
+regs_of(const void *entries, unsigned count, size_t stride)
+{
+   unsigned n = 0;
+   for (unsigned i = 0; i < count; i++) {
+      const D3D10DDIARG_SIGNATURE_ENTRY *e = (const D3D10DDIARG_SIGNATURE_ENTRY *)((const char *)entries + i * stride);
+      if (e->Register != ~0u)
+         n = MAX2(n, e->Register + 1);
+   }
+   return n;
+}
+
+static void
+create_tess_shader(D3D10DDI_HDEVICE hDevice, const UINT *code, D3D10DDI_HSHADER hShader, bool hull,
+                   unsigned in_regs, unsigned out_regs, unsigned pc_regs)
+{
+   Device *dev = CastDevice(hDevice);
+   struct pipe_context *pipe = dev->pipe;
+   Shader *s = CastShader(hShader);
+   memset(s, 0, sizeof *s);
+   s->type = hull ? MESA_SHADER_TESS_CTRL : MESA_SHADER_TESS_EVAL;
+   s->extra = (struct Shader_extra *)CALLOC_STRUCT(Shader_extra);
+   if (!s->extra) {
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   s->extra->hs_as_cs = hull;
+   s->extra->ds_as_vs = !hull;
+   s->extra->hs_in_regs = in_regs;
+   s->extra->hs_cp_regs = out_regs;
+   s->extra->hs_pc_regs = pc_regs;
+   const struct tgsi_token *tokens = Shader_tgsi_translate_ex(code, hull ? NULL : s->output_mapping, s->extra);
+   /* the translation resets extra (keeps the requests): restore the layout inputs */
+   s->extra->hs_in_regs = in_regs;
+   s->extra->hs_cp_regs = out_regs;
+   s->extra->hs_pc_regs = pc_regs;
+   if (!tokens) {
+      malikm_tlog("TessEmu: %s shader translation failed", hull ? "hull" : "domain");
+      return;
+   }
+   if (hull) {
+      nir_shader *nir = tgsi_to_nir(tokens, pipe->screen, false);
+      ureg_free_tokens(tokens);
+      struct pipe_compute_state cs;
+      memset(&cs, 0, sizeof cs);
+      cs.ir_type = PIPE_SHADER_IR_NIR;
+      cs.prog = nir;
+      s->handle = pipe->create_compute_state(pipe, &cs);
+   } else {
+      s->state.tokens = tokens;
+      s->output_resolved = true;
+      s->handle = pipe->create_vs_state(pipe, &s->state);
+   }
+   const struct Shader_extra *ex = s->extra;
+   malikm_tlog("TessEmu: %s shader %p: in %u out %u pc %u regs; cp in %u out %u, domain %u partitioning %u prim %u, "
+               "%u tess factors -> %p", hull ? "hull" : "domain", s, in_regs, out_regs, pc_regs, ex->hs_cp_in,
+               ex->hs_cp_out, ex->hs_domain, ex->hs_partitioning, ex->hs_out_prim, ex->hs_tf_count, s->handle);
+}
+
+#define TESS_CREATE(Prefix, SigType, EntryType)                                                                    \
+   SIZE_T APIENTRY Prefix##CalcPrivateTessellationShaderSize(D3D10DDI_HDEVICE, const UINT *, const SigType *)     \
+   {                                                                                                              \
+      return sizeof(Shader);                                                                                     \
+   }                                                                                                              \
+   void APIENTRY Prefix##CreateHullShader(D3D10DDI_HDEVICE hDevice, const UINT *code, D3D10DDI_HSHADER hShader,   \
+                                          D3D10DDI_HRTSHADER, const SigType *sig)                               \
+   {                                                                                                              \
+      LOG_ENTRYPOINT();                                                                                          \
+      create_tess_shader(hDevice, code, hShader, true,                                                           \
+                         regs_of(sig->pInputSignature, sig->NumInputSignatureEntries, sizeof(EntryType)),          \
+                         regs_of(sig->pOutputSignature, sig->NumOutputSignatureEntries, sizeof(EntryType)),        \
+                         regs_of(sig->pPatchConstantSignature, sig->NumPatchConstantSignatureEntries,             \
+                                 sizeof(EntryType)));                                                             \
+   }                                                                                                              \
+   void APIENTRY Prefix##CreateDomainShader(D3D10DDI_HDEVICE hDevice, const UINT *code, D3D10DDI_HSHADER hShader, \
+                                            D3D10DDI_HRTSHADER, const SigType *sig)                             \
+   {                                                                                                              \
+      LOG_ENTRYPOINT();                                                                                          \
+      create_tess_shader(hDevice, code, hShader, false,                                                          \
+                         regs_of(sig->pInputSignature, sig->NumInputSignatureEntries, sizeof(EntryType)),          \
+                         regs_of(sig->pInputSignature, sig->NumInputSignatureEntries, sizeof(EntryType)),          \
+                         regs_of(sig->pPatchConstantSignature, sig->NumPatchConstantSignatureEntries,             \
+                                 sizeof(EntryType)));                                                             \
+   }
+
+TESS_CREATE(Tess11_, D3D11DDIARG_TESSELLATION_IO_SIGNATURES, D3D10DDIARG_SIGNATURE_ENTRY)
+TESS_CREATE(Tess111_, D3D11_1DDIARG_TESSELLATION_IO_SIGNATURES, D3D11_1DDIARG_SIGNATURE_ENTRY2)
+
+/* ---- state ---- */
+
+void APIENTRY
+HsSetShader(D3D10DDI_HDEVICE hDevice, D3D10DDI_HSHADER hShader)
+{
+   LOG_ENTRYPOINT();
+   CastDevice(hDevice)->bound_hs = hShader.pDrvPrivate ? CastShader(hShader) : NULL;
+}
+
+void APIENTRY
+DsSetShader(D3D10DDI_HDEVICE hDevice, D3D10DDI_HSHADER hShader)
+{
+   LOG_ENTRYPOINT();
+   CastDevice(hDevice)->bound_ds = hShader.pDrvPrivate ? CastShader(hShader) : NULL;
+}
+
+/* hull / domain constant buffers are only recorded (DeviceTrackConstantBuffer): bound to the compute / vertex stage
+ * by TessEmuDraw - there is no hardware stage for them */
+static void
+track_cbs(D3D10DDI_HDEVICE hDevice, mesa_shader_stage stage, UINT start, UINT num, const D3D10DDI_HRESOURCE *ph,
+          const UINT *first, const UINT *count)
+{
+   Device *dev = CastDevice(hDevice);
+   for (UINT i = 0; i < num; i++) {
+      Resource *res = CastResource(ph[i]);
+      struct pipe_constant_buffer cb;
+      memset(&cb, 0, sizeof cb);
+      if (res && res->resource) {
+         unsigned w = res->resource->width0, off = first ? first[i] * 16u : 0, size = count ? count[i] * 16u : 0;
+         if (off > w)
+            off = w;
+         if (!size || size > w - off)
+            size = w - off;
+         cb.buffer = res->cb_buf ? res->cb_buf : res->resource;
+         cb.buffer_offset = (res->cb_buf ? res->cb_offset : 0) + off;
+         cb.buffer_size = size;
+      }
+      DeviceTrackConstantBuffer(dev, stage, start + i, &cb);
+   }
+}
+
+void APIENTRY
+HsSetConstantBuffers(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HRESOURCE *ph)
+{
+   LOG_ENTRYPOINT();
+   track_cbs(hDevice, MESA_SHADER_TESS_CTRL, start, num, ph, NULL, NULL);
+}
+
+void APIENTRY
+DsSetConstantBuffers(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HRESOURCE *ph)
+{
+   LOG_ENTRYPOINT();
+   track_cbs(hDevice, MESA_SHADER_TESS_EVAL, start, num, ph, NULL, NULL);
+}
+
+void APIENTRY
+HsSetConstantBuffers11(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HRESOURCE *ph,
+                       const UINT *first, const UINT *count)
+{
+   LOG_ENTRYPOINT();
+   track_cbs(hDevice, MESA_SHADER_TESS_CTRL, start, num, ph, first, count);
+}
+
+void APIENTRY
+DsSetConstantBuffers11(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HRESOURCE *ph,
+                       const UINT *first, const UINT *count)
+{
+   LOG_ENTRYPOINT();
+   track_cbs(hDevice, MESA_SHADER_TESS_EVAL, start, num, ph, first, count);
+}
+
+void APIENTRY
+HsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HSHADERRESOURCEVIEW *ph)
+{
+   LOG_ENTRYPOINT();
+   (void)hDevice; (void)start;
+   for (UINT i = 0; i < num; i++)
+      if (ph[i].pDrvPrivate) {
+         static unsigned logged;
+         if (logged++ < 4)
+            malikm_tlog("TessEmu: hull-shader SRVs are not supported yet");
+         LOG_UNSUPPORTED(true);
+         break;
+      }
+}
+
+void APIENTRY
+HsSetSamplers(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HSAMPLER *ph)
+{
+   LOG_ENTRYPOINT();
+   (void)hDevice; (void)start; (void)num; (void)ph;
+}
+
+void APIENTRY
+DsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HSHADERRESOURCEVIEW *ph)
+{
+   LOG_ENTRYPOINT();
+   Device *dev = CastDevice(hDevice);
+   for (UINT i = 0; i < num && start + i < PIPE_MAX_SHADER_SAMPLER_VIEWS; i++) {
+      dev->ds_views[start + i] = CastPipeShaderResourceView(ph[i]);
+      dev->ds_view_count = MAX2(dev->ds_view_count, start + i + 1);
+   }
+}
+
+void APIENTRY
+DsSetSamplers(D3D10DDI_HDEVICE hDevice, UINT start, UINT num, const D3D10DDI_HSAMPLER *ph)
+{
+   LOG_ENTRYPOINT();
+   Device *dev = CastDevice(hDevice);
+   for (UINT i = 0; i < num && start + i < PIPE_MAX_SAMPLERS; i++)
+      dev->ds_samplers[start + i] = CastPipeSamplerState(ph[i]);
+}
+
+/* ---- the draw ---- */
+
+static unsigned
+spacing_of(unsigned partitioning)
+{
+   switch (partitioning) {
+   case D3D11_SB_TESSELLATOR_PARTITIONING_FRACTIONAL_ODD: return PIPE_TESS_SPACING_FRACTIONAL_ODD;
+   case D3D11_SB_TESSELLATOR_PARTITIONING_FRACTIONAL_EVEN: return PIPE_TESS_SPACING_FRACTIONAL_EVEN;
+   default: return PIPE_TESS_SPACING_EQUAL;   /* integer, pow2 */
+   }
+}
+
+bool
+TessEmuDraw(Device *dev, const struct pipe_draw_info *info, const struct pipe_draw_start_count_bias *draw)
+{
+   Shader *hs = dev->bound_hs, *ds = dev->bound_ds, *vs = dev->bound_vs;
+   struct pipe_context *pipe = dev->pipe;
+   static unsigned logged;
+   if (!hs || !ds || !hs->handle || !hs->extra || !ds->handle || !ds->extra || !vs || !vs->handle ||
+       !vs->state.tokens || dev->bound_gs_emu) {
+      if (logged++ < 4)
+         malikm_tlog("TessEmu: patch draw without a usable HS / DS / VS (or with a GS) - skipped");
+      return true;
+   }
+   const struct Shader_extra *ex = hs->extra;
+   unsigned cps = MAX2(dev->patch_cp, 1u);
+   unsigned inst = info->instance_count ? info->instance_count : 1;
+   unsigned ppi = draw->count / cps, n = ppi * inst;
+   bool indexed = info->index_size != 0;
+   unsigned nv = indexed ? GsEmuVertexExtent(dev) : draw->count, vbase = indexed ? 0 : draw->start;
+   unsigned rec = ex->hs_pc_regs + ex->hs_cp_out * ex->hs_cp_regs;
+   if (!n || !rec || ex->hs_tf_count < 2)
+      return true;
+   if (!GsEmuMakeSoVs(pipe, vs))
+      return true;
+   struct TessEmu *e = tess_get(dev);
+   if (!e || !e->rs_discard)
+      return true;
+   unsigned vs_stride = vs->gs_so_regs * 16, a_need = nv * inst * vs_stride, b_need = n * rec * 16;
+   struct pipe_resource *old_a = e->a;
+   if (!ensure(pipe->screen, &e->a, &e->a_size, a_need, PIPE_BIND_STREAM_OUTPUT | PIPE_BIND_SHADER_BUFFER) ||
+       !ensure(pipe->screen, &e->b, &e->b_size, b_need, PIPE_BIND_SHADER_BUFFER | PIPE_BIND_SAMPLER_VIEW))
+      return true;
+   if (!e->so || e->a != old_a) {
+      pipe_so_target_reference(&e->so, NULL);
+      e->so = pipe->create_stream_output_target(pipe, e->a, 0, e->a_size);
+      if (!e->so)
+         return true;
+   }
+
+   /* 1. VS outputs -> A */
+   pipe->bind_vs_state(pipe, vs->gs_so_vs);
+   pipe->bind_rasterizer_state(pipe, e->rs_discard);
+   unsigned zero = 0;
+   pipe->set_stream_output_targets(pipe, 1, &e->so, &zero, MESA_PRIM_POINTS);
+   {
+      struct pipe_draw_info pi;
+      util_draw_init_info(&pi);
+      pi.mode = MESA_PRIM_POINTS;
+      pi.start_instance = info->start_instance;
+      pi.instance_count = inst;
+      struct pipe_draw_start_count_bias pd;
+      memset(&pd, 0, sizeof pd);
+      pd.start = vbase;
+      pd.count = nv;
+      pipe->draw_vbo(pipe, &pi, 0, NULL, &pd, 1);
+   }
+   pipe->set_stream_output_targets(pipe, 0, NULL, NULL, MESA_PRIM_UNKNOWN);
+   if (dev->bound_rs)
+      pipe->bind_rasterizer_state(pipe, dev->bound_rs);
+   pipe->memory_barrier(pipe, PIPE_BARRIER_STREAMOUT_BUFFER | PIPE_BARRIER_SHADER_BUFFER);
+
+   /* 2. the hull shader: A -> B (prologue parameters as GsEmu: topology 0 = list of cps-vertex patches) */
+   pipe->bind_compute_state(pipe, hs->handle);
+   struct pipe_shader_buffer sb[4];
+   memset(sb, 0, sizeof sb);
+   sb[0].buffer = e->a; sb[0].buffer_size = a_need;
+   sb[1].buffer = e->b; sb[1].buffer_size = b_need;
+   sb[2].buffer = e->a; sb[2].buffer_size = a_need;   /* declared by the prologue, unused */
+   struct pipe_resource *ib = indexed && info->index.resource ? info->index.resource : e->a;
+   unsigned ib_size = MAX2(ib->width0, 4u) & ~3u;
+   sb[3].buffer = ib; sb[3].buffer_size = ib_size;
+   pipe->set_shader_buffers(pipe, MESA_SHADER_COMPUTE, 0, 4, sb, 0x2);
+   for (unsigned s = 0; s < GS_EMU_TRACKED_CBS - 1; s++)
+      pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, s, &dev->tracked_cb[TRACKED_CB_HS][s]);
+   uint32_t param[12] = { n, vs_stride, 0, MAX2(ppi, 1u), draw->start, indexed ? info->index_size : 0u,
+                          (uint32_t)draw->index_bias, nv, vbase, ib_size, nv * inst, 0 };
+   struct pipe_constant_buffer pcb;
+   memset(&pcb, 0, sizeof pcb);
+   u_upload_data_ref(pipe->const_uploader, 0, sizeof param, 256, param, &pcb.buffer_offset, &pcb.buffer);
+   u_upload_unmap(pipe->const_uploader);
+   pcb.buffer_size = sizeof param;
+   pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, GS_EMU_TRACKED_CBS - 1, &pcb);
+   pipe_resource_reference(&pcb.buffer, NULL);
+   struct pipe_grid_info grid;
+   memset(&grid, 0, sizeof grid);
+   grid.block[0] = 64;
+   grid.block[1] = grid.block[2] = 1;
+   grid.grid[0] = (n + 63) / 64;
+   grid.grid[1] = grid.grid[2] = 1;
+   pipe->launch_grid(pipe, &grid);
+   pipe->memory_barrier(pipe, PIPE_BARRIER_ALL);
+   pipe->set_shader_buffers(pipe, MESA_SHADER_COMPUTE, 0, 4, NULL, 0);
+   for (unsigned s = 0; s < GS_EMU_TRACKED_CBS; s++)
+      pipe->set_constant_buffer(pipe, MESA_SHADER_COMPUTE, s, &dev->tracked_cb[TRACKED_CB_CS][s]);
+   pipe->bind_compute_state(pipe, dev->bound_cs ? dev->bound_cs->handle : NULL);
+
+   /* 3. tess factors back, patterns on the CPU */
+   enum mesa_prim tprim = ex->hs_domain == D3D11_SB_TESSELLATOR_DOMAIN_QUAD ? MESA_PRIM_QUADS :
+                          ex->hs_domain == D3D11_SB_TESSELLATOR_DOMAIN_ISOLINE ? MESA_PRIM_LINES : MESA_PRIM_TRIANGLES;
+   bool points = ex->hs_out_prim == D3D11_SB_TESSELLATOR_OUTPUT_POINT;
+   bool cw = ex->hs_out_prim == D3D11_SB_TESSELLATOR_OUTPUT_TRIANGLE_CW;
+   unsigned key = (unsigned)tprim | spacing_of(ex->hs_partitioning) << 8 | (cw ? 1u << 16 : 0) | (points ? 1u << 17 : 0);
+   if (!e->ts || e->ts_key != key) {
+      if (e->ts)
+         p_tess_destroy(e->ts);
+      e->ts = p_tess_init(tprim, (enum pipe_tess_spacing)spacing_of(ex->hs_partitioning), cw, points);
+      e->ts_key = key;
+   }
+   if (!e->ts)
+      return true;
+   std::vector<float> V;
+   std::vector<uint32_t> I;
+   std::vector<TessPattern> pats;
+   std::unordered_map<std::string, unsigned> lookup;
+   {
+      struct pipe_transfer *t = NULL;
+      const uint8_t *m = (const uint8_t *)pipe_buffer_map_range(pipe, e->b, 0, b_need, PIPE_MAP_READ, &t);
+      if (!m)
+         return true;
+      for (unsigned p = 0; p < n; p++) {
+         struct pipe_tessellation_factors f;
+         memset(&f, 0, sizeof f);
+         float tf[6] = {};
+         for (unsigned k = 0; k < ex->hs_tf_count && k < 6; k++)
+            memcpy(&tf[k], m + p * rec * 16 + ex->hs_tf_reg[k] * 16 + ex->hs_tf_comp[k] * 4, 4);
+         memcpy(f.outer_tf, tf, 4 * sizeof(float));
+         if (tprim == MESA_PRIM_TRIANGLES) {
+            f.outer_tf[3] = 0;
+            f.inner_tf[0] = tf[4];
+         } else if (tprim == MESA_PRIM_QUADS) {
+            f.inner_tf[0] = tf[4];
+            f.inner_tf[1] = tf[5];
+         }
+         std::string k((const char *)&f, sizeof f.outer_tf + sizeof f.inner_tf);
+         auto it = lookup.find(k);
+         if (it == lookup.end()) {
+            struct pipe_tessellator_data d;
+            memset(&d, 0, sizeof d);
+            p_tessellate(e->ts, &f, &d);
+            TessPattern tp;
+            tp.first_vtx = (unsigned)(V.size() / 4);
+            tp.nvtx = d.num_domain_points;
+            tp.first_idx = (unsigned)I.size();
+            tp.nidx = d.num_indices;
+            for (unsigned i = 0; i < d.num_domain_points; i++) {
+               float u = d.domain_points_u[i], v = d.domain_points_v[i];
+               V.push_back(u);
+               V.push_back(v);
+               V.push_back(tprim == MESA_PRIM_TRIANGLES ? 1.0f - u - v : 0.0f);
+               V.push_back(0.0f);
+            }
+            I.insert(I.end(), d.indices, d.indices + d.num_indices);
+            it = lookup.emplace(k, (unsigned)pats.size()).first;
+            pats.push_back(tp);
+         }
+         pats[it->second].patches.push_back(p);
+      }
+      pipe_buffer_unmap(pipe, t);
+   }
+   std::vector<uint32_t> P;
+   std::vector<unsigned> first_inst;
+   for (auto &tp : pats) {
+      first_inst.push_back((unsigned)P.size());
+      P.insert(P.end(), tp.patches.begin(), tp.patches.end());
+   }
+   if (V.empty() || I.empty())
+      return true;   /* every patch culled */
+   if (!ensure(pipe->screen, &e->vtx, &e->vtx_size, (unsigned)(V.size() * 4), PIPE_BIND_VERTEX_BUFFER) ||
+       !ensure(pipe->screen, &e->idx, &e->idx_size, (unsigned)(I.size() * 4), PIPE_BIND_INDEX_BUFFER) ||
+       !ensure(pipe->screen, &e->pat, &e->pat_size, (unsigned)(P.size() * 4), PIPE_BIND_VERTEX_BUFFER))
+      return true;
+   pipe_buffer_write(pipe, e->vtx, 0, (unsigned)(V.size() * 4), V.data());
+   pipe_buffer_write(pipe, e->idx, 0, (unsigned)(I.size() * 4), I.data());
+   pipe_buffer_write(pipe, e->pat, 0, (unsigned)(P.size() * 4), P.data());
+
+   /* 4. the domain shader over the patterns */
+   pipe->bind_vs_state(pipe, ds->handle);
+   struct cso_velems_state ve;
+   memset(&ve, 0, sizeof ve);
+   ve.count = 2;
+   ve.velems[0].src_format = PIPE_FORMAT_R32G32B32A32_FLOAT;
+   ve.velems[0].src_stride = 16;
+   ve.velems[0].vertex_buffer_index = 0;
+   ve.velems[1].src_format = PIPE_FORMAT_R32_UINT;
+   ve.velems[1].src_stride = 4;
+   ve.velems[1].vertex_buffer_index = 1;
+   ve.velems[1].instance_divisor = 1;
+   cso_set_vertex_elements(dev->cso, &ve);
+   struct pipe_vertex_buffer vb[2];
+   memset(vb, 0, sizeof vb);
+   vb[0].buffer.resource = e->vtx;
+   vb[1].buffer.resource = e->pat;
+   cso_set_vertex_buffers(dev->cso, 2, vb);
+   struct pipe_sampler_view tmpl, *sv;
+   memset(&tmpl, 0, sizeof tmpl);
+   tmpl.format = PIPE_FORMAT_R32G32B32A32_UINT;
+   tmpl.target = PIPE_BUFFER;
+   tmpl.swizzle_r = PIPE_SWIZZLE_X; tmpl.swizzle_g = PIPE_SWIZZLE_Y;
+   tmpl.swizzle_b = PIPE_SWIZZLE_Z; tmpl.swizzle_a = PIPE_SWIZZLE_W;
+   tmpl.u.buf.offset = 0;
+   tmpl.u.buf.size = b_need;
+   sv = pipe->create_sampler_view(pipe, e->b, &tmpl);
+   if (dev->ds_view_count)
+      pipe->set_sampler_views(pipe, MESA_SHADER_VERTEX, 0, dev->ds_view_count, 0, dev->ds_views);
+   pipe->set_sampler_views(pipe, MESA_SHADER_VERTEX, TESS_REC_SVIEW, 1, 0, &sv);
+   pipe->bind_sampler_states(pipe, MESA_SHADER_VERTEX, 0, PIPE_MAX_SAMPLERS, dev->ds_samplers);
+   for (unsigned s = 0; s < GS_EMU_TRACKED_CBS - 1; s++)
+      pipe->set_constant_buffer(pipe, MESA_SHADER_VERTEX, s, &dev->tracked_cb[TRACKED_CB_DS][s]);
+   uint32_t layout[4] = { rec, ex->hs_pc_regs, ex->hs_cp_regs, 0 };
+   memset(&pcb, 0, sizeof pcb);
+   u_upload_data_ref(pipe->const_uploader, 0, sizeof layout, 256, layout, &pcb.buffer_offset, &pcb.buffer);
+   u_upload_unmap(pipe->const_uploader);
+   pcb.buffer_size = sizeof layout;
+   pipe->set_constant_buffer(pipe, MESA_SHADER_VERTEX, GS_EMU_TRACKED_CBS - 1, &pcb);
+   pipe_resource_reference(&pcb.buffer, NULL);
+   enum mesa_prim mode = points ? MESA_PRIM_POINTS : tprim == MESA_PRIM_LINES ? MESA_PRIM_LINES : MESA_PRIM_TRIANGLES;
+   for (unsigned i = 0; i < pats.size(); i++) {
+      const TessPattern &tp = pats[i];
+      if (!tp.nidx)
+         continue;
+      struct pipe_draw_info di;
+      util_draw_init_info(&di);
+      di.mode = mode;
+      di.index_size = 4;
+      di.index.resource = e->idx;
+      di.start_instance = first_inst[i];
+      di.instance_count = (unsigned)tp.patches.size();
+      struct pipe_draw_start_count_bias dd;
+      memset(&dd, 0, sizeof dd);
+      dd.start = tp.first_idx;
+      dd.count = tp.nidx;
+      dd.index_bias = (int)tp.first_vtx;
+      pipe->draw_vbo(pipe, &di, 0, NULL, &dd, 1);
+   }
+
+   /* the application's vertex-stage state back */
+   pipe->bind_vs_state(pipe, vs->handle);
+   dev->velems_changed = TRUE;
+   dev->vbuffers_changed = TRUE;
+   pipe->set_sampler_views(pipe, MESA_SHADER_VERTEX, 0, PIPE_MAX_SHADER_SAMPLER_VIEWS, 0,
+                           dev->sampler_views[MESA_SHADER_VERTEX]);
+   pipe->sampler_view_release(pipe, sv);
+   pipe->bind_sampler_states(pipe, MESA_SHADER_VERTEX, 0, PIPE_MAX_SAMPLERS, dev->samplers[MESA_SHADER_VERTEX]);
+   for (unsigned s = 0; s < GS_EMU_TRACKED_CBS; s++)
+      pipe->set_constant_buffer(pipe, MESA_SHADER_VERTEX, s, &dev->tracked_cb[TRACKED_CB_VS][s]);
+
+   if (logged++ < 8)
+      malikm_tlog("TessEmu draw: %u patches of %u points (x%u), %u patterns, %u domain points, %u indices, record %u "
+                  "vec4s (pc %u, cp %u x %u)", n, cps, inst, (unsigned)pats.size(), (unsigned)(V.size() / 4),
+                  (unsigned)I.size(), rec, ex->hs_pc_regs, ex->hs_cp_out, ex->hs_cp_regs);
+   return true;
+}
+
+void
+TessEmuDestroyDevice(Device *dev)
+{
+   struct TessEmu *e = dev->tess_emu;
+   if (!e)
+      return;
+   pipe_so_target_reference(&e->so, NULL);
+   pipe_resource_reference(&e->a, NULL);
+   pipe_resource_reference(&e->b, NULL);
+   pipe_resource_reference(&e->vtx, NULL);
+   pipe_resource_reference(&e->idx, NULL);
+   pipe_resource_reference(&e->pat, NULL);
+   if (e->rs_discard)
+      dev->pipe->delete_rasterizer_state(dev->pipe, e->rs_discard);
+   if (e->ts)
+      p_tess_destroy(e->ts);
+   FREE(e);
+   dev->tess_emu = NULL;
+}
