diff --git a/src/gallium/frontends/d3d10umd/Video.cpp b/src/gallium/frontends/d3d10umd/Video.cpp
index 4604c13..8fc3818 100644
--- a/src/gallium/frontends/d3d10umd/Video.cpp
+++ b/src/gallium/frontends/d3d10umd/Video.cpp
@@ -315,17 +315,14 @@ Vid_CreateVideoDecoder(D3D10DDI_HDEVICE hDevice, CONST D3D11_1DDIARG_CREATEVIDEO
    }
    d->Desc = pArgs->Desc;
    d->Config = pArgs->Config;
-   d->Mfc = MfcOpen();
-   if (d->Mfc == INVALID_HANDLE_VALUE) {
-      /* no MFC (driver missing, busy with another session, or not reachable from this process): the caller falls
-       * back to its software decoder */
-      return E_FAIL;
-   }
+   /* exynos-woa G35: the MFC session (one per device) is opened at the first DecoderBeginFrame, not here. Chromium
+    * creates a decoder at initialisation and a second one at the stream's coded size (1920x1080 -> 1920x1088) before
