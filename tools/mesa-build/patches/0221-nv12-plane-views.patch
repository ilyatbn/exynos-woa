+ * (CbCr pairs) at W/2 texels per row. One alias per (slice, plane), kept until the resource goes. */
+struct pipe_resource *
+Nv12ViewResource(struct pipe_screen *screen, Resource *r, DXGI_FORMAT format, UINT firstSlice, UINT arraySize)
+{
