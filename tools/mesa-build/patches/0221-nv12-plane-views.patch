+/* exynos-woa G35 (notes/g35-browser-video.md): a linear single-level resource over part of a LINEAR base resource's
+ * BO - D3D11 NV12 plane views (DXGI_FORMAT_NV12: R8 views select the luma plane, R8G8 views the chroma plane), the
+ * frontend storing NV12 as one R8 surface. The alias starts at row first_row of the base's array layer `layer`
+ * (level 0) with the base's row pitch; the layout is explicit (like an import), the BO is shared by reference, and
+ * every access is tracked on the base (alias_of, pan_track_rsrc), so writes through the base and reads through the
+ * alias (and the reverse) order correctly. */
+struct pipe_resource *
+panfrost_resource_create_alias(struct pipe_screen *pscreen, struct pipe_resource *base_p,
+                               const struct pipe_resource *templat, unsigned layer, unsigned first_row)
+{
+   struct panfrost_resource *base = pan_resource(base_p);
+
+   if (!base->bo || base->modifier != DRM_FORMAT_MOD_LINEAR || base->alias_of || base->base.last_level != 0 ||
+       layer >= MAX2(base->base.array_size, 1) || first_row >= base->base.height0 ||
+       util_format_get_num_planes(base->base.format) != 1 ||
+       util_format_get_num_planes(templat->format) != 1 || templat->last_level != 0 ||
+       MAX2(templat->nr_samples, 1) != 1)
+      return NULL;
+
+   const struct pan_image_slice_layout *bs = &base->plane.layout.slices[0];
+   const uint32_t row_pitch_B = bs->tiled_or_linear.row_stride_B;
+   const uint64_t offset_B = bs->offset_B + (uint64_t)layer * base->plane.layout.array_stride_B +
+                             (uint64_t)first_row * row_pitch_B;
+
+   struct panfrost_resource *rsc = CALLOC_STRUCT(panfrost_resource);
+   if (!rsc)
+      return NULL;
+   struct pipe_resource *prsc = &rsc->base;
+   *prsc = *templat;
+   pipe_reference_init(&prsc->reference, 1);
+   util_range_init(&rsc->valid_buffer_range);
+   threaded_resource_init(prsc, false);
+   prsc->screen = pscreen;
+   prsc->next = NULL;
+
+   rsc->modifier = DRM_FORMAT_MOD_LINEAR;
+   struct pan_image_layout_constraints explicit_layout = {
+      .offset_B = offset_B,
+      .wsi_row_pitch_B = row_pitch_B,
+      .strict = true,
+   };
+   struct pan_image_props iprops = {
+      .modifier = DRM_FORMAT_MOD_LINEAR,
+      .format = templat->format,
+      .dim = panfrost_translate_texture_dimension(templat->target),
+      .extent_px = {
+         .width = templat->width0,
+         .height = templat->height0,
+         .depth = 1,
+      },
+      .array_size = MAX2(templat->array_size, 1),
+      .nr_samples = 1,
+      .nr_slices = 1,
+   };
+   if (!panfrost_resource_init_image(pscreen, rsc, &iprops, 0, &explicit_layout) ||
+       rsc->plane.layout.slices[0].offset_B + rsc->plane.layout.data_size_B > panfrost_bo_size(base->bo)) {
+      panfrost_resource_destroy(pscreen, prsc);
+      return NULL;
+   }
+
+   panfrost_bo_reference(base->bo);
+   rsc->bo = base->bo;
+   rsc->plane.base = rsc->bo->ptr.gpu;
+   rsc->modifier_constant = true;
+   base->modifier_constant = true;   /* never converted / reallocated under the alias */
+   pipe_resource_reference((struct pipe_resource **)&rsc->alias_of, base_p);
+   BITSET_SET(rsc->valid.data, 0);
+   return prsc;
+}
