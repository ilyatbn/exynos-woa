+      memset(&t, 0, sizeof t);
+      t.target = r->resource->target;
+      t.format = plane ? PIPE_FORMAT_R8G8_UNORM : PIPE_FORMAT_R8_UNORM;
+      t.width0 = plane ? r->resource->width0 / 2u : r->resource->width0;
+      t.height0 = plane ? r->nv12_height / 2u : r->nv12_height;
+      t.depth0 = 1;
+      t.array_size = 1;
+      t.bind = r->resource->bind & (PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET | PIPE_BIND_SHADER_IMAGE);
+      t.usage = r->resource->usage;
